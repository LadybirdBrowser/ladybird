#include <AK/JsonValue.h>
#include <LibHTTP/Header.h>
#include <LibCompositing/Types.h>
#include <LibCore/GeolocationAuthorization.h>
#include <LibGfx/Color.h>
#include <LibGfx/Cursor.h>
#include <LibGfx/GpuDeviceIdentity.h>
#include <LibGfx/Point.h>
#include <LibGfx/ShareableBitmap.h>
#include <LibGfx/Rect.h>
#include <LibGfx/SharedImage.h>
#include <LibGfx/Size.h>
#include <LibURL/Origin.h>
#include <LibWebCommon/NotificationsAPI/NotificationData.h>
#include <LibURL/URL.h>
#include <LibWebCommon/CSS/PreferredColorScheme.h>
#include <LibWebCommon/Loader/NavigatorCompatibilityMode.h>
#include <LibWebCommon/Gamepad/GamepadSnapshot.h>
#include <LibWebCommon/Page/SpellingError.h>
#include <LibWebCommon/Page/Translation.h>
#include <LibWebCommon/Page/WritingSuggestion.h>
#include <LibWebCommon/WebView/DictionaryLookup.h>
#include <LibWebCommon/HTML/FileFilter.h>
#include <LibWebCommon/HTML/SelectItem.h>
#include <LibWebView/AccessibilityTreeManager.h>
#include <LibWebView/ContextMenuRequest.h>
#include <LibWebView/FileDownloader.h>
#include <LibWebView/HistoryVisitTransition.h>
#include <LibWebView/MicrophoneAuthorizer.h>
#include <LibWebView/SessionHistory.h>
#include <LibWebView/TabPerformanceStats.h>
#include <LibWebCommon/Clipboard/SystemClipboard.h>
#include <LibWebCommon/HTML/PreparedNavigationDescriptor.h>
#include <LibWebView/Application.h>
#include <LibWebView/ViewImplementation.h>

[ExistingCpp]
struct WebView::BlockedResource {
    String host;
    String kind;
}

[ExistingCpp]
struct WebView::ContentBlockingSnapshot {
    Optional<String> site;
    WebView::ContentBlockingState state;
    Vector<WebView::BlockedResource> blocked_resources;
}

[ExistingCpp]
struct WebView::PermissionPromptRequest {
    Web::Permissions::PermissionName name;
    URL::Origin top_level_origin;
    bool is_file;
    bool show_os_hint;
    WebView::PermissionPromptKind kind;
}

[ExistingCpp]
struct WebView::TabPerformanceStats {
    Optional<double> cpu_percent;
    Optional<u64> memory_bytes;
    Optional<u64> peak_memory_bytes;
    u64 download_bytes_per_second;
    u64 upload_bytes_per_second;
    Optional<double> frames_per_second;
    Vector<double> cpu_history;
    u32 other_tabs_sharing_processes;
}

[ExistingCpp]
struct WebView::SitePermissionRow {
    Web::Permissions::PermissionName name;
    Optional<WebView::PermissionDecision> decision;
    bool one_time_grant_is_live;
    bool requested_by_page;
}

[ExistingCpp]
struct WebView::ViewImplementation::InputMethodState {
    bool is_enabled;
    i32 cursor_position;
    i32 anchor_position;
    Utf16String text_before_cursor;
    Utf16String text_after_cursor;
    Optional<Web::DevicePixelRect> caret_rect;
}

[ExistingCpp]
struct WebView::FileDownloader::SegmentProgress {
    u64 start_offset;
    u64 end_offset;
    u64 next_offset;
}

struct Hub::DownloadState {
    u64 id;
    WebView::IsPrivate is_private;
    URL::URL url;
    ByteString destination;
    WebView::FileDownloader::DownloadStatus status;
    u64 downloaded_size;
    Optional<u64> total_size;
    Optional<String> error;
    bool can_resume;
    u32 connection_count;
    Optional<u64> bytes_per_second;
    bool is_waiting_to_retry;
    UnixDateTime created_time;
    Vector<WebView::FileDownloader::SegmentProgress> segments;
}

// What only the UI can tell, which the Hub needs from the start.
struct Hub::UIInfo {
    Optional<String> ui_font_family;
    Optional<String> system_font_family;
    Web::CSS::PreferredColorScheme interface_color_scheme;
    bool supports_picture_in_picture;
    bool has_location_source;
    bool has_translator;
    bool has_spell_checker;
    bool spell_checker_learns_for_every_tag;
    bool spell_checker_can_suggest;
    Optional<WebView::MicrophoneAuthorization> microphone_authorization;
    Optional<Core::GeolocationAuthorization> location_authorization;
    bool supports_selection_clipboard;
    bool supports_system_menu_bar;
    bool supports_vertical_tabs;
    bool supports_private_browsing_windows;
    bool supports_client_side_window_decorations;
    bool reports_scroll_momentum;
    bool scrolls_elastically;
    bool scrollbar_track_press_jumps;
    Vector<String> preferred_languages;
    Optional<Gfx::GpuDeviceIdentity> presentation_gpu_device;
    Vector<u64> presentation_drm_format_modifiers;
}

// What the UI needs from the Hub before it can show anything.
struct Hub::InitialState {
    ByteString settings_json;
    ByteString config_directory;
    ByteString data_directory;
    bool persists_sessions;
    bool uses_sql_database;
    String user_agent;
    Web::NavigatorCompatibilityMode navigator_compatibility_mode;
    bool scripting_enabled;
    bool blocks_pop_ups;
    bool devtools_enabled;
    bool sandbox_is_disabled;
    Vector<Hub::DownloadState> downloads;
    Vector<URL::URL> urls;
    Vector<ByteString> raw_urls;
    ByteString crash_report_directory;
    Optional<u16> devtools_port;
    ByteString profile_identifier;
    ByteString profile_identity;
    bool profile_is_temporary;
}

[ExistingCpp]
struct WebView::ContextMenuRequest {
    WebView::ContextMenuKind kind;
    Gfx::IntPoint widget_position;
    bool is_editable;
    Optional<String> selected_text;
    Optional<WebView::DictionaryLookup> dictionary_lookup;
    Gfx::IntPoint dictionary_lookup_position;
    Optional<Utf16String> misspelled_word;
    Vector<Utf16String> spelling_guesses;
    bool makes_link_to_highlight;
    bool can_inspect_element;
    Optional<Web::HTML::PreparedNavigationDescriptor> link_navigation;
    Optional<Web::HTML::PreparedNavigationDescriptor> navigation;
    Optional<Gfx::ShareableBitmap> image_bitmap;
    Optional<String> image_mime_type;
    Optional<Web::MediaContextMenu> media;
}

[ExistingCpp]
struct WebView::SessionHistorySnapshot {
    Vector<Web::HTML::SessionHistoryEntryDescriptor> entries;
    Vector<i32> used_steps;
    size_t current_used_step_index;
}

// A language the tab's page can be translated into, perhaps after a download.
struct Hub::TranslationTarget {
    String language;
    bool needs_download;
    bool faster_after_download;
    bool higher_quality_available;
    bool downloading;
    Vector<String> languages_to_download;
}

// What the UI needs to know about a view at any time, without having to ask.
struct Hub::ViewState {
    URL::URL url;
    URL::URL displayed_url;
    Utf16String title;
    String handle;
    bool is_loading;
    bool crash_overlay_active;
    String crash_overlay_failed_url;
    Optional<ByteString> crash_report_name;
    Optional<String> crash_report_website;
    double zoom_level;
    String host_for_settings;
    i32 web_content_pid;
    bool can_report_website_issue;
    bool can_undo;
    bool can_redo;
    bool can_view_source;
    bool can_navigate_back;
    bool can_navigate_forward;
    bool is_node_picker_active;
    bool is_translated;
    bool translation_offered;
    Vector<Hub::TranslationTarget> translation_targets;
    Optional<String> translation_target_language;
    bool translation_prefers_higher_quality;
    WebView::ContentBlockingSnapshot content_blocking_snapshot;
    WebView::ViewImplementation::InputMethodState input_method_state;
    Web::HTML::MuteState page_mute_state;
    bool plays_audio_indicator_visible;
    bool uses_location_indicator_visible;
    bool uses_microphone_indicator_visible;
    Gfx::Color page_background_color;
    Optional<URL::Origin> permission_origin;
    Vector<WebView::SitePermissionRow> site_permission_rows;
}

// What the Hub tells the UI.
endpoint HubClient
{
    crash_reports_changed() =|
    request_finished(u64 request_id, bool had_network_error, Optional<u32> response_code, Vector<HTTP::Header> response_headers, ByteString body) =|
    app_open_new_tab(Vector<URL::URL> urls) =|
    app_open_new_window(Vector<URL::URL> urls) =|
    view_selected_text(u64 view_id, u64 request_id, Optional<ByteString> text) =|
    view_close_preflight_finished(u64 view_id, u64 request_id, bool may_close) =|
    view_page_dumps(u64 view_id, u64 request_id, Optional<String> dumps) =|
    pip_open(u64 view_id, u64 owner_view_id, Gfx::IntSize video_size) =|
    pip_hide(u64 view_id) =|
    pip_set_video_size(u64 view_id, Gfx::IntSize video_size) =|
    pip_close(u64 view_id) =|
    notification_show(u64 id, u64 page_id, Optional<u64> replaces, Web::NotificationsAPI::NotificationData data, String attribution, Optional<Gfx::ShareableBitmap> icon) =|
    notification_close(u64 id) =|
    geolocation_start() =|
    geolocation_request_position(u64 id) =|
    geolocation_cancel_position_request(u64 id) =|
    geolocation_start_watching(u64 id) =|
    geolocation_stop_watching(u64 id) =|
    translator_detect_language(u64 request_id, Web::TranslationLanguageSample sample) =|
    translator_target_languages(u64 request_id, String source_language, Vector<String> candidates) =|
    translator_create_session(u64 session_id, String source_language, String target_language, bool prefer_higher_quality) =|
    translator_choose_session_model_again(u64 session_id, bool prefer_higher_quality) =|
    translator_close_session(u64 session_id) =|
    translator_translate(u64 request_id, u64 session_id, Web::TranslationUnit unit) =|
    translator_open_language_download_settings() =|
    microphone_request_authorization() =|
    gamepad_start(bool ignore_system_gamepads) =|
    gamepad_set_polling(bool polling) =|
    gamepad_rumble(u32 handle, u16 low_frequency_magnitude, u16 high_frequency_magnitude, u32 duration_ms) =|
    gamepad_rumble_triggers(u32 handle, u16 left_magnitude, u16 right_magnitude, u32 duration_ms) =|
    spell_checker_close_document(i64 document_tag) =|
    spell_checker_check(u64 request_id, i64 document_tag, Utf16String text) =|
    spell_checker_guesses(u64 request_id, i64 document_tag, Utf16String word) =|
    spell_checker_ignore(i64 document_tag, Utf16String word) =|
    spell_checker_learn(i64 document_tag, Utf16String word) =|
    spell_checker_suggest(u64 request_id, i64 document_tag, Utf16String text, u32 caret_offset) =|
    app_focus_view_from_notification(u64 view_id) =|
    app_open_url_in_new_tab_from_notification(URL::URL url, Optional<u64> view_id, WebView::IsPrivate is_private) =|
    external_url_resolve_handler(u64 request_id, URL::URL url) =|
    external_url_launch(u64 handler_id, u64 request_id, URL::URL url) =|
    external_url_release_handler(u64 handler_id) =|
    download_added(Hub::DownloadState download) =|
    download_updated(Hub::DownloadState download) =|
    download_removed(u64 id, WebView::IsPrivate is_private) =|
    app_open_url_in_new_tab(URL::URL url, Web::HTML::ActivateTab activate_tab, Optional<u64> source_view_id, WebView::IsPrivate is_private) =|
    app_open_url_in_new_window(URL::URL url, WebView::IsPrivate is_private) =|
    app_open_navigation_in_new_tab(Web::HTML::PreparedNavigationDescriptor navigation, Web::HTML::ActivateTab activate_tab, Optional<u64> source_view_id, WebView::IsPrivate is_private) =|
    app_open_navigation_in_new_window(Web::HTML::PreparedNavigationDescriptor navigation, WebView::IsPrivate is_private) =|
    app_set_clipboard_text(String text, WebView::Application::ClipboardType type) =|
    app_insert_clipboard_item(Web::Clipboard::SystemClipboardItem item) =|
    app_update_tabs_display() =|
    app_did_clear_history_since(UnixDateTime since) =|
    app_quit_for_signal() =|
    app_did_enable_devtools() =|
    app_did_disable_devtools() =|
    app_open_urls_in_new_tabs(Vector<URL::URL> urls) =|
    app_activate_or_open_tab_with_url(URL::URL url) =|
    app_open_view_in_new_tab(u64 view_id, Optional<u64> source_view_id, WebView::IsPrivate is_private, Web::HTML::ActivateTab activate_tab) =|
    app_display_error_dialog(String message) =|
    app_display_download_confirmation_dialog(String download_name, ByteString path) =|
    app_read_clipboard_text(u64 request_id, WebView::Application::ClipboardType type) =|
    app_read_clipboard_item(u64 request_id) =|
    app_ask_user_for_download_path(u64 request_id, ByteString file) =|
    settings_changed(ByteString settings_json, u64 last_applied_change_id) =|
    web_ui_opened(u64 web_ui_id, String host, WebView::IsPrivate is_private) =|
    web_ui_message(u64 web_ui_id, String name, JsonValue data) =|
    web_ui_closed(u64 web_ui_id) =|
    view_request_context_menu(u64 view_id, WebView::ContextMenuRequest request) =|
    view_session_history_changed(u64 view_id, WebView::SessionHistorySnapshot history, URL::URL url) =|
    view_visited_page(u64 view_id, URL::URL url, Optional<String> title, WebView::HistoryVisitTransition transition) =|
    view_visited_page_title_change(u64 view_id, URL::URL url, String title) =|
    view_did_make_link_to_highlight(u64 view_id, Optional<URL::URL> url) =|
    view_favicon_change(u64 view_id, Optional<Gfx::ShareableBitmap> favicon) =|
    view_request_before_unload(u64 view_id, u64 answer_id, String source) =|
    view_request_external_url_confirmation(u64 view_id, u64 answer_id, URL::URL url, URL::Origin initiator_origin, String application_name) =|
    view_request_permission(u64 view_id, u64 answer_id, WebView::PermissionPromptRequest request) =|
    view_request_date_picker(u64 view_id, Utf16String input_type, Utf16String value, Utf16String minimum, Utf16String maximum) =|
    view_request_dictionary_lookup(u64 view_id, WebView::DictionaryLookup lookup, Gfx::IntPoint position) =|
    view_open_new_view(u64 view_id, u64 new_view_id, Hub::ViewState new_view_state, Web::HTML::ActivateTab activate_tab, Web::HTML::WebViewHints hints) =|
    view_update_zoom(u64 view_id) =|
    view_navigation_load_start(u64 view_id, URL::URL url) =|
    view_navigation_load_finish(u64 view_id, URL::URL url) =|
    view_install_backing_stores(u64 view_id, u64 page_id, Vector<i32> bitmap_ids, Vector<Gfx::SharedImage> backing_stores) =|
    view_add_backing_stores(u64 view_id, Vector<i32> bitmap_ids, Vector<Gfx::SharedImage> backing_stores) =|
    view_retire_backing_stores(u64 view_id, Vector<i32> bitmap_ids) =|
    view_present_backing_store(u64 view_id, u64 page_id, i32 bitmap_id, Gfx::IntSize size, double device_pixel_ratio) =|
    view_accept_presented_backing_store(u64 view_id, i32 bitmap_id, Gfx::IntRect damage_rect) =|
    view_keep_front_backing_store_as_backup(u64 view_id) =|
    view_clear_backup_backing_store(u64 view_id) =|
    view_clear_backing_stores(u64 view_id) =|
    view_finish_handling_key_event(u64 view_id, u64 input_id, Web::KeyEvent event) =|
    view_finish_handling_mouse_event(u64 view_id, u64 input_id, Web::MouseEvent event, Web::EventResult result) =|
    view_finish_handling_drag_event(u64 view_id, u64 input_id, Web::DragEvent event) =|
    view_release_input(u64 view_id, u64 input_id) =|
    view_state_changed(u64 view_id, Hub::ViewState state) =|
    view_load_start(u64 view_id) =|
    view_load_finish(u64 view_id, URL::URL url) =|
    view_activate_tab(u64 view_id) =|
    view_close(u64 view_id) =|
    view_link_hover(u64 view_id, URL::URL url) =|
    view_link_unhover(u64 view_id) =|
    view_title_change(u64 view_id, Utf16String title) =|
    view_url_change(u64 view_id, URL::URL url) =|
    view_loading_state_change(u64 view_id, bool is_loading) =|
    view_top_level_navigation_commit(u64 view_id) =|
    view_browser_history_traversal_complete(u64 view_id) =|
    view_cursor_change(u64 view_id, Gfx::Cursor cursor) =|
    view_input_method_state_change(u64 view_id) =|
    view_enter_tooltip_area(u64 view_id, ByteString tooltip) =|
    view_leave_tooltip_area(u64 view_id) =|
    view_content_blocking_change(u64 view_id, WebView::ContentBlockingSnapshot snapshot) =|
    view_request_alert(u64 view_id, Utf16String message) =|
    view_request_confirm(u64 view_id, Utf16String message) =|
    view_request_prompt(u64 view_id, Utf16String message, Utf16String default_value) =|
    view_request_set_prompt_text(u64 view_id, Utf16String message) =|
    view_before_browser_initiated_navigation(u64 view_id) =|
    view_request_accept_dialog(u64 view_id) =|
    view_request_dismiss_dialog(u64 view_id) =|
    view_request_website_issue_report(u64 view_id) =|
    view_request_screenshot(u64 view_id) =|
    view_accessibility_tree_received(u64 view_id, u64 sequence, Vector<WebView::AccessibilityNodeData> nodes) =|
    view_accessibility_tree_changed(u64 view_id, u64 base_sequence, u64 sequence, WebView::AccessibilityTreeDelta delta) =|
    view_accessibility_focus_changed(u64 view_id, i64 node_id) =|
    view_restore_window(u64 view_id) =|
    view_reposition_window(u64 view_id, Gfx::IntPoint position) =|
    view_resize_window(u64 view_id, Gfx::IntSize size) =|
    view_maximize_window(u64 view_id) =|
    view_minimize_window(u64 view_id) =|
    view_fullscreen_window(u64 view_id) =|
    view_exit_fullscreen_window(u64 view_id) =|
    view_request_color_picker(u64 view_id, Color current_color) =|
    view_cancel_permission_prompt(u64 view_id, WebView::PermissionPromptRequest request) =|
    view_tab_indicator_change(u64 view_id, WebView::TabIndicator indicator, bool visible) =|
    view_request_file_picker(u64 view_id, Web::HTML::FileFilter accepted_file_types, Web::HTML::AllowMultipleFiles allow_multiple_files) =|
    view_request_select_dropdown(u64 view_id, Gfx::IntPoint content_position, i32 minimum_width, Vector<Web::HTML::SelectItem> items) =|
    view_picture_in_picture_control_activated(u64 view_id, Compositing::PictureInPictureControl control) =|
    view_find_in_page(u64 view_id, size_t current_match_index, Optional<size_t> total_match_count) =|
    view_page_background_color_change(u64 view_id, Gfx::Color color) =|
    view_screen_wake_lock_state_changed(u64 view_id, Web::ScreenWakeLockState state) =|
    view_web_content_crashed(u64 view_id, WebView::ViewImplementation::WebContentCrashReason reason) =|
    view_crash_overlay_state_change(u64 view_id, bool active) =|
    view_crash_report_saved(u64 view_id) =|
    view_performance_stats(u64 view_id, WebView::TabPerformanceStats stats) =|
}
