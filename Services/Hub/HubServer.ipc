#include <AK/JsonValue.h>
#include <LibHTTP/Header.h>
#include <AK/StringUtils.h>
#include <Hub/HubClientEndpoint.h>
#include <LibCore/AnonymousBuffer.h>
#include <LibCore/GeolocationAuthorization.h>
#include <LibCore/GeolocationProvider.h>
#include <LibGfx/Color.h>
#include <LibGfx/Point.h>
#include <LibGfx/ShareableBitmap.h>
#include <LibGfx/Size.h>
#include <LibURL/Origin.h>
#include <LibURL/URL.h>
#include <LibWebCommon/CSS/PreferredContrast.h>
#include <LibWebCommon/CSS/PreferredMotion.h>
#include <LibWebCommon/HTML/ActivateTab.h>
#include <LibWebCommon/Loader/NavigatorCompatibilityMode.h>
#include <LibWebCommon/HTML/VisibilityState.h>
#include <LibWebCommon/Clipboard/SystemClipboard.h>
#include <LibWebView/OmniboxEngagement.h>
#include <LibWebView/HistoryStore.h>
#include <LibWebView/ProcessSnapshot.h>
#include <LibWebView/SessionHistory.h>
#include <LibWebView/SessionStore.h>
#include <LibWebView/Translator.h>
#include <LibWebView/ViewImplementation.h>

[ExistingCpp]
struct WebView::Translator::TargetLanguage {
    String language;
    bool needs_download;
}

[ExistingCpp]
struct Core::GeolocationCoordinates {
    double latitude;
    double longitude;
    double accuracy;
    Optional<double> altitude;
    Optional<double> altitude_accuracy;
    Optional<double> heading;
    Optional<double> speed;
}

[ExistingCpp]
struct Core::GeolocationError {
    Core::GeolocationError::Type type;
    String message;
}

[ExistingCpp]
struct WebView::ViewImplementation::ScreenRects {
    Vector<Web::DevicePixelRect> rects;
    Vector<Web::DevicePixelRect> available_rects;
    u32 main_screen_index;
}

[ExistingCpp]
struct WebView::OmniboxEngagement {
    String input;
    WebView::OmniboxDestinationKind destination_kind;
    String destination;
    bool was_explicit;
    UnixDateTime used_at;
}

[ExistingCpp]
struct WebView::SessionWindowGeometry {
    i32 x;
    i32 y;
    i32 width;
    i32 height;
    bool maximized;
}

[ExistingCpp]
struct WebView::HistoryEntry {
    String url;
    Optional<String> title;
    Optional<ByteBuffer> favicon_png;
    i64 visit_count;
    i64 direct_visit_count;
    UnixDateTime last_visited_time;
    UnixDateTime last_qualifying_visit_time;
    UnixDateTime last_direct_visit_time;
    double decayed_visit_score;
    double decayed_direct_score;
    UnixDateTime score_updated_at;
}

[ExistingCpp]
struct WebView::SessionHistorySnapshot {
    Vector<Web::HTML::SessionHistoryEntryDescriptor> entries;
    Vector<i32> used_steps;
    size_t current_used_step_index;
}

[ExistingCpp]
struct WebView::SessionStore::TabOpened {
    Optional<WebView::SessionWindowId> window_id;
    URL::URL initial_url;
    Optional<i64> insertion_index;
    WebView::SessionStore::IsActive is_active;
}

[ExistingCpp]
struct WebView::ClosedSessionTab {
    URL::URL active_url;
    Optional<WebView::SessionHistorySnapshot> history;
    bool pinned;
}

[ExistingCpp]
struct WebView::ClosedSessionUnit {
    Vector<WebView::ClosedSessionTab> tabs;
    i64 active_tab_index;
    bool was_window;
    Optional<WebView::SessionWindowId> source_window_id;
    Optional<i64> source_tab_index;
    WebView::ClosedSessionUnit::Origin origin;
    Optional<WebView::SessionWindowGeometry> geometry;
}

[ExistingCpp]
struct WebView::RecentlyClosedSessionUnit {
    WebView::SessionWindowId id;
    URL::URL active_url;
    size_t tab_count;
    bool was_window;
    bool from_startup_recovery;
    UnixDateTime closed_at;
}

[ExistingCpp]
struct WebView::RestoredSessionTab {
    WebView::SessionTabId tab_id;
    URL::URL url;
    bool pinned;
}

[ExistingCpp]
struct WebView::RestoredSessionWindow {
    WebView::SessionWindowId window_id;
    Vector<WebView::RestoredSessionTab> tabs;
    i64 active_tab_index;
    Optional<WebView::SessionWindowGeometry> geometry;
}

[ExistingCpp]
struct WebView::SessionStore::TabClosed {
    WebView::SessionTabId tab_id;
    UnixDateTime closed_at;
    WebView::SessionStore::KeepForReopening keep_for_reopening;
}

[ExistingCpp]
struct WebView::SessionStore::TabMoved {
    WebView::SessionTabId tab_id;
    WebView::SessionWindowId new_window_id;
    i64 ordinal;
}

[ExistingCpp]
struct WebView::SessionStore::TabOrderChanged {
    WebView::SessionWindowId window_id;
    Vector<WebView::SessionTabId> ordered_tabs;
}

[ExistingCpp]
struct WebView::SessionStore::WindowClosing {
    WebView::SessionWindowId window_id;
    i64 active_tab_index;
    UnixDateTime closed_at;
}

[ExistingCpp]
struct WebView::ViewImplementation::SessionHistoryTraversalMenuItem {
    i32 step;
    String title;
    String url;
    Optional<ByteBuffer> favicon_png;
}

[ExistingCpp]
struct WebView::ProcessPageSnapshot {
    u64 view_id;
    URL::URL url;
    WebView::ProcessPageKind kind;
    Optional<String> favicon_hash;
}

[ExistingCpp]
struct WebView::ProcessTabSnapshot {
    Utf16String title;
    WebView::ProcessPageSnapshot page;
}

[ExistingCpp]
struct WebView::ProcessFrameSnapshot {
    URL::URL url;
    bool is_sandboxed;
}

[ExistingCpp]
struct WebView::ProcessSnapshot {
    u64 child_id;
    i32 pid;
    WebView::ProcessType type;
    Optional<Utf16String> title;
    Optional<URL::URL> site_url;
    Optional<u64> owner_child_id;
    float cpu_percent;
    u64 memory_usage_bytes;
    Optional<WebView::ProcessPageSnapshot> page;
    Vector<WebView::ProcessTabSnapshot> tabs;
    Vector<WebView::ProcessFrameSnapshot> frames;
}

// What it takes to make a view, which the UI asks for when the user opens a tab.
struct Hub::NewViewRequest {
    WebView::IsPrivate is_private;
    double device_pixel_ratio;
    double maximum_frames_per_second;
    Optional<u64> display_id;
    Core::AnonymousBuffer system_theme;
    Optional<WebView::ViewImplementation::ScreenRects> screen_rects;
    Optional<u64> owner_view_id;
    bool websites_prefer_dark;
    bool is_tab;
}

// What the UI asks of the Hub.
endpoint HubServer
{
    initialize() => (Hub::InitialState state)
    create_view(Hub::NewViewRequest request) => (u64 view_id, Hub::ViewState state)
    view_description(u64 view_id) => (Hub::ViewState state)
    ui_did_start() =|
    favicons_in_use(Vector<String> favicon_hashes) =|
    answer_keeps_omnibox_engagements(u64 request_id, bool keeps_engagements) =|
    add_web_ui_page(String host, String title) =|
    send_web_ui_message(u64 web_ui_id, String name, JsonValue data) =|
    favicons(Vector<String> favicon_hashes) => (Vector<Optional<ByteBuffer>> favicon_pngs)
    post_report(u64 post_id, URL::URL url, Vector<HTTP::Header> headers, ByteString body) =|
    cancel_report_post(u64 post_id) =|

    toggle_devtools_enabled() =|
    set_preferred_contrast(Web::CSS::PreferredContrast contrast) =|
    set_preferred_motion(Web::CSS::PreferredMotion motion) =|
    set_user_agent_string(String user_agent) =|
    set_navigator_compatibility_mode(Web::NavigatorCompatibilityMode mode) =|
    set_scripting_enabled(bool enabled) =|
    set_blocks_pop_ups(bool blocks) =|
    set_shows_line_box_borders(bool shows) =|
    set_shows_caret_hit_test_debug_overlay(bool shows) =|
    dump_cookies() =|
    crash_compositor_process() =|
    launch_devtools_client() =|
    reset_private_browsing_session() =|
    notify_compositor_gpu_presentation_unavailable() =|
    ui_info_changed(Hub::UIInfo info) =|

    process_snapshots() => (Vector<WebView::ProcessSnapshot> processes)
    terminate_process(u64 child_id) => (bool terminated)

    view_needs_beforeunload_check(u64 view_id) => (bool needs_check)
    view_recent_history_entries(u64 view_id, u64 limit) => (Vector<WebView::HistoryEntry> entries)
    view_session_history_traversal_menu_items(u64 view_id, i32 direction) => (Vector<WebView::ViewImplementation::SessionHistoryTraversalMenuItem> items)
    view_session_history_snapshot(u64 view_id) => (Optional<WebView::SessionHistorySnapshot> snapshot)
    view_restore_session_history_from_snapshot(u64 view_id, WebView::SessionHistorySnapshot snapshot) => (bool restored)
    view_history_step_at_delta(u64 view_id, i32 delta) => (Optional<i32> step)
    view_look_up_selected_text_at(u64 view_id, Gfx::IntPoint position) => (bool looked_up)
    view_page_description(u64 view_id) => (URL::URL url, String user_agent, Gfx::IntSize viewport_size, double device_pixel_ratio, double zoom_level)

    session_window_opened(WebView::IsPrivate is_private) => (Optional<WebView::SessionWindowId> id)
    session_window_closing(WebView::IsPrivate is_private, WebView::SessionStore::WindowClosing closing) => (bool succeeded)
    session_window_activated(WebView::IsPrivate is_private, WebView::SessionWindowId id) =|
    session_window_geometry_changed(WebView::IsPrivate is_private, WebView::SessionWindowId id, WebView::SessionWindowGeometry geometry) =|
    session_tab_opened(WebView::IsPrivate is_private, WebView::SessionStore::TabOpened opened) => (Optional<WebView::SessionTabId> id)
    session_tab_closed(WebView::IsPrivate is_private, WebView::SessionStore::TabClosed closed) => (bool succeeded)
    session_tab_detached(WebView::IsPrivate is_private, WebView::SessionTabId id) =|
    session_tab_moved(WebView::IsPrivate is_private, WebView::SessionStore::TabMoved moved) =|
    session_tab_order_changed(WebView::IsPrivate is_private, WebView::SessionStore::TabOrderChanged changed) =|
    session_tab_pinned_changed(WebView::IsPrivate is_private, WebView::SessionTabId id, bool pinned) => (bool succeeded)
    session_active_tab_changed(WebView::IsPrivate is_private, WebView::SessionTabId id) =|
    session_application_quitting(WebView::IsPrivate is_private) =|
    session_application_quit_aborted(WebView::IsPrivate is_private) =|
    session_consecutive_unclean_exits(WebView::IsPrivate is_private) => (u32 count)
    session_has_closed_units(WebView::IsPrivate is_private) => (bool has_closed_units)
    session_take_most_recently_closed(WebView::IsPrivate is_private) => (Optional<WebView::ClosedSessionUnit> unit)
    session_recently_closed_units(WebView::IsPrivate is_private, u64 limit) => (Vector<WebView::RecentlyClosedSessionUnit> units)
    session_take_closed_unit(WebView::IsPrivate is_private, WebView::SessionWindowId id) => (Optional<WebView::ClosedSessionUnit> unit)
    session_take_launch_plan(WebView::IsPrivate is_private) => (Vector<WebView::RestoredSessionWindow> windows)
    session_load_tab_history(WebView::IsPrivate is_private, WebView::SessionTabId id) => (Optional<WebView::SessionHistorySnapshot> history)
    history_entry_for_url(WebView::IsPrivate is_private, URL::URL url) => (Optional<WebView::HistoryEntry> entry)
    view_set_site_permission(u64 view_id, URL::Origin origin, Web::Permissions::PermissionName name, Optional<WebView::PermissionDecision> decision) =|
    view_did_show_permission_prompt(u64 view_id, WebView::PermissionPromptRequest request) =|
    view_load_navigation(u64 view_id, Web::HTML::PreparedNavigationDescriptor navigation) =|
    view_open_navigation_in_new_tab(u64 view_id, Web::HTML::PreparedNavigationDescriptor navigation, Web::HTML::ActivateTab activate_tab) =|
    view_open_navigation_in_new_window(u64 view_id, Web::HTML::PreparedNavigationDescriptor navigation, WebView::IsPrivate is_private) =|
    view_traverse_the_history_to_step(u64 view_id, i32 step) =|
    view_traverse_the_history_by_delta(u64 view_id, i32 delta) =|
    view_translate_to(u64 view_id, String target_language) =|
    view_show_original(u64 view_id) =|
    view_download_url(u64 view_id, URL::URL url, bool prompt_for_path, Optional<String> image_mime_type) =|
    view_inspect_context_menu_element(u64 view_id) =|
    view_replace_context_menu_misspelling(u64 view_id, Utf16String replacement) =|
    view_ignore_misspelling(u64 view_id, Utf16String word) =|
    view_learn_misspelling(u64 view_id, Utf16String word) =|
    view_do_context_menu_media_action(u64 view_id, WebView::ContextMenuMediaAction action) =|
    view_set_session_tab_id(u64 view_id, Optional<WebView::SessionTabId> session_tab_id) =|
    view_file_picker_closed(u64 view_id, Vector<Web::HTML::SelectedFile> selected_files) =|
    view_save_screenshot(u64 view_id, Gfx::ShareableBitmap bitmap) =|
    view_request_selected_text(u64 view_id, u64 request_id) =|
    view_request_close_preflight(u64 view_id, u64 request_id) =|
    view_request_page_dumps(u64 view_id, u64 request_id) =|
    view_prepare_for_immediate_close(u64 view_id) =|
    view_prepare_for_close_without_prompting(u64 view_id, u64 close_id) =|
    finish_prepared_close(u64 close_id) =|
    open_microphone_system_settings() =|
    pip_did_resize(u64 view_id, Gfx::IntSize size) =|
    pip_did_close(u64 view_id, bool video_keeps_playing) =|
    notification_shown(u64 id) =|
    notification_failed(u64 id) =|
    notification_clicked(u64 id) =|
    notification_closed(u64 id, bool by_user) =|
    geolocation_position(u64 id, Core::GeolocationCoordinates coordinates) =|
    geolocation_error(u64 id, Core::GeolocationError error) =|
    geolocation_authorization_changed(Core::GeolocationAuthorization authorization) =|
    system_time_zone_changed() =|
    translator_language_detected(u64 request_id, Optional<String> language) =|
    translator_target_languages_ready(u64 request_id, Vector<WebView::Translator::TargetLanguage> target_languages) =|
    translator_translation_finished(u64 request_id, Optional<Vector<Web::TranslationRun>> runs) =|
    external_url_handler_resolved(u64 request_id, Optional<u64> handler_id, String application_name, bool is_ladybird) =|
    external_url_launched(u64 request_id, bool launched) =|
    omnibox_open(u64 client_id, WebView::IsPrivate is_private) =|
    omnibox_close(u64 client_id) =|
    omnibox_query(u64 client_id, u64 query_id, String query, u64 max_suggestions, Vector<WebView::AutocompleteSuggestion> additional_suggestions) =|
    omnibox_cancel(u64 client_id) =|
    omnibox_record_engagement(u64 client_id, WebView::OmniboxEngagement engagement) =|
    cancel_download(u64 id) =|
    pause_download(u64 id) =|
    resume_download(u64 id) =|
    show_download_in_folder(u64 id) =|
    prune_inactive_downloads(WebView::IsPrivate is_private) =|
    pause_active_downloads() =|
    cancel_unresumable_downloads() =|
    active_view_changed(Optional<u64> view_id) =|
    answer_clipboard_text(u64 request_id, Utf16String text) =|
    answer_clipboard_item(u64 request_id, Web::Clipboard::SystemClipboardItem item) =|
    answer_download_path(u64 request_id, Optional<ByteString> path) =|
    update_settings(u64 change_id, ByteString changes_json) =|
    view_answer(u64 view_id, u64 answer_id, bool answer) =|
    view_answer_permission_request(u64 view_id, u64 answer_id, Web::Permissions::PromptOutcome outcome) =|
    destroy_view(u64 view_id) =|
    view_set_viewport(u64 view_id, Web::DevicePixelSize size, double device_pixel_ratio) =|
    view_set_system_theme(u64 view_id, Core::AnonymousBuffer theme) =|
    view_set_screen_rects(u64 view_id, WebView::ViewImplementation::ScreenRects screen_rects) =|
    view_set_page_background_color_to_system_canvas(u64 view_id, bool dark) =|
    release_backing_store(u64 page_id, i32 bitmap_id) =|
    view_enqueue_key_event(u64 view_id, u64 input_id, Web::KeyEvent event) =|
    view_enqueue_mouse_event(u64 view_id, u64 input_id, Web::MouseEvent event) =|
    view_enqueue_drag_event(u64 view_id, u64 input_id, Web::DragEvent event) =|
    view_enqueue_pinch_event(u64 view_id, Web::PinchEvent event) =|
    view_load(u64 view_id, URL::URL url, Web::Bindings::NavigationHistoryBehavior history_behavior) =|
    view_load_url_from_user_input(u64 view_id, URL::URL url) =|
    view_load_from_user_input(u64 view_id, ByteString input, Optional<URL::URL> fallback_url) =|
    view_load_html(u64 view_id, ByteString html) =|
    view_load_navigation_error_page(u64 view_id, ByteString html) =|
    view_find_in_page(u64 view_id, Utf16String query, AK::CaseSensitivity case_sensitivity, bool highlight_all_matches) =|
    view_set_window_position(u64 view_id, Gfx::IntPoint position) =|
    view_set_window_size(u64 view_id, Gfx::IntSize size) =|
    view_set_system_visibility_state(u64 view_id, Web::HTML::VisibilityState visibility_state) =|
    view_set_presents_from_cpu_memory(u64 view_id, bool presents_from_cpu_memory) =|
    view_set_has_system_focus(u64 view_id, bool has_system_focus) =|
    view_open_url_in_new_tab(u64 view_id, URL::URL url, Web::HTML::ActivateTab activate_tab) =|
    view_open_url_in_new_window(u64 view_id, URL::URL url, WebView::IsPrivate is_private) =|
    view_set_next_history_visit_transition(u64 view_id, WebView::HistoryVisitTransition transition) =|
    view_reload(u64 view_id, WebView::BypassCache bypass_cache) =|
    view_stop_loading(u64 view_id) =|
    view_undo(u64 view_id) =|
    view_redo(u64 view_id) =|
    view_cut_selection(u64 view_id) =|
    view_paste(u64 view_id) =|
    view_select_all(u64 view_id) =|
    view_get_source(u64 view_id) =|
    view_debug_request(u64 view_id, ByteString request, ByteString argument) =|
    view_dump_gc_graph(u64 view_id) =|
    view_zoom_in(u64 view_id) =|
    view_zoom_out(u64 view_id) =|
    view_reset_zoom(u64 view_id) =|
    view_set_display_metadata(u64 view_id, Optional<u64> display_id, double maximum_frames_per_second) =|
    view_set_scales_frames_to_fit(u64 view_id, bool scales_frames_to_fit) =|
    view_enable_picture_in_picture_controls(u64 view_id) =|
    view_update_interface_color_scheme(u64 view_id) =|
    view_find_in_page_next_match(u64 view_id) =|
    view_find_in_page_previous_match(u64 view_id) =|
    view_find_in_page_end(u64 view_id) =|
    view_report_website_issue(u64 view_id) =|
    view_request_accessibility_tree(u64 view_id) =|
    view_perform_accessibility_action(u64 view_id, i64 node_id, String action) =|
    view_clear_node_picker(u64 view_id) =|
    view_node_picker_hover(u64 view_id, Web::DevicePixelPoint position) =|
    view_node_picker_pick(u64 view_id, Web::DevicePixelPoint position) =|
    view_node_picker_preview(u64 view_id, Web::DevicePixelPoint position) =|
    view_node_picker_cancel(u64 view_id) =|
    view_alert_closed(u64 view_id) =|
    view_confirm_closed(u64 view_id, bool accepted) =|
    view_prompt_closed(u64 view_id, Optional<Utf16String> response) =|
    view_color_picker_update(u64 view_id, Optional<Color> picked_color, Web::HTML::ColorPickerUpdateState state) =|
    view_date_picker_closed(u64 view_id, Optional<Utf16String> picked_value) =|
    view_select_dropdown_closed(u64 view_id, Optional<u32> selected_item_id) =|
    view_set_marked_text_from_input_method(u64 view_id, Utf16String text) =|
    view_commit_text_from_input_method(u64 view_id, Utf16String text, i32 replacement_start, i32 replacement_length) =|
    view_toggle_page_mute_state(u64 view_id) =|
    view_take_and_save_screenshot(u64 view_id, WebView::ViewImplementation::ScreenshotType screenshot_type) =|
    view_request_close(u64 view_id) =|
    view_exit_fullscreen(u64 view_id) =|
    view_deny_fullscreen_window(u64 view_id) =|
    view_set_is_fullscreen(u64 view_id, Web::ViewportIsFullscreen is_fullscreen) =|
    view_reset_site_permissions(u64 view_id, URL::Origin origin) =|
}
