#include <LibCompositing/DisplayList/DisplayListResourceIds.h>
#include <LibCompositing/Types.h>
#include <LibGfx/Size.h>
#include <LibWebCommon/Page/InputEvent.h>

endpoint CompositorWebContentClient
{
    mouse_event(u64 page_id, Compositing::MouseEvent event) =|
    key_event(u64 page_id, Compositing::KeyEvent event) =|
    request_rendering_update() =|
    rendering_opportunity(Compositing::CompositorContextId context_id, i64 frame_time_nanoseconds, double frame_interval_milliseconds) =|
    async_scroll_updates(Compositing::CompositorContextId context_id, Compositing::PendingAsyncScrollUpdates updates) =|
    did_complete_screenshot(Compositing::ScreenshotRequestId request_id) =|
    did_fail_screenshot(Compositing::ScreenshotRequestId request_id) =|
    did_lose_compositor() =|
    placeholder_canvas_committed(Compositing::CanvasId canvas_id, Gfx::IntSize size, bool origin_clean) =|
}
