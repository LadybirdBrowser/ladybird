#include <AK/Optional.h>
#include <LibCompositing/Types.h>
#include <LibGfx/Point.h>
#include <LibGfx/Size.h>
#include <LibIPC/File.h>
#include <LibIPC/TransportHandle.h>
#include <LibWebCommon/Page/InputEvent.h>

endpoint CompositorControlServer
{
    init_transport(int peer_pid) => (int peer_pid)
    set_font_service(IPC::TransportHandle handle, IPC::File catalog, u64 catalog_size, u64 generation) =|

    connect_web_content() => (IPC::TransportHandle handle, i32 web_content_connection_id)

    create_context(Web::CompositorContextId context_id, Optional<u64> page_id, i32 web_content_connection_id) => ()

    viewport_size_updated(Web::CompositorContextId context_id, Gfx::IntSize viewport_size, Compositing::WindowResizingInProgress window_resize_in_progress) =|
    set_paused_debugger_overlay(Web::CompositorContextId context_id, bool visible, double device_pixel_ratio, Optional<String> font_family, Optional<u8> hovered_action) =|
    set_display_metadata(Web::CompositorContextId context_id, Optional<u64> display_id, double refresh_rate) =|

    handle_key_event(Web::CompositorContextId context_id, Web::KeyEvent event) => (bool handled)
    dispatch_key_event_to_web_content(Web::CompositorContextId context_id, Web::KeyEvent event) => (bool dispatched)
    handle_pinch_event(Web::CompositorContextId context_id, Web::PinchEvent event) =|
    handle_and_dispatch_mouse_event(Web::CompositorContextId context_id, Web::MouseEvent event) =|
    presented_bitmap_ready_to_paint(Web::CompositorContextId context_id, i32 bitmap_id) =|
    set_client_gpu_presentation_capability(bool supported, u64 adapter_luid) =|
    set_synthesizes_scroll_momentum(bool synthesizes_scroll_momentum) =|
    set_context_visibility(Web::CompositorContextId context_id, Compositing::ContextVisibility visibility) =|
    crash() =|
}
