#include <AK/Optional.h>
#include <LibGfx/Point.h>
#include <LibGfx/Size.h>
#include <LibIPC/TransportHandle.h>
#include <LibIPC/File.h>
#include <LibCompositing/Types.h>
#include <LibCompositing/InputEvent.h>

endpoint CompositorControlServer
{
    init_transport(int peer_pid) => (int peer_pid)
    set_font_service_transport(IPC::TransportHandle handle) =|
    set_font_catalog(IPC::File file, u64 size, u64 generation) =|

    connect_web_content() => (IPC::TransportHandle handle, i32 web_content_connection_id)

    create_context(Compositing::CompositorContextId context_id, Optional<u64> page_id, i32 web_content_connection_id) => ()

    viewport_size_updated(Compositing::CompositorContextId context_id, Gfx::IntSize viewport_size, Compositing::WindowResizingInProgress window_resize_in_progress) =|
    set_paused_debugger_overlay(Compositing::CompositorContextId context_id, bool visible, double device_pixel_ratio, Optional<String> font_family, Optional<u8> hovered_action) =|
    set_display_metadata(Compositing::CompositorContextId context_id, Optional<u64> display_id, double refresh_rate) =|

    handle_key_event(Compositing::CompositorContextId context_id, Compositing::KeyEvent event) => (bool handled)
    dispatch_key_event_to_web_content(Compositing::CompositorContextId context_id, Compositing::KeyEvent event) => (bool dispatched)
    handle_mouse_event(Compositing::CompositorContextId context_id, Compositing::MouseEvent event) => (Compositing::MouseEventHandlingResult result)
    dispatch_mouse_event_to_web_content(Compositing::CompositorContextId context_id, Compositing::MouseEvent event) => (bool dispatched)
    handle_pinch_event(Compositing::CompositorContextId context_id, Compositing::PinchEvent event) => (bool handled)
    async_scroll_by(Compositing::CompositorContextId context_id, Gfx::FloatPoint position, Gfx::FloatPoint delta_in_device_pixels, Compositing::WheelDeltaPrecision wheel_delta_precision, Compositing::ScrollGesturePhase scroll_gesture_phase, u32 modifiers) => (bool handled)
    presented_bitmap_ready_to_paint(Compositing::CompositorContextId context_id, i32 bitmap_id) =|
    set_client_gpu_presentation_capability(bool supported, u64 adapter_luid) =|
    set_context_visibility(Compositing::CompositorContextId context_id, Compositing::ContextVisibility visibility) =|
    crash() =|
}
