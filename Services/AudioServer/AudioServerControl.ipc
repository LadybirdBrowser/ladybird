#include <LibAudio/PlaybackGroupId.h>
#include <LibIPC/TransportHandle.h>

endpoint AudioServerControl
{

    // Every client of one tab plays into that tab's mix, so the Browser names the tab a client belongs to.
    connect_new_client(u64 tab_id) => (Optional<IPC::TransportHandle> handle)

    // Whether the tab's pages hold the microphone permission: without it the tab's clients learn of the devices by their
    // existence alone, and the capture streams they have are closed. Synchronous, so it is in place before the page
    // hears of it.
    set_capture_permission(u64 tab_id, bool granted) => ()

    // The answer to capture_requested.
    capture_decided(u64 request_id, bool allowed) =|

    // The playback groups whose streams the tab's clients may play: a stream of any other plays into nothing.
    // Authorizing is synchronous, so a group may play before a document of its page runs.
    authorize_playback_group(u64 tab_id, Audio::PlaybackGroupId group) => ()
    revoke_playback_group(u64 tab_id, Audio::PlaybackGroupId group) =|

    // The playback groups the user has muted: their streams play into nothing, whether or not they are authorized.
    mute_playback_group(u64 tab_id, Audio::PlaybackGroupId group) =|
    unmute_playback_group(u64 tab_id, Audio::PlaybackGroupId group) =|
}
