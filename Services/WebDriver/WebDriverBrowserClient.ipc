#include <LibURL/URL.h>
#include <LibWebCommon/WebDriver/Capabilities.h>
#include <LibWebCommon/WebDriver/Response.h>
#include <LibWebCommon/WebDriver/SessionBrowsingContext.h>
#include <LibWebCommon/WebDriver/UserPrompt.h>

endpoint WebDriverBrowserClient {
    close_session() =|
    navigate_to(u64 command_id, String window_handle, URL::URL url) =|
    refresh(u64 command_id, String window_handle) =|
    wait_for_navigation_completion(u64 command_id, String window_handle, Optional<u64> page_load_timeout) =|
    traverse_history(u64 command_id, String window_handle, i32 delta, bool handle_user_prompts) =|
    get_session_history(u64 command_id, String window_handle) =|
    load_url(u64 command_id, String window_handle, URL::URL url) =|
    run_content_command(u64 command_id, String window_handle, Web::WebDriver::SessionBrowsingContext browsing_context, String name, JsonValue payload, Vector<String> arguments) =|
    switch_to_window(u64 command_id, String window_handle) =|
    switch_to_parent_frame(u64 command_id, String window_handle) =|
    set_current_browsing_context_to_top_level(u64 command_id, String window_handle) =|
    set_user_prompt_handler(Web::WebDriver::UserPromptHandler user_prompt_handler) =|
    set_page_load_strategy(Web::WebDriver::PageLoadStrategy page_load_strategy) =|
    set_strict_file_interactability(bool strict_file_interactability) =|
    set_timeouts_configuration(JsonValue timeouts) =|

    // https://w3c.github.io/webdriver-bidi/
    bidi_command(u64 command_id, String method, JsonValue params) =|
    bidi_get_top_level_traversables(u64 command_id, Vector<String> navigable_ids) =|
    bidi_run_subscribe_steps(u64 command_id, String event_name, Vector<String> top_level_traversable_ids) =|
    set_bidi_enabled_events(Vector<String> event_names) =|
}
