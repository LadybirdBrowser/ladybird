#include <AK/Utf16String.h>
#include <LibHTTP/Cache/DiskCacheSettings.h>
#include <LibIPC/TransportHandle.h>
#include <RequestServer/IsPrivate.h>
#include <RequestServer/RequestType.h>
#include <RequestServer/SiteBinding.h>

endpoint RequestServerControl
{
    init_transport(int peer_pid) => (int peer_pid)

    // The client IDs let the UI process tell whose cookies a client may use.
    connect_new_client(::RequestServer::IsPrivate is_private, ::RequestServer::SiteBinding site_binding) => (IPC::TransportHandle handle, int client_id)
    connect_new_clients(size_t count, ::RequestServer::IsPrivate is_private, ::RequestServer::SiteBinding site_binding) => (Vector<IPC::TransportHandle> handles, Vector<int> client_ids)

    // Lets a bound client make requests for documents of frame_site under a top-level document of top_level_site. This
    // is synchronous, so the binding is in place before the UI process lets the client's process host such a document.
    bind_client_to_site(int client_id, Utf16String top_level_site, Optional<Utf16String> frame_site) => ()

    set_disk_cache_settings(HTTP::DiskCacheSettings disk_cache_settings) =|

    // use_tls: enable DNS over TLS
    set_dns_server(ByteString host_or_address, u16 port, bool use_tls, bool validate_dnssec_locally) =|
    set_use_system_dns() =|

    set_performance_monitor_enabled(bool enabled) =|

    estimate_cache_size_accessed_since(u64 cache_size_estimation_id, UnixDateTime since) =|
    remove_cache_entries_accessed_since(u64 clear_cache_request_id, UnixDateTime since) =|

    retrieved_http_cookie(int client_id, u64 request_id, ::RequestServer::RequestType request_type, u64 cookie_request_id, String cookie) =|
    stored_response_cookies_and_hsts_policy(int client_id, u64 request_id, u64 store_request_id) =|
}
