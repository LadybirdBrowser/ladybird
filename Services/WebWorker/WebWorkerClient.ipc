#include <LibHTTP/Cookie/Cookie.h>
#include <LibHTTP/HSTS/ParsedHSTSPolicy.h>
#include <LibIPC/File.h>
#include <LibIPC/TransportHandle.h>
#include <LibURL/URL.h>
#include <LibWebCommon/FileAPI/SerializedBlobURLEntry.h>
#include <LibWebCommon/HTML/BroadcastChannelMessage.h>
#include <LibWebCommon/HTML/WorkerAgentForward.h>
#include <LibWebCommon/HTML/WorkerAgentTypes.h>

endpoint WebWorkerClient {
    did_add_blob_url_entry(Web::HTML::EnvironmentId environment_id, Utf16String url, Web::FileAPI::SerializedBlobURLEntry entry) => (URL::BlobURLEntry::Token token)
    did_remove_blob_url_entries(Web::HTML::EnvironmentId environment_id, Vector<Utf16String> urls) => ()
    did_request_blob_url_entry(Utf16String url, Optional<URL::BlobURLEntry::Token> token) => (Optional<Web::FileAPI::SerializedBlobURLEntry> entry)

    did_close_worker() =|
    did_finish_loading_worker_script(bool worker_is_secure_context) =|
    did_fail_loading_worker_script() =|
    did_report_worker_exception(Utf16String message, Utf16String filename, u32 lineno, u32 colno) =|
    did_request_cookie(URL::URL url, HTTP::Cookie::Source source) => (HTTP::Cookie::VersionedCookie cookie)
    did_request_file(ByteString path, i32 request_id) =|
    did_is_known_hsts_host(String domain) => (bool result)
    request_media_server_connection() => (Optional<IPC::TransportHandle> handle)
    did_post_broadcast_channel_message(Web::HTML::PostedBroadcastChannelMessage message) =|
    start_worker_agent(Web::HTML::WorkerAgentStartRequest request) => (Web::HTML::WorkerAgentId agent_id)
    close_worker_agent(Web::HTML::WorkerAgentId agent_id, Web::HTML::WorkerAgentOwnerToken owner_token) =|
}
