endpoint WebContentServer
{
    init_transport(int peer_pid) => (int peer_pid)
    set_font_catalog(IPC::File file, u64 size, u64 generation) =|
    initialize(Web::PageId initial_page_id, Vector<Web::HTML::RemoteNavigableDescriptor> remote_navigables, Web::HTML::CrossProcessId root_navigable_id, Web::HTML::CrossProcessIdAllocator cross_process_id_allocator, Web::HTML::SessionHistoryEntryDescriptor initial_history_entry, Web::HTML::VisibilityState system_visibility_state) =|
    create_embedded_page(Web::PageId page_id, Vector<Web::HTML::RemoteNavigableDescriptor> remote_navigables, Web::HTML::CrossProcessId root_navigable_id, Web::HTML::SessionHistoryEntryDescriptor initial_history_entry, Web::HTML::VisibilityState system_visibility_state) =|
    insert_remote_navigable(Web::PageId page_id, Web::HTML::RemoteNavigableDescriptor navigable) =|
    remove_remote_navigable(Web::PageId page_id, Web::HTML::CrossProcessId navigable_id) =|
    update_remote_navigable(Web::PageId page_id, Web::HTML::CrossProcessId navigable_id, Web::HTML::ReplicatedNavigableState state) =|
    close_server() =|

    get_window_handle(Web::PageId page_id) => (String handle)
    set_window_handle(Web::PageId page_id, String handle) =|

    run_webdriver_command(Web::PageId page_id, u64 command_id, String name, JsonValue payload, Vector<String> arguments) =|
    run_webdriver_user_prompt_handling(Web::PageId page_id, u64 request_id) =|
    set_webdriver_session_config(Web::PageId page_id, Web::WebDriver::UserPromptHandler user_prompt_handler, Web::WebDriver::PageLoadStrategy page_load_strategy, bool strict_file_interactability, JsonValue timeouts) =|
    connect_to_web_ui(Web::PageId page_id, IPC::TransportHandle handle) =|
    connect_to_request_server(IPC::TransportHandle handle) =|
    connect_to_test_endpoint(IPC::TransportHandle handle) =|
    connect_to_image_decoder(IPC::TransportHandle handle) =|
    connect_to_wasm_compiler(IPC::TransportHandle handle) =|
    connect_to_compositor_process(IPC::TransportHandle handle) =|
    compositor_process_reconnected() =|
    set_site_compatibility_data(JsonValue data) =|

    update_system_theme(Web::PageId page_id, Core::AnonymousBuffer theme_buffer) =|
    update_screen_rects(Web::PageId page_id, Vector<Web::DevicePixelRect> rects, u32 main_screen_index) =|

    load_url(Web::PageId page_id, URL::URL url, Web::Bindings::NavigationHistoryBehavior history_handling, Utf16String navigation_id) =|
    populate_navigation(Web::PageId page_id, Web::HTML::NavigationPopulationRequest request, Web::HTML::NavigationPopulationResult result) =|
    load_html(Web::PageId page_id, ByteString html, Utf16String navigation_id) =|
    reload(Web::PageId page_id) =|
    stop_loading(Web::PageId page_id) =|
    cancel_download(Web::PageId page_id, u64 download_id) =|
    run_navigation_unload_check(Web::PageId page_id, Web::HTML::CrossProcessId navigable_id, Utf16String navigation_id) =|
    create_navigation_params(Web::PageId page_id, Web::HTML::NavigationPopulationRequest request) =|
    cancel_navigation_params_creation(Web::PageId page_id, Web::HTML::CrossProcessId navigable_id, Utf16String navigation_id) =|
    begin_hosting_navigable(Web::PageId page_id, Web::HTML::CrossProcessId navigable_id, Web::HTML::SessionHistoryEntryDescriptor current_history_entry, Web::HTML::VisibilityState system_visibility_state) =|
    discard_provisional_navigable(Web::PageId page_id, Web::HTML::CrossProcessId navigable_id) =|
    stop_hosting_navigable(Web::PageId page_id, Web::HTML::CrossProcessId navigable_id, Web::HTML::ReplicatedNavigableState replicated_state) =|
    set_hosted_root_viewport(Web::PageId page_id, Web::HTML::CrossProcessId navigable_id, Web::DevicePixelSize size, double device_pixel_ratio) =|
    set_remote_child_frame_compositor_context(Web::PageId page_id, Web::HTML::CrossProcessId frame_id, Optional<Web::Compositor::CompositorContextId> context_id) =|
    history_operation_started(Web::PageId page_id, Web::HTML::CrossProcessId operation_id, Optional<Web::ReconstructedChildNavigation> reconstructed_child_navigation) =|
    run_history_step_unload_cancelation_job(Web::PageId page_id, Web::HTML::CrossProcessId operation_id, Web::HTML::SessionHistoryEntryDescriptor target_entry, Vector<Web::HTML::CrossProcessId> navigables_crossing_documents, Web::HTML::UserNavigationInvolvement user_involvement) =|
    run_history_step_beforeunload_check(Web::PageId page_id, Web::HTML::CrossProcessId operation_id, Vector<Web::HTML::CrossProcessId> navigable_ids, Web::HTML::UnloadPromptShown unload_prompt_shown) =|
    discard_embedded_page(Web::PageId page_id) =|
    queue_navigation_api_state_clear_task(Web::PageId page_id, Web::HTML::CrossProcessId operation_id, Web::HTML::CrossProcessId navigable_id) =|
    continue_history_navigation_population(Web::PageId page_id, Web::HTML::CrossProcessId operation_id, Web::HTML::SessionHistoryEntryDescriptor target_entry, Optional<Web::Bindings::NavigationType> navigation_type, Web::HTML::HistoryNavigationPopulation population) =|
    run_changing_navigable_history_job(Web::PageId page_id, Web::HTML::CrossProcessId operation_id, Web::HTML::CrossProcessId navigable_id, Web::HTML::SessionHistoryEntryDescriptor target_entry, Web::HTML::UserNavigationInvolvement user_involvement, Optional<Web::Bindings::NavigationType> navigation_type, bool superseded_by_newer_navigation) =|
    prepare_changing_navigable_for_unload(Web::PageId page_id, Web::HTML::CrossProcessId operation_id, Web::HTML::CrossProcessId navigable_id) =|
    apply_changing_navigable_continuation(Web::PageId page_id, Web::HTML::CrossProcessId operation_id, Web::HTML::CrossProcessId navigable_id, u64 script_history_length, u64 script_history_index, Vector<Web::HTML::SessionHistoryEntryDescriptor> entries_for_navigation_api, Web::HTML::VisibilityState system_visibility_state, Web::HTML::UnloadDisplayedDocument unload_displayed_document) =|
    run_descendant_unload_task(Web::PageId page_id, Web::HTML::CrossProcessId unload_id, Web::HTML::CrossProcessId navigable_id, Web::HTML::StopHostingAfterUnload stop_hosting_after_unload) =|
    continue_child_navigable_destruction(Web::PageId page_id, Web::HTML::CrossProcessId navigable_id, Web::HTML::UnloadDisplayedDocument unload_displayed_document) =|
    run_traversable_close_unload_task(Web::PageId page_id, Web::HTML::CrossProcessId operation_id) =|
    update_nonchanging_navigable_history_state(Web::PageId page_id, Web::HTML::CrossProcessId operation_id, Web::HTML::CrossProcessId navigable_id, u64 script_history_length, u64 script_history_index) =|
    complete_history_operation(Web::PageId page_id, Web::HTML::CrossProcessId operation_id, Web::HTML::HistoryStepResult result, Optional<i32> committed_step, u64 session_history_entry_count) =|

    set_viewport(Web::PageId page_id, Web::DevicePixelSize size, double device_pixel_ratio, Web::ViewportIsFullscreen is_fullscreen) =|

    key_event(Web::PageId page_id, Web::KeyEvent event) =|
    mouse_event(Web::PageId page_id, Web::MouseEvent event) =|
    mouse_event_in_hosted_root(Web::PageId page_id, Web::HTML::CrossProcessId navigable_id, Web::MouseEvent event) =|
    drag_event(Web::PageId page_id, Web::DragEvent event) =|
    pinch_event(Web::PageId page_id, Web::PinchEvent event) =|

    debug_request(Web::PageId page_id, ByteString request, ByteString argument) =|
    get_source(Web::PageId page_id) =|
    inspect_dom_tree(Web::PageId page_id) =|
    inspect_storage(Web::PageId page_id, Web::StorageAPI::StorageEndpointType storage_endpoint, u64 request_id) =|
    set_session_storage_item(Web::PageId page_id, Utf16String key, Utf16String value) => (Optional<WebView::StorageSetResult> result)
    remove_session_storage_item(Web::PageId page_id, Utf16String key) => (Optional<Utf16String> old_value)
    clear_session_storage(Web::PageId page_id) => (bool did_clear)
    inspect_dom_node(Web::PageId page_id, WebView::DOMNodeProperties::Type property_type, Web::UniqueNodeID node_id, Optional<Web::CSS::PseudoElement> pseudo_element, JsonValue options) =|
    inspect_grid_layouts(Web::PageId page_id, Web::UniqueNodeID root_node_id) =|
    inspect_current_grid(Web::PageId page_id, Web::UniqueNodeID node_id) =|
    inspect_current_flexbox(Web::PageId page_id, Web::UniqueNodeID node_id, bool only_look_at_parents) =|
    inspect_indexed_database_storage(Web::PageId page_id, u64 request_id) =|
    inspect_indexed_database_objects(Web::PageId page_id, u64 request_id, String host, JsonValue names, JsonValue options) =|
    delete_indexed_database(Web::PageId page_id, u64 request_id, String host, String name) =|
    clear_indexed_database_object_store(Web::PageId page_id, u64 request_id, String host, String name) =|
    delete_indexed_database_record(Web::PageId page_id, u64 request_id, String host, String name) =|
    clear_inspected_dom_node(Web::PageId page_id) =|
    highlight_dom_node(Web::PageId page_id, Web::UniqueNodeID node_id, Optional<Web::CSS::PseudoElement> pseudo_element) =|
    highlight_flexbox(Web::PageId page_id, Web::UniqueNodeID node_id, JsonValue options) =|
    clear_flexbox_highlight(Web::PageId page_id, Web::UniqueNodeID node_id) =|
    highlight_grid(Web::PageId page_id, Web::UniqueNodeID node_id, JsonValue options) =|
    clear_grid_highlight(Web::PageId page_id, Web::UniqueNodeID node_id) =|
    inspect_accessibility_tree(Web::PageId page_id) =|
    get_hovered_node_id(Web::PageId page_id) =|
    get_node_id_at_position(Web::PageId page_id, u64 request_id, Web::DevicePixelPoint position) =|

    js_console_input(Web::PageId page_id, String js_source) =|
    run_javascript(Web::PageId page_id, String js_source) =|

    list_style_sheets(Web::PageId page_id) =|
    request_style_sheet_source(Web::PageId page_id, Web::CSS::StyleSheetIdentifier identifier) =|
    list_devtools_sources(Web::PageId page_id, u64 request_id) =|
    request_devtools_source(Web::PageId page_id, Web::HTML::ScriptRegistry::Identifier source_id) =|
    attach_debugger(Web::PageId page_id) =|
    configure_debugger(Web::PageId page_id, WebView::DebuggerConfiguration configuration) =|
    detach_debugger(Web::PageId page_id) =|
    interrupt_debugger(Web::PageId page_id) =|
    resume_debugger(Web::PageId page_id, WebView::DebuggerResumeMode mode) =|
    update_debugger_blackboxing(Web::PageId page_id, Utf16String url, Vector<WebView::DebuggerBlackboxRange> ranges, WebView::DebuggerBlackboxingOperation operation) =|
    set_debugger_breakpoint(Web::PageId page_id, u64 request_id, WebView::DebuggerBreakpointLocation location, WebView::DebuggerBreakpointOptions options) =|
    remove_debugger_breakpoint(Web::PageId page_id, u64 request_id, WebView::DebuggerBreakpointLocation location) =|
    get_debugger_environments(Web::PageId page_id, u64 request_id, u64 frame_id) =|
    evaluate_javascript_in_debugger_frame(Web::PageId page_id, u64 request_id, u64 frame_id, Utf16String source_text) =|
    get_debugger_object_properties(Web::PageId page_id, u64 request_id, u64 object_id) =|
    get_debugger_source_positions(Web::PageId page_id, u64 request_id, Web::HTML::ScriptRegistry::Identifier source_id) =|
    resolve_dom_node_url(Web::PageId page_id, u64 request_id, Optional<Web::UniqueNodeID> node_id, String url) =|

    set_listen_for_dom_mutations(Web::PageId page_id, bool listen_for_dom_mutations) =|
    did_connect_devtools_client(Web::PageId page_id) =|
    did_disconnect_devtools_client(Web::PageId page_id) =|
    get_dom_node_inner_html(Web::PageId page_id, Web::UniqueNodeID node_id) =|
    get_dom_node_outer_html(Web::PageId page_id, Web::UniqueNodeID node_id) =|
    set_dom_node_outer_html(Web::PageId page_id, Web::UniqueNodeID node_id, String html) =|
    set_dom_node_text(Web::PageId page_id, Web::UniqueNodeID node_id, String text) =|
    set_dom_node_tag(Web::PageId page_id, Web::UniqueNodeID node_id, Utf16FlyString name) =|
    add_dom_node_attributes(Web::PageId page_id, Web::UniqueNodeID node_id, Vector<WebView::Attribute> attributes) =|
    replace_dom_node_attribute(Web::PageId page_id, Web::UniqueNodeID node_id, Utf16FlyString name, Vector<WebView::Attribute> replacement_attributes) =|
    create_child_element(Web::PageId page_id, Web::UniqueNodeID node_id) =|
    create_child_text_node(Web::PageId page_id, Web::UniqueNodeID node_id) =|
    insert_dom_node_before(Web::PageId page_id, Web::UniqueNodeID node_id, Web::UniqueNodeID parent_node_id, Optional<Web::UniqueNodeID> sibling_node_id) =|
    clone_dom_node(Web::PageId page_id, Web::UniqueNodeID node_id) =|
    remove_dom_node(Web::PageId page_id, Web::UniqueNodeID node_id) =|

    take_document_screenshot(Web::PageId page_id) =|
    take_dom_node_screenshot(Web::PageId page_id, Web::UniqueNodeID node_id) =|

    request_internal_page_info(Web::PageId page_id, WebView::PageInfoType type) =|

    get_selected_text(Web::PageId page_id, u64 request_id) =|
    get_selected_text_for_lookup(Web::PageId page_id, u64 request_id) =|
    select_word_for_dictionary_lookup(Web::PageId page_id, u64 request_id, Web::DevicePixelPoint position) =|
    cut_selected_text(Web::PageId page_id, u64 request_id) =|
    select_all(Web::PageId page_id) =|
    undo(Web::PageId page_id) =|
    redo(Web::PageId page_id) =|
    paste(Web::PageId page_id, Utf16String text) =|
    paste_from_clipboard(Web::PageId page_id) =|
    set_marked_text_from_input_method(Web::PageId page_id, Utf16String text) =|
    commit_text_from_input_method(Web::PageId page_id, Utf16String text, i32 replacement_start, i32 replacement_length) =|
    unmark_text_from_input_method(Web::PageId page_id) =|

    find_in_page(Web::PageId page_id, Utf16String query, AK::CaseSensitivity case_sensitivity) =|
    find_in_page_next_match(Web::PageId page_id) =|
    find_in_page_previous_match(Web::PageId page_id) =|

    set_content_blockers(Core::AnonymousBuffer patterns) =|
    set_autoplay_settings(Web::PageId page_id, Web::HTML::AutoplayPolicy policy, Vector<Utf16String> allowlist) =|
    set_preferred_color_scheme(Web::PageId page_id, Web::CSS::PreferredColorScheme color_scheme) =|
    set_preferred_contrast(Web::PageId page_id, Web::CSS::PreferredContrast contrast) =|
    set_preferred_motion(Web::PageId page_id, Web::CSS::PreferredMotion motion) =|
    set_preferred_languages(Web::PageId page_id, Vector<String> preferred_languages) =|
    set_browsing_behavior(Web::PageId page_id, WebView::BrowsingBehavior browsing_behavior) =|
    set_enable_global_privacy_control(Web::PageId page_id, bool enable) =|
    set_geolocation_emulated_position(Web::PageId page_id, WebView::GeolocationPositionData position, Optional<u16> error_code) =|
    geolocation_position_response(Web::PageId page_id, u64 request_id, WebView::GeolocationPositionData position, Optional<u16> error_code) =|
    set_has_focus(Web::PageId page_id, bool has_focus) =|
    set_is_scripting_enabled(Web::PageId page_id, bool is_scripting_enabled) =|
    set_zoom_level(Web::PageId page_id, double zoom_level) =|
    set_maximum_frames_per_second(Web::PageId page_id, double maximum_frames_per_second) =|

    set_window_position(Web::PageId page_id, Web::DevicePixelPoint position) =|
    set_window_size(Web::PageId page_id, Web::DevicePixelSize size) =|
    did_complete_window_rect_request(Web::PageId page_id, u64 completion_id) =|
    reset_zoom(Web::PageId page_id) =|

    handle_file_return(Web::PageId page_id, i32 error, Optional<IPC::File> file, i32 request_id) =|
    blob_url_entry_removed(Utf16String url) =|
    did_delete_all_cookies(Web::PageId page_id, u64 request_id) =|

    update_visibility_state(Web::PageId page_id, Web::HTML::CrossProcessId navigable_id, Web::HTML::VisibilityState visibility_state) =|

    alert_closed(Web::PageId page_id) =|
    confirm_closed(Web::PageId page_id, bool accepted) =|
    prompt_closed(Web::PageId page_id, Optional<Utf16String> response) =|
    color_picker_update(Web::PageId page_id, Optional<Color> picked_color, Web::HTML::ColorPickerUpdateState state) =|
    file_picker_closed(Web::PageId page_id, Vector<Web::HTML::SelectedFile> selected_files) =|
    select_dropdown_closed(Web::PageId page_id, Optional<u32> selected_item_id) =|

    retrieved_clipboard_entries(Web::PageId page_id, u64 request_id, Vector<Web::Clipboard::SystemClipboardItem> items) =|

    toggle_media_play_state(Web::PageId page_id) =|
    toggle_media_mute_state(Web::PageId page_id) =|
    toggle_media_loop_state(Web::PageId page_id) =|
    toggle_media_fullscreen_state(Web::PageId page_id) =|
    toggle_media_controls_state(Web::PageId page_id) =|

    set_page_mute_state(Web::PageId page_id, Web::HTML::MuteState mute_state) =|

    set_user_style(Web::PageId page_id, String source) =|

    system_time_zone_changed() =|
    set_system_font_family(String family) =|

    set_document_cookie_version_buffer(Web::PageId page_id, Core::AnonymousBuffer document_cookie_version_buffer) =|
    set_document_cookie_version_index(Web::PageId page_id, i64 document_id, Core::SharedVersionIndex document_index) =|
    cookies_changed(Web::PageId page_id, Vector<HTTP::Cookie::Cookie> cookies) =|
    broadcast_channel_message(Web::HTML::BroadcastChannelMessage message) =|

    did_worker_agent_fail_loading_script(Web::HTML::WorkerAgentOwnerToken owner_token) =|
    did_worker_agent_report_exception(Web::HTML::WorkerAgentOwnerToken owner_token, Utf16String message, Utf16String filename, u32 lineno, u32 colno) =|
    did_worker_agent_close(Web::HTML::WorkerAgentOwnerToken owner_token) =|
    did_worker_agent_die(Web::HTML::WorkerAgentOwnerToken owner_token) =|

    request_close(Web::PageId page_id) =|
    force_close(Web::PageId page_id) =|

    exit_fullscreen(Web::PageId page_id) =|
}
