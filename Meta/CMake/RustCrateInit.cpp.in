extern "C" void ladybird_init_rust_panic_@ARG_CRATE_NAME@();
extern "C" void ladybird_init_rust_demangle_@ARG_CRATE_NAME@();

namespace {

struct RustCrateInitializer {
    RustCrateInitializer()
    {
        ladybird_init_rust_panic_@ARG_CRATE_NAME@();
        ladybird_init_rust_demangle_@ARG_CRATE_NAME@();
    }
};

RustCrateInitializer s_rust_crate_initializer;

}
