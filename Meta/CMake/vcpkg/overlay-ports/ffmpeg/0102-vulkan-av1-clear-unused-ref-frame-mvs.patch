diff --git a/libavcodec/avcodec.h b/libavcodec/avcodec.h
--- a/libavcodec/avcodec.h
+++ b/libavcodec/avcodec.h
@@ -2034,6 +2034,13 @@
 #define AV_HWACCEL_FLAG_UNSAFE_OUTPUT (1 << 3)
 
 /**
+ * Ladybird: for each Vulkan AV1 frame that does not use reference frame motion
+ * vectors, clear enable_ref_frame_mvs in the sequence header passed with it,
+ * which works around NVIDIA's driver (#14510). Needs VK_KHR_video_maintenance2.
+ */
+#define AV_HWACCEL_FLAG_LADYBIRD_CLEAR_UNUSED_REF_FRAME_MVS (1 << 30)
+
+/**
  * @}
  */
 
diff --git a/libavcodec/vulkan_av1.c b/libavcodec/vulkan_av1.c
--- a/libavcodec/vulkan_av1.c
+++ b/libavcodec/vulkan_av1.c
@@ -610,6 +610,9 @@
     if (ctx->s.extensions & FF_VK_EXT_VIDEO_MAINTENANCE_2) {
         vk_av1_params_fill(avctx, &av1_timing_info, &av1_color_config,
                            &av1_sequence_header);
+        if ((avctx->hwaccel_flags & AV_HWACCEL_FLAG_LADYBIRD_CLEAR_UNUSED_REF_FRAME_MVS) &&
+            !s->raw_frame_header->use_ref_frame_mvs)
+            av1_sequence_header.flags.enable_ref_frame_mvs = 0;
         av1_params = (VkVideoDecodeAV1InlineSessionParametersInfoKHR) {
             .sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_AV1_INLINE_SESSION_PARAMETERS_INFO_KHR,
             .pStdSequenceHeader = &av1_sequence_header,
