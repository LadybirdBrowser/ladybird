   if(CURL_USE_PKGCONFIG)
     find_package(PkgConfig QUIET)
     pkg_check_modules(_nghttp2 ${_nghttp2_pc_requires})
@@ -60,9 +58,6 @@ if(_nghttp2_FOUND)
