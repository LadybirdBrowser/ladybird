diff --git b/CMake/FindNGHTTP2.cmake a/CMake/FindNGHTTP2.cmake
index 3be4831..bca7cf8 100644
--- b/CMake/FindNGHTTP2.cmake
+++ a/CMake/FindNGHTTP2.cmake
@@ -39,8 +39,6 @@ set(_nghttp2_pc_requires "libnghttp2")
 
 if(NOT DEFINED NGHTTP2_INCLUDE_DIR AND
