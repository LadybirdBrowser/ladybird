-  find_package_handle_standard_args(NGHTTP3 REQUIRED_VARS nghttp3_CONFIG)
 else()
   find_path(NGHTTP3_INCLUDE_DIR NAMES "nghttp3/nghttp3.h")
   if(NGHTTP3_USE_STATIC_LIBS)
