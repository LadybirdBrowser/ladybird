{
  "name": "curl",
  "version": "8.23.0",
  "port-version": 1,
  "description": "A library for transferring data with URLs",
  "homepage": "https://curl.se/",
  "license": "curl AND ISC AND BSD-3-Clause",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    "zlib"
  ],
  "default-features": [
    "ssl"
  ],
  "features": {
    "brotli": {
      "description": "brotli support (brotli)",
      "dependencies": [
        "brotli"
      ]
    },
    "http2": {
      "description": "HTTP2 support",
      "dependencies": [
        {
          "name": "curl",
          "default-features": false,
          "features": [
            "ssl"
          ]
        },
        "nghttp2"
      ]
    },
    "http3": {
      "description": "HTTP3 support with ngtcp2 on openssl",
      "dependencies": [
        {
          "name": "curl",
          "default-features": false,
          "features": [
            "openssl"
          ]
        },
        "nghttp3",
        {
          "name": "ngtcp2",
          "default-features": false,
          "features": [
            "openssl"
          ]
        }
      ]
    },
    "openssl": {
      "description": "TLS support (OpenSSL)",
      "dependencies": [
        "openssl"
      ]
    },
    "ssl": {
      "description": "Default SSL / TLS implementation.",
      "dependencies": [
        {
          "$comment": "Otherwise, defaults to OpenSSL.",
          "name": "curl",
          "default-features": false,
          "features": [
            "openssl"
          ],
          "platform": "uwp | !windows"
        },
        {
          "$comment": "Defaults to schannel on Windows, unless http3 is also enabled",
          "name": "curl",
          "default-features": false,
          "features": [
            "sspi"
          ],
          "platform": "windows & !uwp"
        }
      ]
    },
    "sspi": {
      "description": "SSPI support",
      "supports": "windows & !uwp"
    },
    "websockets": {
      "description": "WebSocket support"
    },
    "zstd": {
      "description": "ZStandard support (zstd)",
      "dependencies": [
        "zstd"
      ]
    }
  }
}
