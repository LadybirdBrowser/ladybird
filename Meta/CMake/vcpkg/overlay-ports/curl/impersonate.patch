+/* Check both CPU feature bits and operating-system SIMD support. */
+static uint32_t ws_get_cpu_features(void)
+{
+  uint32_t features = WS_CPU_FEAT_INIT;
+
+#ifdef _MSC_VER
+  int cpuinfo[4];
+  int max_leaf;
+  unsigned __int64 xcr0;
+
+  /* Check the maximum supported CPUID leaf. */
+  __cpuid(cpuinfo, 0);
+  max_leaf = cpuinfo[0];
+  if(max_leaf < 1)
+    return features;
+
+  __cpuidex(cpuinfo, 1, 0);
+  /* Check XSAVE, OSXSAVE and AVX. */
+  if((cpuinfo[2] & ((1 << 26) | (1 << 27) | (1 << 28))) !=
+     ((1 << 26) | (1 << 27) | (1 << 28)))
+    return features;
+
+  xcr0 = _xgetbv(0);
+  if((xcr0 & 0x06) != 0x06)
+    return features;
+
+  if(max_leaf >= 7) {
+    __cpuidex(cpuinfo, 7, 0);
+    if(cpuinfo[1] & (1 << 5))
+      features |= WS_CPU_FEAT_AVX2;
+    if(((xcr0 & 0xe6) == 0xe6) && (cpuinfo[1] & (1 << 16)))
+      features |= WS_CPU_FEAT_AVX512;
+  }
+#elif defined(__GNUC__) || defined(__clang__)
+  unsigned int eax = 0;
+  unsigned int ebx = 0;
+  unsigned int ecx = 0;
+  unsigned int edx = 0;
+  unsigned int max_leaf;
+  uint32_t xcr0_eax;
+  uint32_t xcr0_edx;
+
+  /* Check the maximum supported CPUID leaf. */
+  max_leaf = __get_cpuid_max(0, NULL);
+  if(max_leaf < 1)
+    return features;
+  if(!__get_cpuid(1, &eax, &ebx, &ecx, &edx))
+    return features;
+  /* Check XSAVE, OSXSAVE and AVX. */
+  if((ecx & ((1 << 26) | (1 << 27) | (1 << 28))) !=
+     ((1 << 26) | (1 << 27) | (1 << 28)))
+    return features;
+
+  __asm__ volatile("xgetbv" : "=a"(xcr0_eax), "=d"(xcr0_edx) : "c"(0));
+  (void)xcr0_edx;
+  if((xcr0_eax & 0x06) != 0x06)
+    return features;
+
+  if(max_leaf >= 7) {
+    __cpuid_count(7, 0, eax, ebx, ecx, edx);
+    if(ebx & (1 << 5))
+      features |= WS_CPU_FEAT_AVX2;
+    if(((xcr0_eax & 0xe6) == 0xe6) && (ebx & (1 << 16)))
+      features |= WS_CPU_FEAT_AVX512;
+  }
+#endif
+
+  return features;
+}
+#endif
