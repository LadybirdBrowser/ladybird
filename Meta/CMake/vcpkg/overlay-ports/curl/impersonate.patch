+    return Curl_setstropt(data, STRING_TLS_EXTENSION_ORDER, ptr);
+  case CURLOPT_HTTP2_PSEUDO_HEADERS_ORDER:
+    return Curl_setstropt(data, STRING_HTTP2_PSEUDO_HEADERS_ORDER, ptr);
+  case CURLOPT_HTTP2_SETTINGS:
