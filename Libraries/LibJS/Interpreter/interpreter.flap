handler IsCallable(
    dst: out Operand,
    value: in Operand
) {
    let not_callable = || {
        store(dst, Value<False>);
        dispatch_next;
    };

    guard let Value<Object>(object) = load(value) else not_callable;
    guard object.flags has OBJECT_FLAG_IS_FUNCTION else not_callable;
    store(dst, Value<True>);
    dispatch_next;
}

