) @cold = call_slow_path(has_private_id);

handler SetFunctionName(
    function: Operand,
    name: Operand,
    prefix: FunctionNamePrefix
) @cold = call_slow_path(set_function_name);

handler NewArrayWithLength(
    dst: out Operand,
    array_length: Operand
) @cold = call_slow_path(new_array_with_length);

handler ArrayAppend(
    dst: out Operand,
    src: Operand,
    is_spread: bool
) @cold = call_slow_path(array_append);

handler CreateVariable(
    identifier: IdentifierTableIndex,
    mode: EnvironmentMode,
    is_immutable: bool,
    is_global: bool,
    is_strict: bool
) @cold = call_slow_path(create_variable);

handler EnterObjectEnvironment(
    dst: out Operand,
    object: Operand
) @cold = call_slow_path(enter_object_environment);

handler PostfixIncrement(
    dst: out Operand,
    src: inout Operand
) = post_update_operand(dst, src, checked_add, add_f64, postfix_increment);

handler Div(
    dst: out Operand,
    lhs: in Operand,
    rhs: in Operand
) {
    let lhs = load(lhs);
    let rhs = load(rhs);

    guard let [lhs_number, rhs_number] = numeric_pair_to_f64(lhs, rhs) else @cold {
        call_binary_slow_path(div_values, dst, lhs, rhs);
    };

    let quotient = lhs_number / rhs_number;
    guard let integer = double_to_int32(quotient) else store_f64;
    guard integer != 0 else check_negative_zero;
    goto store_i32(integer);

    let check_negative_zero = || {
        let bits = box_f64(quotient);
        branch_value_bits_negative(bits, store_f64);
        goto store_i32(integer);
    };

    let store_i32 = |integer: i32| @hot {
        store(dst, box_i32(integer));
        dispatch_next;
    };

    let store_f64 = || {
        store(dst, canonicalize_nan(quotient));
        dispatch_next;
    };
}

handler LessThan(
    dst: out Operand,
    lhs: in Operand,
    rhs: in Operand
) = store_relational_result(
    dst,
    load(lhs),
    load(rhs),
    branch_lt_signed,
    branch_fp_less,
    less_than_values
);

handler LessThanEquals(
    dst: out Operand,
    lhs: in Operand,
    rhs: in Operand
) = store_relational_result(
    dst,
    load(lhs),
    load(rhs),
    branch_le_signed,
    branch_fp_less_or_equal,
    less_than_equals_values
);

handler GreaterThan(
    dst: out Operand,
    lhs: in Operand,
    rhs: in Operand
) = store_relational_result(
    dst,
    load(lhs),
    load(rhs),
    branch_gt_signed,
    branch_fp_greater,
    greater_than_values
);

handler GreaterThanEquals(
    dst: out Operand,
    lhs: in Operand,
    rhs: in Operand
) = store_relational_result(
    dst,
    load(lhs),
    load(rhs),
    branch_ge_signed,
    branch_fp_greater_or_equal,
    greater_than_equals_values
);

handler BitwiseXor(
    dst: out Operand,
    lhs: in Operand,
    rhs: in Operand
) = bitwise_binary(dst, load(lhs), load(rhs), xor, bitwise_xor_values);

handler UnaryPlus(
    dst: out Operand,
    src: in Operand
) {
    let value = load(src);
    match value {
        Value<i32> => {
            store(dst, value);
            dispatch_next;
        },

        Value<f64> => @cold {
            store(dst, value);
            dispatch_next;
        },

        _ => @cold {
            call_slow_path(unary_plus);
        },
    }
}

handler ThrowIfTDZ(
    src: in Operand
) {
    guard load(src) is not Value<Empty> else @cold {
        call_slow_path(throw_if_tdz);
    };
    dispatch_next;
}

handler ThrowIfNotObject(
    src: in Operand
) {
    guard load(src) is Value<Object> else @cold {
        call_slow_path(throw_if_not_object);
    };
    dispatch_next;
}

handler ThrowIfNullish(
    src: in Operand
) {
    guard load(src) is not Value<Nullish> else @cold {
        call_slow_path(throw_if_nullish);
    };
    dispatch_next;
}

handler ThrowConstAssignment() @cold = call_slow_path(throw_const_assignment);

handler Throw(
    src: Operand
) @terminator @cold = call_slow_path(throw);

handler Debugger() @cold = call_slow_path(debugger);

handler Await(
    continuation_label: BytecodeOffset,
    argument: Operand
) @terminator @cold = call_slow_path(await);

handler Yield(
    continuation_label: Optional<Label>,
    value: Operand
) @terminator @cold = call_slow_path(yield);

handler YieldIteratorResult(
    continuation_label: BytecodeOffset,
    value: Operand
) @terminator @cold = call_slow_path(yield_iterator_result);

handler ToString(
    dst: out Operand,
    value: Operand
) @cold = call_slow_path(to_string);

handler ToPrimitiveWithStringHint(
    dst: out Operand,
    value: Operand
) @cold = call_slow_path(to_primitive_with_string_hint);

handler ToObject(
    dst: out Operand,
    value: Operand
) @cold = call_slow_path(to_object);

handler ToLength(
    dst: out Operand,
    value: Operand
) @cold = call_slow_path(to_length);

handler BitwiseNot(
    dst: out Operand,
    src: in Operand
) {
    match load(src) {
        Value<i32>(integer) => {
            integer = ~integer;
            store(dst, box_i32(integer));
            dispatch_next;
        },

        _ => @cold {
            call_slow_path(bitwise_not);
        },
    }
}

handler BitwiseAnd(
    dst: out Operand,
    lhs: in Operand,
    rhs: in Operand
) = bitwise_binary(dst, load(lhs), load(rhs), and, bitwise_and_values);

handler BitwiseOr(
    dst: out Operand,
    lhs: in Operand,
    rhs: in Operand
) = bitwise_binary(dst, load(lhs), load(rhs), or, bitwise_or_values);

handler LeftShift(
    dst: out Operand,
    lhs: in Operand,
    rhs: in Operand
) = signed_shift(dst, load(lhs), load(rhs), shl, left_shift_values);

handler RightShift(
    dst: out Operand,
    lhs: in Operand,
    rhs: in Operand
) = signed_shift(dst, load(lhs), load(rhs), sar, right_shift_values);

handler UnsignedRightShift(
    dst: out Operand,
    lhs: in Operand,
    rhs: in Operand
) {
    let lhs = load(lhs);
    let rhs = load(rhs);

    let slow = || @cold {
        call_binary_slow_path(unsigned_right_shift_values, dst, lhs, rhs);
    };

    guard let Value<i32>(integer) = lhs else slow;
    guard let Value<i32>(count) = rhs else slow;
    let value = u32(integer);
    let as_double = || @cold {
        store(dst, box_f64(u32_to_f64(value)));
        dispatch_next;
    };
    count = count & 31;
    value = value >> u32(count);
    branch_bit_set(value, 31, as_double);
    store(dst, box_i32(assume_i32(value)));
    dispatch_next;

}

handler Mod(
    dst: out Operand,
    lhs: in Operand,
    rhs: in Operand
) {
    let lhs = load(lhs);
    let rhs = load(rhs);

    let slow = || @cold {
        call_binary_slow_path(mod_values, dst, lhs, rhs);
    };

    guard let Value<i32>(lhs_int) = lhs else slow;
    guard let Value<i32>(rhs_int) = rhs else slow;
    guard rhs_int != 0 else slow;
    guard lhs_int >= 0 else slow;
    let [_, remainder] = divmod(lhs_int, rhs_int);
    store(dst, box_i32(remainder));
    dispatch_next;
}

handler StrictlyEquals(
    dst: out Operand,
    lhs: in Operand,
    rhs: in Operand
) = store_equality_result(
    dst,
    load(lhs),
    load(rhs),
    strict_equality,
    strictly_equals_values
);

handler StrictlyInequals(
    dst: out Operand,
    lhs: in Operand,
    rhs: in Operand
) = store_equality_result(
    dst,
    load(lhs),
    load(rhs),
    strict_inequality,
    strictly_inequals_values
);

handler GetCalleeAndThisFromEnvironment(
    callee: out Operand,
    this_value: out Operand,
    identifier: IdentifierTableIndex,
    cache: EnvironmentCoordinate
) {
    let [environment, binding_index] =
        walk_environment_chain(exec_ctx.lexical_environment, cache);
    guard let value = load_initialized_binding(environment.binding_values, binding_index) else @cold {
        call_slow_path(get_callee_and_this);
    };
    store(callee, value);
    store(this_value, Value<Undefined>);
    dispatch_next;
}

handler DynamicGetCalleeAndThisFromEnvironment(
    callee: out Operand,
    this_value: out Operand,
    identifier: IdentifierTableIndex,
    cache: EnvironmentCoordinateCacheIndex
) {
    let slow = || @cold {
        call_slow_path(dynamic_get_callee_and_this);
    };

    guard let [hops, binding_index] = load_cached_environment_coordinate(cache) else slow;
    guard let environment = walk_cached_environment_chain(
        exec_ctx.lexical_environment,
        hops
    ) else slow;
    guard let value = load_initialized_binding(environment.binding_values, binding_index) else slow;
    store(callee, value);
    store(this_value, Value<Undefined>);
    dispatch_next;
}

handler LooselyEquals(
    dst: out Operand,
    lhs: in Operand,
    rhs: in Operand
) = store_equality_result(
    dst,
    load(lhs),
    load(rhs),
    loose_equality,
    loosely_equals_values
);

handler LooselyInequals(
    dst: out Operand,
    lhs: in Operand,
    rhs: in Operand
) = store_equality_result(
    dst,
    load(lhs),
    load(rhs),
    loose_inequality,
    loosely_inequals_values
);

handler UnaryMinus(
    dst: out Operand,
    src: in Operand
) {
    let value = load(src);

    match value {
        Value<i32>(integer) => {
            let negative_zero = || @cold {
                store(dst, Value<NegativeZero>);
                dispatch_next;
            };

            let overflow = || @cold {
                neg(integer);
                let unsigned_integer: u32 = alias(integer);
                store(dst, box_f64(u32_to_f64(unsigned_integer)));
                dispatch_next;
            };

            guard integer != 0 else negative_zero;
            neg32_overflow(integer) else overflow;
            store(dst, box_i32(integer));
            dispatch_next;
        },

        Value<f64> => @cold {
            toggle_bit(value, 63);
            store(dst, value);
            dispatch_next;
        },

        _ => @cold {
            call_slow_path(unary_minus);
        },
    }
}

handler PostfixDecrement(
    dst: out Operand,
    src: inout Operand
) = post_update_operand(dst, src, checked_sub, sub_f64, postfix_decrement);

handler ToInt32(
    dst: out Operand,
    value: in Operand
) {
    let loaded_value = load(value);
    let slow = || @cold {
        call_slow_path(to_int32);
    };

    let tag = extract_tag(loaded_value);
    guard tag == INT32_TAG else @cold {
        guard let integer = numeric_value_to_i32(load(value)) else slow;
        store(dst, box_i32(integer));
        dispatch_next;
    };

    store(dst, loaded_value);
    dispatch_next;
}

handler PutByValue(
    base: in Operand,
    property: in Operand,
    src: in Operand,
    kind: PutKind,
    base_identifier: Optional<IdentifierTableIndex>
) {
    let slow = || @cold {
        call_slow_path(put_by_value);
    };

    guard load(kind) == PUT_KIND_NORMAL else slow;
    guard let Value<Object>(object) = load(base) else slow;
    guard let index = array_index(load(property)) else slow;
    let flags = object.flags;
    if flags lacks OBJECT_FLAG_IS_TYPED_ARRAY {
        let try_holey_array_slow = || @cold {
            guard call_interp(asm_try_put_by_value_holey_array) == 0 else slow;
            dispatch_next;
        };

        guard flags lacks OBJECT_FLAG_MAY_INTERFERE else slow;
        match object.indexed_storage_kind {
            INDEXED_STORAGE_KIND_PACKED => @hot {
                guard index < object.indexed_array_like_size else slow;
                let indexed_elements = object.indexed_elements;
                assert_nonzero(indexed_elements);
                indexed_elements[index] = load(src);
                dispatch_next;
            },

            INDEXED_STORAGE_KIND_HOLEY => {
                guard index < object.indexed_array_like_size else slow;
                let indexed_elements = object.indexed_elements;
                guard indexed_elements != 0 else try_holey_array_slow;
                guard index < indexed_elements.capacity else try_holey_array_slow;
                guard indexed_elements[index] is not Value<Empty> else try_holey_array_slow;
                indexed_elements[index] = load(src);
                dispatch_next;
            },

            _ => slow,
        }
    }

    let try_typed_array_slow = || @cold {
        guard call_interp(asm_try_put_by_value_typed_array) == 0 else slow;
        dispatch_next;
    };

    let cached_offset = object.typed_array_cached_data_offset;
    guard cached_offset != TYPED_ARRAY_CACHED_DATA_OFFSET_INVALID else try_typed_array_slow;
    let elements = primitive_storage_cage_base();
    guard index < object.typed_array_array_length else slow;
    let typed_array_kind = object.typed_array_kind;
    let source = load(src);
    let store_non_integer = || {
        match typed_array_kind {
            TYPED_ARRAY_KIND_FLOAT32 => @hot {
                guard let Value<f64>(source_f64) = source else try_typed_array_slow;
                # FIXME: Sink this conversion into the store once lowering
                #        still schedules it ahead of caged address formation.
                let source_f32 = to_f32(source_f64);
                let values: Sequence<f32> = alias(
                    caged_primitive_storage_address(elements, cached_offset, index, 4)
                );
                values[0] = source_f32;
                dispatch_next;
            },

            TYPED_ARRAY_KIND_FLOAT64 => {
                guard source is Value<f64> else try_typed_array_slow;
                let values: Sequence<Value> = alias(
                    caged_primitive_storage_address(elements, cached_offset, index, 8)
                );
                values[0] = source;
                dispatch_next;
            },

            TYPED_ARRAY_KIND_UINT8 | TYPED_ARRAY_KIND_INT8 => {
                guard let converted = numeric_value_to_i32(source) else try_typed_array_slow;
                let values: Sequence<u8> = alias(
                    caged_primitive_storage_address(elements, cached_offset, index, 1)
                );
                values[0] = truncate_u8(converted);
                dispatch_next;
            },

            TYPED_ARRAY_KIND_UINT16 | TYPED_ARRAY_KIND_INT16 => {
                guard let converted = numeric_value_to_i32(source) else try_typed_array_slow;
                let values: Sequence<u16> = alias(
                    caged_primitive_storage_address(elements, cached_offset, index, 2)
                );
                values[0] = truncate_u16(converted);
                dispatch_next;
            },

            # Uint8Clamped is deliberately not handled here: it rounds half to even and clamps rather than truncating,
            # so it keeps using the general path.

            TYPED_ARRAY_KIND_INT32 | TYPED_ARRAY_KIND_UINT32 => {
                guard let converted = numeric_value_to_i32(source) else try_typed_array_slow;
                let values: Sequence<i32> = alias(
                    caged_primitive_storage_address(elements, cached_offset, index, 4)
                );
                values[0] = converted;
                dispatch_next;
            },

            _ => try_typed_array_slow,
        }
    };

    guard let Value<i32>(source_i32) = source else store_non_integer;
    match typed_array_kind {
        TYPED_ARRAY_KIND_UINT8 | TYPED_ARRAY_KIND_INT8 => {
            let values: Sequence<u8> = alias(
                caged_primitive_storage_address(elements, cached_offset, index, 1)
            );
            values[0] = truncate_u8(source_i32);
            dispatch_next;
        },

        TYPED_ARRAY_KIND_UINT16 | TYPED_ARRAY_KIND_INT16 => {
            let values: Sequence<u16> = alias(
                caged_primitive_storage_address(elements, cached_offset, index, 2)
            );
            values[0] = truncate_u16(source_i32);
            dispatch_next;
        },

        TYPED_ARRAY_KIND_UINT8_CLAMPED => {
            let values: Sequence<u8> = alias(
                caged_primitive_storage_address(elements, cached_offset, index, 1)
            );
            if source_i32 < 0 {
                source_i32 = 0;
            } else if source_i32 >= 255 {
                source_i32 = 255;
            }
            values[0] = truncate_u8(source_i32);
            dispatch_next;
        },

        TYPED_ARRAY_KIND_INT32 | TYPED_ARRAY_KIND_UINT32 => {
            let values: Sequence<i32> = alias(
                caged_primitive_storage_address(elements, cached_offset, index, 4)
            );
            values[0] = source_i32;
            dispatch_next;
        },

        TYPED_ARRAY_KIND_FLOAT32 => {
            # FIXME: Sink these conversions into the store once lowering
            #        still schedules them ahead of caged address formation.
            let source_f64 = to_f64(source_i32);
            let source_f32 = to_f32(source_f64);
            let values: Sequence<f32> = alias(
                caged_primitive_storage_address(elements, cached_offset, index, 4)
            );
            values[0] = source_f32;
            dispatch_next;
        },

        TYPED_ARRAY_KIND_FLOAT64 => {
            let source_f64 = to_f64(source_i32);
            let values: Sequence<Value> = alias(
                caged_primitive_storage_address(elements, cached_offset, index, 8)
            );
            values[0] = box_f64(source_f64);
            dispatch_next;
        },

        _ => try_typed_array_slow,
    }
}

handler GetById(
    dst: out Operand,
    base: in Operand,
    property: PropertyKeyTableIndex,
    base_identifier: Optional<IdentifierTableIndex>,
    cache: PropertyLookupCacheIndex
) {
    let try_cache = || @cold {
        guard call_interp(asm_try_get_by_id_cache) == 0 else slow;
        dispatch_next;
    };

    let slow = || @cold {
        call_slow_path(get_by_id);
    };

    guard let Value<Object>(object) = load(base) else try_cache;
    let shape = object.shape;
    guard let property_cache = load_property_lookup_cache(cache) else try_cache;
    guard property_cache.shape == shape else try_cache;
    let cached_prototype = property_cache.prototype;

    # FIXME: Restore a value-producing if once SSA destruction can coalesce its
    #        holder phi with object without adding a hot-path jump.
    let holder = object;
    if cached_prototype != 0 {
        let prototype_chain_validity = property_cache.prototype_chain_validity;
        guard prototype_chain_validity != 0 else try_cache;
        guard prototype_chain_validity.valid != 0 else try_cache;
        holder = cached_prototype;
    }

    guard property_cache.shape_dictionary_generation == shape.dictionary_generation else try_cache;
    let value = holder.named_properties[property_cache.property_offset];
    guard value is not Value<Accessor> else try_cache;
    store(dst, value);
    dispatch_next;
}

handler GetByIdWithThis(
    dst: out Operand,
    base: Operand,
    property: PropertyKeyTableIndex,
    this_value: Operand,
    cache: PropertyLookupCacheIndex
) @cold = call_slow_path(get_by_id_with_this);

handler PutById(
    base: in Operand,
    property: PropertyKeyTableIndex,
    src: in Operand,
    kind: PutKind,
    cache: PropertyLookupCacheIndex,
    base_identifier: Optional<IdentifierTableIndex>
) {
    let slow = || @cold {
        call_slow_path(put_by_id);
    };

    let try_cache = || @cold {
        guard call_interp(asm_try_put_by_id_cache) == 0 else slow;
        dispatch_next;
    };

    guard let Value<Object>(object) = load(base) else try_cache;
    let shape = object.shape;
    guard let property_cache = load_property_lookup_cache(cache) else try_cache;
    guard property_cache.shape == shape else try_cache;
    guard property_cache.prototype == 0 else try_cache;
    guard property_cache.shape_dictionary_generation == shape.dictionary_generation else try_cache;
    guard object.named_properties[property_cache.property_offset] is not Value<Accessor> else try_cache;
    object.named_properties[property_cache.property_offset] = load(src);
    dispatch_next;
}

handler PutByIdWithThis(
    base: Operand,
    this_value: Operand,
    property: PropertyKeyTableIndex,
    src: Operand,
    kind: PutKind,
    cache: PropertyLookupCacheIndex
) @cold = call_slow_path(put_by_id_with_this);

handler GetByValue(
    dst: out Operand,
    base: in Operand,
    property: in Operand,
    base_identifier: Optional<IdentifierTableIndex>
) {
    let slow = || @cold {
        call_slow_path(get_by_value);
    };

    let try_typed_array_slow = || @cold {
        guard call_interp(asm_try_get_by_value_typed_array) == 0 else slow;
        dispatch_next;
    };

    guard let Value<Object>(object) = load(base) else slow;
    guard let index = array_index(load(property)) else slow;
    let flags = object.flags;
    if flags lacks OBJECT_FLAG_IS_TYPED_ARRAY {
        branch_bits_set(flags, OBJECT_FLAG_MAY_INTERFERE, slow);
        match object.indexed_storage_kind {
            INDEXED_STORAGE_KIND_PACKED => @hot {
                guard index < object.indexed_array_like_size else slow;
                let indexed_elements = object.indexed_elements;
                assert_nonzero(indexed_elements);
                store(dst, indexed_elements[index]);
                dispatch_next;
            },

            INDEXED_STORAGE_KIND_HOLEY => {
                guard index < object.indexed_array_like_size else slow;
                let indexed_elements = object.indexed_elements;
                guard indexed_elements != 0 else slow;
                guard index < indexed_elements.capacity else slow;
                let value = indexed_elements[index];
                guard value is not Value<Empty> else slow;
                store(dst, value);
                dispatch_next;
            },

            _ => slow,
        }
    }

    # FIXME: Refine object to TypedArray once nominal pointer refinements
    #        can alias their source without adding a move on either backend.
    let cached_offset = object.typed_array_cached_data_offset;
    guard cached_offset != TYPED_ARRAY_CACHED_DATA_OFFSET_INVALID else try_typed_array_slow;
    let elements = primitive_storage_cage_base();
    guard index < object.typed_array_array_length else try_typed_array_slow;
    let kind = object.typed_array_kind;

    let typed_array_f64_as_int = |raw: i32| {
        store(dst, box_i32(raw));
        dispatch_next;
    };

    let typed_array_f64_as_double = |slot_f64: f64| {
        let result = canonicalize_nan(slot_f64);
        store(dst, result);
        dispatch_next;
    };

    # FIXME: Giving each integer kind its own box-and-dispatch tail removes
    #        one taken branch per load but duplicates about 30 instructions
    #        in this hot handler. Revisit with profile data or cost-aware layout.
    let typed_array_box_int32 = |raw: i32| {
        store(dst, box_i32(raw));
        dispatch_next;
    };

    match kind {
        TYPED_ARRAY_KIND_UINT8 | TYPED_ARRAY_KIND_UINT8_CLAMPED => @hot {
            let value = load_caged_u8(elements, cached_offset, index);
            let widened: i32 = alias(value);
            store(dst, box_i32(widened));
            dispatch_next;
        },

        TYPED_ARRAY_KIND_INT32 => {
            goto typed_array_box_int32(load_caged_i32(elements, cached_offset, index));
        },

        TYPED_ARRAY_KIND_UINT16 => {
            goto typed_array_box_int32(alias(load_caged_u16(elements, cached_offset, index)));
        },

        TYPED_ARRAY_KIND_INT8 => {
            goto typed_array_box_int32(alias(load_caged_i8(elements, cached_offset, index)));
        },

        TYPED_ARRAY_KIND_INT16 => {
            goto typed_array_box_int32(alias(load_caged_i16(elements, cached_offset, index)));
        },

        TYPED_ARRAY_KIND_UINT32 => {
            let raw_u32 = load_caged_u32(elements, cached_offset, index);
            let uint32_to_double = || @cold {
                let slot_f64 = u32_to_f64(raw_u32);
                let result = box_f64(slot_f64);
                store(dst, result);
                dispatch_next;
            };
            guard raw_u32 <= INT32_MAX else uint32_to_double;
            goto typed_array_box_int32(assume_i32(raw_u32));
        },

        TYPED_ARRAY_KIND_FLOAT32 => {
            let value = load_caged_f32(elements, cached_offset, index);
            let slot_f64 = float_to_double(value);
            let slot = box_f64(slot_f64);
            guard slot is not Value<NegativeZero> else typed_array_f64_as_double(slot_f64);
            guard let raw = double_to_int32(slot_f64) else typed_array_f64_as_double(slot_f64);
            goto typed_array_f64_as_int(raw);
        },

        TYPED_ARRAY_KIND_FLOAT64 => {
            let values: Sequence<Value> = alias(
                caged_primitive_storage_address(elements, cached_offset, index, 8)
            );
            let slot = values[0];
            let slot_f64 = unbox_f64(slot);
            guard slot is not Value<NegativeZero> else typed_array_f64_as_double(slot_f64);
            guard let raw = double_to_int32(slot_f64) else typed_array_f64_as_double(slot_f64);
            goto typed_array_f64_as_int(raw);
        },

        _ => try_typed_array_slow,
    }
}

handler GetByValueWithThis(
    dst: out Operand,
    base: Operand,
    property: Operand,
    this_value: Operand
) @cold = call_slow_path(get_by_value_with_this);

handler PutByValueWithThis(
    base: Operand,
    property: Operand,
    this_value: Operand,
    src: Operand,
    kind: PutKind
) @cold = call_slow_path(put_by_value_with_this);

handler PutBySpread(
    base: Operand,
    src: Operand
) @cold = call_slow_path(put_by_spread);

handler GetLength(
    dst: out Operand,
    base: in Operand,
    base_identifier: Optional<IdentifierTableIndex>,
    cache: PropertyLookupCacheIndex
) {
    let slow = || @cold {
        call_slow_path(get_length);
    };

    guard let Value<Object>(object) = load(base) else slow;
    if object.flags has OBJECT_FLAG_HAS_MAGICAL_LENGTH {
        let length = object.indexed_array_like_size;
        let length_double = || @cold {
            store(dst, box_f64(u32_to_f64(length)));
            dispatch_next;
        };

        guard length <= INT32_MAX else length_double;
        store(dst, box_i32(assume_i32(length)));
        dispatch_next;
    }

    let shape = object.shape;
    guard let property_cache = load_property_lookup_cache(cache) else slow;
    guard property_cache.shape == shape else slow;
    guard property_cache.prototype == 0 else slow;
    guard property_cache.shape_dictionary_generation == shape.dictionary_generation else slow;
    let value = object.named_properties[property_cache.property_offset];
    guard value is not Value<Accessor> else slow;
    store(dst, value);
    dispatch_next;
}

handler GetLengthWithThis(
    dst: out Operand,
    base: Operand,
    this_value: Operand,
    cache: PropertyLookupCacheIndex
) @cold = call_slow_path(get_length_with_this);

handler GetMethod(
    dst: out Operand,
    object: Operand,
    property: PropertyKeyTableIndex
) @cold = call_slow_path(get_method);

handler GetIterator(
    dst_iterator_object: out Operand,
    dst_iterator_next: out Operand,
    dst_iterator_done: out Operand,
    iterable: Operand,
    hint: IteratorHint
) @cold = call_slow_path(get_iterator);

handler GetGlobal(
    dst: out Operand,
    identifier: IdentifierTableIndex,
    cache: GlobalVariableCacheIndex
) {
    let slow_environment = || @cold {
        guard call_interp(asm_try_get_global_env_binding) == 0 else slow;
        dispatch_next;
    };

    let slow = || @cold {
        call_slow_path(get_global);
    };

    let realm = exec_ctx.realm;
    let global_object = realm.global_object;
    let environment = realm.global_declarative_environment;
    let global_cache = load_global_variable_cache(cache);
    guard global_cache.environment_serial_number == environment.serial_number else slow;

    let try_environment = || {
        guard global_cache.has_environment_binding_index != 0 else slow;
        guard global_cache.in_module_environment == 0 else slow_environment;
        guard let value = load_initialized_binding(
            environment.binding_values,
            global_cache.environment_binding_index
        ) else slow;
        store(dst, value);
        dispatch_next;
    };

    let shape = global_object.shape;
    guard global_cache.shape == shape else try_environment;
    guard global_cache.shape_dictionary_generation == shape.dictionary_generation else try_environment;
    let value = global_object.named_properties[global_cache.property_offset];
    guard value is not Value<Accessor> else slow;
    store(dst, value);
    dispatch_next;
}

handler SetGlobal(
    identifier: IdentifierTableIndex,
    src: in Operand,
    cache: GlobalVariableCacheIndex
) {
    let slow_environment = || @cold {
        guard call_interp(asm_try_set_global_env_binding) == 0 else slow;
        dispatch_next;
    };

    let slow = || @cold {
        call_slow_path(set_global);
    };

    let realm = exec_ctx.realm;
    let global_object = realm.global_object;
    let environment = realm.global_declarative_environment;
    let global_cache = load_global_variable_cache(cache);
    guard global_cache.environment_serial_number == environment.serial_number else slow;

    let try_environment = || {
        guard global_cache.has_environment_binding_index != 0 else slow;
        guard global_cache.in_module_environment == 0 else slow_environment;
        let binding_index = global_cache.environment_binding_index;
        let binding_values = environment.binding_values;
        guard binding_values[binding_index] is not Value<Empty> else slow;
        guard i32(load_binding_flag(environment, binding_index)) has BINDING_FLAG_MUTABLE else slow;
        binding_values[binding_index] = load(src);
        dispatch_next;
    };

    let shape = global_object.shape;
    guard global_cache.shape == shape else try_environment;
    guard global_cache.shape_dictionary_generation == shape.dictionary_generation else try_environment;
    guard global_object.named_properties[global_cache.property_offset] is not Value<Accessor> else slow;
    global_object.named_properties[global_cache.property_offset] = load(src);
    dispatch_next;
}

handler Call(
    length: u32,
    dst: out Operand,
    callee: in Operand,
    this_value: in Operand,
    argument_count: u32,
    expression_string: Optional<StringTableIndex>,
    arguments: Operand[]
) {
    let slow = || @cold {
        call_slow_path(asm_slow_path_call);
    };

    guard let Value<Object>(function) = load(callee) else slow;
    let flags = function.flags;
    guard flags has OBJECT_FLAG_IS_FUNCTION else slow;
    guard flags has OBJECT_FLAG_IS_ECMASCRIPT_FUNCTION_OBJECT else invoke_try_native;
    let ecmascript_function: ECMAScriptFunctionObject = alias(function);
    let shared_data = ecmascript_function.shared_data;
    let executable_pointer = shared_data.executable;
    let metadata = shared_data.asm_call_metadata;
    guard metadata has SHARED_FUNCTION_INSTANCE_DATA_ASM_CALL_METADATA_CAN_INLINE_CALL else slow;
    guard metadata lacks SHARED_FUNCTION_INSTANCE_DATA_ASM_CALL_METADATA_NEEDS_ENVIRONMENT_OR_THIS_VALUE_RESOLUTION else invoke_interp_inline;
    let receiver: Value = Value<Empty>;
    if metadata has SHARED_FUNCTION_INSTANCE_DATA_ASM_CALL_METADATA_USES_THIS {
        receiver = load(this_value);
        if metadata lacks SHARED_FUNCTION_INSTANCE_DATA_ASM_CALL_METADATA_STRICT {
            if receiver is Value<Nullish> {
                receiver = alias(box_object(function.shape.realm.global_environment.global_this_value));
            } else {
                guard receiver is Value<Object> else invoke_interp_inline;
            }
        }
    }
    let formal_count: u32 = max(u32(metadata), load(argument_count));
    # Construct an interpreter frame for an inline ECMAScript call.
    let registers_and_locals_count = executable_pointer.registers_and_locals_count;
    let callee_slot_count = executable_pointer.registers_and_locals_and_constants_count;
    assert_nonzero(executable_pointer);
    assert_ge_unsigned(callee_slot_count, registers_and_locals_count);
    let maximum_slot_count: u32 = 4294967295;
    let available_argument_slot_count: u32 = maximum_slot_count - callee_slot_count;
    guard available_argument_slot_count >= formal_count else slow;
    let frame_slot_count: u32 = callee_slot_count + formal_count;
    # FIXME: Keep frame size materialization before the VM loads until nested
    #        arithmetic preserves that independent scheduling opportunity.
    let frame_size: u64 = alias(frame_slot_count) * SIZEOF_VALUE + SIZEOF_EXECUTION_CONTEXT;
    let stack_vm = current_vm();
    let frame_base = stack_vm.interpreter_stack_top;
    let stack_limit = stack_vm.interpreter_stack_limit;
    let frame: ExecutionContext = alias(frame_base);
    let frame_end: u64 = frame_base + frame_size;
    assert_ge_unsigned(frame_end, frame_base);
    guard frame_end <= stack_limit else slow;
    let stack_update_vm = current_vm();
    stack_update_vm.interpreter_stack_top = frame_end;
    let frame_values = frame.slots;
    frame.slot_count = frame_slot_count;
    frame.argument_count = formal_count;
    frame.passed_argument_count = load(argument_count);
    let realm = function.shape.realm;
    frame.function = function;
    frame.realm = realm;
    let lexical_environment = ecmascript_function.environment;
    let private_environment = ecmascript_function.private_environment;
    assert_nonzero(lexical_environment);
    frame.lexical_environment = lexical_environment;
    frame.variable_environment = lexical_environment;
    frame.private_environment = private_environment;
    frame.this_value = receiver;
    frame.executable = executable_pointer;
    let empty_tag: Value = Value<Empty>;
    frame.accumulator = empty_tag;
    frame.exception = empty_tag;
    frame.this_value_register = receiver;
    frame.return_value = empty_tag;
    frame.saved_lexical_environment = empty_tag;
    frame.script_or_module = ecmascript_function.script_or_module;
    frame.program_counter = 0;
    frame.skip_when_determining_incumbent_counter = 0;
    frame.yield_continuation = EXECUTION_CONTEXT_NO_YIELD_CONTINUATION;
    frame.yield_is_await = false;
    frame.yield_value_is_iterator_result = false;
    frame.caller_is_construct = false;
    frame.caller_frame = exec_ctx;
    let [_, return_pc, return_destination] = call_site_info(length, dst);
    frame.caller_return_pc = return_pc;
    frame.caller_dst_raw = return_destination;
    let slot_index: u64 = RESERVED_REGISTER_COUNT;
    while slot_index + 1 < alias(registers_and_locals_count) {
        let next_slot_index = slot_index + 1;
        frame_values[slot_index] = empty_tag;
        frame_values[next_slot_index] = empty_tag;
        slot_index = slot_index + 2;
    }
    if slot_index < alias(registers_and_locals_count) {
        frame_values[slot_index] = empty_tag;
    }
    let executable = frame.executable;
    assert_nonzero(executable);
    let constant_count = executable.asm_constants_size;
    let constant_data = executable.asm_constants_data;
    let write_index: u64 = alias(registers_and_locals_count);
    let constant_index: u64 = 0;
    while constant_index < alias(constant_count) {
        assert_nonzero(constant_data);
        frame_values[write_index] = constant_data[constant_index];
        constant_index = constant_index + 1;
        write_index = write_index + 1;
    }
    let actual_argument_count = load(argument_count);
    assert_ge_unsigned(formal_count, actual_argument_count);
    write_index = alias(registers_and_locals_count) + alias(constant_count);
    let caller_values = exec_ctx.slots;
    let argument_operand_indices = &arguments;
    let argument_index: u32 = 0;
    while argument_index < actual_argument_count {
        frame_values[write_index] = caller_values[argument_operand_indices[argument_index]];
        argument_index = argument_index + 1;
        write_index = write_index + 1;
    }
    let fill_end: u64 = write_index + alias(formal_count) - alias(actual_argument_count);
    # FIXME: Keep this value outside the loop until nested constants are
    #        loop-invariant instead of being rematerialized on every iteration.
    let undefined_slot: Value = Value<Undefined>;
    while write_index < fill_end {
        frame_values[write_index] = undefined_slot;
        write_index = write_index + 1;
    }
    # FIXME: Reuse executable_pointer once keeping it live across frame
    #        construction does not exhaust the x86-64 register allocator.
    let direct_executable = frame.executable;
    assert_nonzero(direct_executable);
    pb = direct_executable.bytecode_data;
    let direct_vm = current_vm();
    direct_vm.running_execution_context = frame;
    exec_ctx = frame;
    values = exec_ctx.slots;
    pc = 0;
    goto_handler(pc);
    let invoke_interp_inline = || {
        # Let the interpreter resolve the cases that cannot use the direct
        # frame construction above, then enter the resolved callee.
        guard call_interp(asm_try_inline_call) == 0 else slow;
        let inline_vm = current_vm();
        exec_ctx = inline_vm.running_execution_context;
        assert_nonzero(exec_ctx);
        values = exec_ctx.slots;
        let inline_executable = exec_ctx.executable;
        assert_nonzero(inline_executable);
        pb = inline_executable.bytecode_data;
        pc = 0;
        goto_handler(pc);
    };
    let invoke_try_native = || {
        # Construct the lightweight frame used by raw native functions.
        let flags = function.flags;
        guard flags has OBJECT_FLAG_IS_RAW_NATIVE_FUNCTION else slow;
        let actual_argument_count = load(argument_count);
        let native_frame_size: u64 = alias(actual_argument_count) * SIZEOF_VALUE + SIZEOF_EXECUTION_CONTEXT;
        let native_stack_vm = current_vm();
        let frame_base = native_stack_vm.interpreter_stack_top;
        let native_stack_limit = native_stack_vm.interpreter_stack_limit;
        let native_frame: ExecutionContext = alias(frame_base);
        let native_frame_end: u64 = frame_base + native_frame_size;
        assert_ge_unsigned(native_frame_end, frame_base);
        guard native_frame_end <= native_stack_limit else slow;
        let native_limit_vm = current_vm();
        let machine_stack_limit: u64 = native_limit_vm.stack_base + VM_STACK_SPACE_LIMIT;
        assert_ge_unsigned(machine_stack_limit, native_limit_vm.stack_base);
        guard machine_stack_limit <= fp else slow;
        let native_stack_update_vm = current_vm();
        native_stack_update_vm.interpreter_stack_top = native_frame_end;
        native_frame.slot_count = actual_argument_count;
        native_frame.argument_count = actual_argument_count;
        native_frame.passed_argument_count = actual_argument_count;
        let realm = function.shape.realm;
        native_frame.function = function;
        native_frame.realm = realm;
        let lexical_environment = exec_ctx.lexical_environment;
        let variable_environment = exec_ctx.variable_environment;
        assert_nonzero(lexical_environment);
        assert_nonzero(variable_environment);
        native_frame.lexical_environment = lexical_environment;
        native_frame.variable_environment = variable_environment;
        let private_environment = exec_ctx.private_environment;
        native_frame.private_environment = private_environment;
        let receiver = load(this_value);
        native_frame.this_value = receiver;
        native_frame.script_or_module = zeroed();
        # Raw native frames deliberately have no executable.
        native_frame.executable = null;
        native_frame.program_counter = 0;
        native_frame.skip_when_determining_incumbent_counter = 0;
        native_frame.yield_continuation = EXECUTION_CONTEXT_NO_YIELD_CONTINUATION;
        native_frame.yield_is_await = false;
        native_frame.yield_value_is_iterator_result = false;
        native_frame.caller_is_construct = false;
        let [native_pc, after_pc, destination_offset] = call_site_info(length, dst);
        exec_ctx.program_counter = native_pc;
        native_frame.caller_frame = exec_ctx;
        native_frame.caller_return_pc = after_pc;
        native_frame.caller_dst_raw = destination_offset;
        let native_caller_values = exec_ctx.slots;
        let native_argument_operand_indices = &arguments;
        let native_frame_values = native_frame.slots;
        let argument_index: u32 = 0;
        while argument_index < actual_argument_count {
            native_frame_values[argument_index] = native_caller_values[native_argument_operand_indices[argument_index]];
            argument_index = argument_index + 1;
        }
        let native_running_vm = current_vm();
        native_running_vm.running_execution_context = native_frame;
        exec_ctx = native_frame;
        values = exec_ctx.slots;
        let raw_native_function: RawNativeFunction = alias(function);
        let native_function = raw_native_function.native_function;
        # FIXME: Bind native_payload directly once the allocator can keep the
        #        ABI-pinned result live alongside the native result variant.
        let [native_return, variant] = call_raw_native(native_function);
        let native_payload = native_return;
        variant = variant & 255;
        assert_lt_unsigned(variant, 2);
        guard variant == 0 else @cold {
            # FIXME: Pass native_payload directly once the allocator can
            #        satisfy the helper ABI without conflicting with variant.
            let helper_argument = native_payload;
            let exception_pc: i32 = call_helper(
                asm_helper_handle_raw_native_exception,
                helper_argument
            );
            guard exception_pc >= 0 else @cold {
                exit;
            };
            let exception_vm = current_vm();
            exec_ctx = exception_vm.running_execution_context;
            assert_nonzero(exec_ctx);
            values = exec_ctx.slots;
            let exception_executable = exec_ctx.executable;
            assert_nonzero(exception_executable);
            pb = exception_executable.bytecode_data;
            pc = exec_ctx.program_counter;
            goto_handler(pc);
        };
        let caller_frame = exec_ctx.caller_frame;
        assert_nonzero(caller_frame);
        let return_vm = current_vm();
        return_vm.running_execution_context = caller_frame;
        return_vm.interpreter_stack_top = alias(exec_ctx);
        exec_ctx = caller_frame;
        values = exec_ctx.slots;
        store(dst, native_payload);
        dispatch_variable(load(length));
    };
}

handler CallBuiltinMathAbs(
    dst: out Operand,
    callee: in Operand,
    this_value: Operand,
    argument: in Operand,
    expression_string: Optional<StringTableIndex>
) {
    let slow = || @cold {
        call_slow_path(call_builtin_math_abs);
    };

    validate_builtin(callee, BUILTIN_MATH_ABS) else slow;
    let argument_value = load(argument);
    match argument_value {
        Value<f64> => {
            clear_bit(argument_value, 63);
            store(dst, argument_value);
            dispatch_next;
        },

        Value<i32>(integer_value) => {
            let overflow = || @cold {
                let overflowed_integer = unbox_i32(argument_value);
                neg(overflowed_integer);
                let unsigned_integer: u32 = alias(overflowed_integer);
                store(dst, box_f64(u32_to_f64(unsigned_integer)));
                dispatch_next;
            };
            if integer_value < 0 {
                neg32_overflow(integer_value) else overflow;
            }
            store(dst, box_i32(integer_value));
            dispatch_next;
        },

        _ => slow,
    }
}

handler CallBuiltinMathFloor(
    dst: out Operand,
    callee: in Operand,
    this_value: Operand,
    argument: in Operand,
    expression_string: Optional<StringTableIndex>
) {
    guard let [_, argument_f64] = load_builtin_f64(
        callee,
        argument,
        BUILTIN_MATH_FLOOR
    ) else @cold {
        call_slow_path(call_builtin_math_floor);
    };
    store(dst, box_number(fp_floor(argument_f64)));
    dispatch_next;
}

