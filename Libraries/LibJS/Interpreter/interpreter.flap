handler CallBuiltinStringFromCharCode(
    dst: out Operand,
    callee: in Operand,
    this_value: Operand,
    argument: in Operand,
    expression_string: Optional<StringTableIndex>
) {
    let slow = || @cold {
        call_slow_path(call_builtin_string_from_char_code);
    };

    validate_builtin(callee, BUILTIN_STRING_FROM_CHAR_CODE) else slow;
    guard let Value<i32>(code_unit) = load(argument) else slow;
    let single_utf16_code_unit = || {
        assert_lt_unsigned(code_unit, 0x10000);
        let result: Value = call_helper(asm_helper_single_utf16_code_unit_string, code_unit);
        assert_tag(result, STRING_TAG);
        store(dst, result);
        dispatch_next;
    };
    code_unit = code_unit & 0xffff;
    # FIXME: Use a guard once the nonnegative refinement retains an unsigned
    #        branch condition for this comparison.
    branch_ge_unsigned(code_unit, 0x80, single_utf16_code_unit);

    let result: Value = call_helper(asm_helper_single_ascii_character_string, code_unit);
    assert_tag(result, STRING_TAG);
    store(dst, result);
    dispatch_next;
}

handler CallBuiltinStringPrototypeCharCodeAt(
    dst: out Operand,
    callee: in Operand,
    this_value: in Operand,
    argument: in Operand,
    expression_string: Optional<StringTableIndex>
) {
    let out_of_bounds = || @cold {
        let result: Value = CANON_NAN_BITS;
        store(dst, result);
        dispatch_next;
    };
    let slow = || @cold {
        call_slow_path(call_builtin_string_prototype_char_code_at);
    };

    validate_builtin(callee, BUILTIN_STRING_PROTOTYPE_CHAR_CODE_AT) else slow;
    guard let Value<PrimitiveString>(string) = load(this_value) else slow;
    guard let Value<i32>(index) = load(argument) else slow;
    guard index >= 0 else out_of_bounds;
    let unsigned_index = assume_u32(index);
    guard let code_unit =
        load_primitive_string_utf16_code_unit(string, unsigned_index, out_of_bounds) else slow;
    let signed_code_unit: i32 = alias(code_unit);
    store(dst, box_i32(signed_code_unit));
    dispatch_next;
}

handler CallBuiltinStringPrototypeCharAt(
    dst: out Operand,
    callee: in Operand,
    this_value: in Operand,
    argument: in Operand,
    expression_string: Optional<StringTableIndex>
) {
    let slow = || @cold {
        call_slow_path(call_builtin_string_prototype_char_at);
    };
    let empty = || @cold {
        let zero: u64 = 0;
        let result: Value = call_helper(asm_helper_empty_string, zero);
        assert_tag(result, STRING_TAG);
        store(dst, result);
        dispatch_next;
    };

    validate_builtin(callee, BUILTIN_STRING_PROTOTYPE_CHAR_AT) else slow;
    guard let Value<PrimitiveString>(string) = load(this_value) else slow;
    guard let Value<i32>(index) = load(argument) else slow;
    guard index >= 0 else empty;
    let unsigned_index = assume_u32(index);
    guard let code_unit =
        load_primitive_string_utf16_code_unit(string, unsigned_index, empty) else slow;
    guard code_unit < 0x80 else slow;
    assert_lt_unsigned(code_unit, 0x80);
    let signed_code_unit: i32 = alias(code_unit);
    let result: Value = call_helper(asm_helper_single_ascii_character_string, signed_code_unit);
    assert_tag(result, STRING_TAG);
    store(dst, result);
    dispatch_next;
}

handler GetObjectPropertyIterator(
    dst_iterator: out Operand,
    object: Operand,
    cache: ObjectPropertyIteratorCacheIndex
) @cold = call_slow_path(get_object_property_iterator);

handler ObjectPropertyIteratorNext(
    dst_value: out Operand,
    dst_done: out Operand,
    iterator_object: in Operand
) {
    let slow = || @cold {
        call_slow_path(object_property_iterator_next);
    };

    guard let Value<Object>(iterator_value) = load(iterator_object) else slow;
    let iterator: PropertyNameIterator = alias(iterator_value);
    let fast_path = iterator.fast_path;
    guard fast_path != OBJECT_PROPERTY_ITERATOR_FAST_PATH_NONE else slow;

    let cache = iterator.property_cache;
    # FIXME: Keep this adjacent to the cache load so AArch64 can use ldp;
    #        nesting it into the guard is better on x86-64 but adds an AArch64
    #        instruction by splitting the paired load.
    let cached_shape = iterator.shape;
    let receiver = iterator.object;
    assert_nonzero(cache);
    assert_nonzero(receiver);
    let current_shape = receiver.shape;
    guard current_shape == cached_shape else slow;

    if iterator.shape_is_dictionary {
        guard current_shape.dictionary_generation == iterator.shape_dictionary_generation else slow;
    }

    if fast_path == OBJECT_PROPERTY_ITERATOR_FAST_PATH_PACKED_INDEXED {
        guard receiver.indexed_storage_kind == INDEXED_STORAGE_KIND_PACKED else slow;
        guard receiver.indexed_array_like_size == iterator.indexed_property_count else slow;
    }

    let validity = iterator.prototype_chain_validity;
    if validity != 0 {
        guard validity.valid else slow;
    }

    let indexed_count = iterator.indexed_property_count;
    let next_indexed = iterator.next_indexed_property;
    if next_indexed < indexed_count {
        let property_values = cache.property_values;
        assert_nonzero(property_values);
        store(dst_value, property_values[next_indexed]);
        iterator.next_indexed_property = next_indexed + 1;
        store(dst_done, Value<False>);
        dispatch_next;
    }

    let named_index = iterator.next_property;
    let property_value_count = cache.property_value_count;
    assert_ge_unsigned(property_value_count, indexed_count);
    let named_size = property_value_count - alias(indexed_count);
    if named_index < named_size {
        let key_index: u64 = named_index + alias(indexed_count);
        let property_values = cache.property_values;
        assert_nonzero(property_values);
        store(dst_value, property_values[key_index]);
        iterator.next_property = named_index + 1;
        store(dst_done, Value<False>);
        dispatch_next;
    }

    let exhausted = iterator.iterator_cache_slot;
    if exhausted != 0 {
        iterator.object = null;
        exhausted.reusable_property_name_iterator = alias(iterator);
        iterator.iterator_cache_slot = null;
    }

    store(dst_done, Value<True>);
    dispatch_next;
}

