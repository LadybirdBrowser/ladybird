handler CallBuiltinMathExp(
    dst: out Operand,
    callee: in Operand,
    this_value: Operand,
    argument: in Operand,
    expression_string: Optional<StringTableIndex>
) {
    guard let [argument_value, _] = load_builtin_f64(
        callee,
        argument,
        BUILTIN_MATH_EXP
    ) else @cold {
        call_slow_path(call_builtin_math_exp);
    };
    # FIXME: The helper still consumes the boxed argument even though the
    #        f64 conversion above is otherwise unused. Preserve this odd
    #        sequence until removing it improves both native backends.
    let result: Value = call_helper(asm_helper_math_exp, argument_value);
    store(dst, result);
    dispatch_next;
}

