# Typed Flap bytecode semantics for the JavaScript interpreter.

inline fn max(lhs: u32, rhs: u32) -> u32 {
    if lhs >= rhs {
        lhs
    } else {
        rhs
    }
}

inline fn call_site_info(
    length: u32,
    dst: out Operand
) -> (u32, u32, u32) {
    let [instruction_length, destination_index] = load_pair32(
        [pb, pc, length],
        [pb, pc, dst]
    );
    let current_pc: u32 = pc;
    let return_pc: u32 = current_pc + instruction_length;
    (current_pc, return_pc, destination_index)
}

inline fn check_tag_is_double(tag: inout ValueTag, else failure: Label) {
    tag = tag & NAN_BASE_TAG;
    guard tag != NAN_BASE_TAG else failure;
}

inline fn box_cell(cell: Environment) -> Value {
    let bits: u64 = alias(cell);
    bits = bits | SHIFTED_IS_CELL_PATTERN;
    # FIXME: Use a representation alias once it can coalesce with an inline
    #        function return without leaving its result uninitialized.
    let value: Value;
    mov(value, bits);
    value
}

inline fn box_object(object: Object) -> Value<Object> {
    let pointer: u64 = alias(object);
    pointer = pointer << 16;
    pointer = pointer >> 16;
    pointer = pointer | OBJECT_TAG_SHIFTED;
    # FIXME: Use a representation alias once it can coalesce with an inline
    #        function return without leaving its result uninitialized.
    let value: Value<Object>;
    mov(value, pointer);
    value
}

inline fn move_operand(dst: out Operand, src: in Operand) {
    let [dst_index, src_index] = load_pair32([pb, pc, dst], [pb, pc, src]);
    values[dst_index] = values[src_index];
}

inline fn numeric_value_to_f64(value: Value, else failure: Label) -> f64 {
    match value {
        Value<i32>(integer) => {
            to_f64(integer)
        },

        Value<f64>(number) => {
            number
        },

        _ => failure,
    }
}

inline fn numeric_pair_to_f64(
    lhs: Value,
    rhs: Value,
    else failure: Label
) -> (f64, f64) {
    guard let lhs_result = numeric_value_to_f64(lhs) else failure;
    guard let rhs_result = numeric_value_to_f64(rhs) else failure;

    (lhs_result, rhs_result)
}

inline fn load_property_lookup_cache(
    cache: PropertyLookupCacheIndex,
    else fail: Label
) -> PropertyLookupCache {
    let executable = exec_ctx.executable;
    assert_nonzero(executable);
    let property_cache = executable.property_lookup_caches[load(cache)];
    guard property_cache != 0 else fail;
    and(property_cache, PROPERTY_LOOKUP_CACHE_DATA_POINTER_MASK);
    assert_nonzero(property_cache);
    property_cache
}

inline fn array_index(value: Value, else failure: Label) -> u32 {
    guard let Value<i32>(signed_index) = value else failure;
    let index = u32(signed_index);
    index
}

inline fn load_global_variable_cache(
    cache: GlobalVariableCacheIndex
) -> GlobalVariableCache {
    let executable = exec_ctx.executable;
    assert_nonzero(executable);
    let global_cache = &executable.global_variable_caches[load(cache)];
    assert_nonzero(global_cache);
    global_cache
}

inline fn load_initialized_binding(
    binding_values: Sequence<Value>,
    binding_index: u32,
    else failure: Label
) -> Value {
    let value = binding_values[binding_index];
    guard value is not Value<Empty> else failure;
    value
}

inline fn walk_environment_chain(
    initial_environment: Environment,
    coordinate: EnvironmentCoordinate
) -> (DeclarativeEnvironment, u32) {
    let environment = initial_environment;
    let coordinate = &coordinate;
    let hops = coordinate.hops;
    let binding_index = coordinate.binding_index;
    assert_nonzero(environment);
    if hops != 0 {
        do {
            environment = environment.outer;
            assert_nonzero(environment);
            hops = hops - 1;
        } while hops != 0;
    }

    # NB: Static environment coordinates only traverse declarative environments.
    assert_nonzero(environment);
    let declarative_environment: DeclarativeEnvironment = alias(environment);
    (declarative_environment, binding_index)
}

inline fn load_cached_environment_coordinate(
    cache: EnvironmentCoordinateCacheIndex,
    else failure: Label
) -> (u32, u32) {
    let coordinate = &exec_ctx.executable.environment_coordinate_caches[load(cache)];
    let hops = coordinate.hops;
    let binding_index = coordinate.binding_index;
    guard hops != ENVIRONMENT_COORDINATE_INVALID else failure;
    (hops, binding_index)
}

inline fn walk_cached_environment_chain(
    initial_environment: Environment,
    initial_hops: u32,
    else failure: Label
) -> DeclarativeEnvironment {
    let environment = initial_environment;
    let hops = initial_hops;
    assert_nonzero(environment);
    if hops != 0 {
        do {
            guard environment.declarative != 0 else failure;
            guard environment.permanently_screwed_by_eval == 0 else failure;
            environment = environment.outer;
            guard environment != 0 else failure;
            hops = hops - 1;
        } while hops != 0;
    }

    assert_nonzero(environment);
    guard environment.declarative != 0 else failure;
    guard environment.permanently_screwed_by_eval == 0 else failure;
    let declarative_environment: DeclarativeEnvironment = alias(environment);
    declarative_environment
}

inline fn initialize_binding(
    source_operand: in Operand,
    cache: EnvironmentCoordinate,
    initial_environment: Environment
) {
    let [environment, binding_index] = walk_environment_chain(initial_environment, cache);
    environment.binding_values[binding_index] = load(source_operand);
    dispatch_next;
}

inline fn set_binding(
    source_operand: in Operand,
    cache: EnvironmentCoordinate,
    initial_environment: Environment,
    slow: SlowPath
) {
    let failure = || @cold {
        call_slow_path(slow);
    };

    let [environment, binding_index] = walk_environment_chain(initial_environment, cache);
    let binding_values = environment.binding_values;
    guard binding_values[binding_index] is not Value<Empty> else failure;
    guard i32(load_binding_flag(environment, binding_index)) has BINDING_FLAG_MUTABLE else failure;
    binding_values[binding_index] = load(source_operand);
    dispatch_next;
}

inline fn load_binding_flag(
    environment: DeclarativeEnvironment,
    binding_index: u32
) -> u8 {
    let binding_shape = environment.shape;
    if binding_shape == 0 {
        environment.rare_data.binding_flags[binding_index]
    } else {
        let shape_size = binding_shape.binding_flags_size;
        if shape_size <= alias(binding_index) {
            let local_index: u64 = alias(binding_index) - shape_size;
            environment.rare_data.binding_flags[local_index]
        } else {
            binding_shape.binding_flags[binding_index]
        }
    }
}

inline fn caged_primitive_storage_address(
    cage_base: u64,
    cached_offset: u64,
    index: u32,
    scale: u8
) -> u64 {
    cage_base + ((cached_offset + alias(index) * alias(scale)) & PRIMITIVE_STORAGE_CAGE_OFFSET_MASK)
}

inline fn load_caged_u8(cage_base: u64, cached_offset: u64, index: u32) -> u8 {
    let values: Sequence<u8> = alias(
        caged_primitive_storage_address(cage_base, cached_offset, index, 1)
    );
    values[0]
}

inline fn load_caged_u16(cage_base: u64, cached_offset: u64, index: u32) -> u16 {
    let values: Sequence<u16> = alias(
        caged_primitive_storage_address(cage_base, cached_offset, index, 2)
    );
    values[0]
}

inline fn load_caged_u32(cage_base: u64, cached_offset: u64, index: u32) -> u32 {
    let values: Sequence<u32> = alias(
        caged_primitive_storage_address(cage_base, cached_offset, index, 4)
    );
    values[0]
}

inline fn load_caged_i8(cage_base: u64, cached_offset: u64, index: u32) -> i8 {
    let values: Sequence<i8> = alias(
        caged_primitive_storage_address(cage_base, cached_offset, index, 1)
    );
    values[0]
}

inline fn load_caged_i16(cage_base: u64, cached_offset: u64, index: u32) -> i16 {
    let values: Sequence<i16> = alias(
        caged_primitive_storage_address(cage_base, cached_offset, index, 2)
    );
    values[0]
}

inline fn load_caged_i32(cage_base: u64, cached_offset: u64, index: u32) -> i32 {
    let values: Sequence<i32> = alias(
        caged_primitive_storage_address(cage_base, cached_offset, index, 4)
    );
    values[0]
}

inline fn load_caged_f32(cage_base: u64, cached_offset: u64, index: u32) -> f32 {
    let values: Sequence<f32> = alias(
        caged_primitive_storage_address(cage_base, cached_offset, index, 4)
    );
    values[0]
}

inline fn current_vm() -> VM {
    load_vm()
}

inline fn primitive_storage_cage_base() -> u64 {
    let vm = current_vm();
    vm.primitive_storage_cage_base
}

inline fn normalize_completion_value(initial_value: Value) -> (Value, Value) {
    let value = initial_value;
    let empty_tag: Value = Value<Empty>;
    # FIXME: Use an immutable value-producing if once its result can coalesce
    #        with an inline function output on AArch64.
    if value is Value<Empty> {
        value = Value<Undefined>;
    }
    (value, empty_tag)
}

inline fn return_to_caller(
    return_value: Value,
    else top_level: Label
) {
    let caller_frame = exec_ctx.caller_frame;
    guard caller_frame != 0 else top_level;
    let return_pc = exec_ctx.caller_return_pc;
    let destination_index = exec_ctx.caller_dst_raw;
    caller_frame.program_counter = return_pc;
    caller_frame.slots[destination_index] = return_value;
    let vm = current_vm();
    vm.running_execution_context = caller_frame;
    vm.interpreter_stack_top = alias(exec_ctx);
    inc32_mem([vm, VM_EXECUTION_GENERATION]);
    exec_ctx = caller_frame;
    let executable = exec_ctx.executable;
    assert_nonzero(executable);
    pb = executable.bytecode_data;
    assert_nonzero(pb);
    values = exec_ctx.slots;
    pc = return_pc;
    goto_handler(pc);
}

inline fn return_value(initial_value: Value) {
    let [value, empty_tag] = normalize_completion_value(initial_value);
    return_to_caller(value) else {
        values[3] = value;
        values[1] = empty_tag;
        exit;
    };
}

inline fn update_operand(
    operand: inout Operand,
    integer_operation: CheckedBinaryOperation<i32>,
    float_operation: BinaryOperation<f64>,
    slow_path: SlowPath
) {
    let value = load(operand);
    guard let Value<i32>(integer) = value else slow;
    integer_operation(integer, 1) else overflow;
    store(operand, box_i32(integer));
    dispatch_next;

    let overflow = || @cold {
        let overflowed_integer = unbox_i32(load(operand));
        let result = to_f64(overflowed_integer);
        let one = unbox_f64(DOUBLE_ONE);
        float_operation(result, one);
        store(operand, box_f64(result));
        dispatch_next;
    };
    let slow = || @cold {
        call_slow_path(slow_path);
    };
}

inline fn post_update_operand(
    dst: out Operand,
    operand: inout Operand,
    integer_operation: CheckedBinaryOperation<i32>,
    float_operation: BinaryOperation<f64>,
    slow_path: SlowPath
) {
    let old = load(operand);
    guard let Value<i32>(integer) = old else slow;
    store(dst, old);
    integer_operation(integer, 1) else overflow;
    store(operand, box_i32(integer));
    dispatch_next;

    let overflow = || @cold {
        let overflowed_integer = unbox_i32(load(operand));
        let result = to_f64(overflowed_integer);
        let one = unbox_f64(DOUBLE_ONE);
        float_operation(result, one);
        store(operand, box_f64(result));
        dispatch_next;
    };
    let slow = || @cold {
        call_slow_path(slow_path);
    };
}

inline fn numeric_value_to_i32(value: Value, else failure: Label) -> i32 {
    match value {
        Value<i32>(integer) => {
            integer
        },

        Value<bool>(boolean) => {
            i32(boolean)
        },

        Value<f64>(number) => @cold {
            guard let result = js_to_int32(number) else failure;
            result
        },

        _ => failure,
    }
}

inline fn bitwise_binary(
    dst: out Operand,
    lhs: Value,
    rhs: Value,
    operation: BinaryOperation<i32>,
    slow_path: SlowPath
) {
    let slow = || @cold {
        call_binary_slow_path(slow_path, dst, lhs, rhs);
    };

    let non_int32 = || @cold {
        guard let lhs_integer = numeric_value_to_i32(lhs) else slow;
        guard let rhs_integer = numeric_value_to_i32(rhs) else slow;
        operation(lhs_integer, rhs_integer);
        store(dst, box_i32(lhs_integer));
        dispatch_next;
    };
    guard let Value<i32>(lhs_integer) = lhs else non_int32;
    guard let Value<i32>(rhs_integer) = rhs else non_int32;

    operation(lhs_integer, rhs_integer);
    store(dst, box_i32(lhs_integer));
    dispatch_next;
}

inline fn signed_shift(
    dst: out Operand,
    lhs: Value,
    rhs: Value,
    operation: BinaryOperation<i32>,
    slow_path: SlowPath
) {
    let slow = || @cold {
        call_binary_slow_path(slow_path, dst, lhs, rhs);
    };

    guard let Value<i32>(integer) = lhs else slow;
    guard let Value<i32>(count) = rhs else slow;
    count = count & 31;
    operation(integer, count);
    store(dst, box_i32(integer));
    dispatch_next;
}

inline fn store_relational_result(
    dst: out Operand,
    lhs: Value,
    rhs: Value,
    integer_condition: IntegerCondition,
    float_condition: FloatCondition,
    slow_path: SlowPath
) {
    let store_true = || {
        store(dst, Value<True>);
        dispatch_next;
    };
    let store_false = || {
        store(dst, Value<False>);
        dispatch_next;
    };
    let slow = || @cold {
        call_binary_slow_path(slow_path, dst, lhs, rhs);
    };

    compare_numeric_values(
        lhs,
        rhs,
        integer_condition,
        float_condition,
        store_true,
        store_false
    ) else slow;
}

inline fn equality_same_tag(
    lhs: Value,
    rhs: Value,
    lhs_tag: inout ValueTag,
    equal: Label,
    not_equal: Label,
    compare_f64: Label,
    else slow: Label
) {
    match lhs_tag {
        INT32_TAG | BOOLEAN_TAG => fast_compare,
        OBJECT_TAG | SYMBOL_TAG => fast_compare,
        STRING_TAG => string_compare,
        BIGINT_TAG => slow,
        _ => check_nullish,
    }

    let check_nullish = || {
        lhs_tag = lhs_tag & 0xfffe;
        branch_eq(lhs_tag, UNDEFINED_TAG, fast_compare);
        goto compare_f64;
    };

    let string_compare = || {
        guard lhs is not rhs else equal;
        goto slow;
    };

    let fast_compare = || {
        guard lhs is not rhs else equal;
        goto not_equal;
    };
}

inline fn compare_f64_equality(
    lhs: f64,
    rhs: f64,
    equal: Label,
    not_equal: Label
) {
    branch_fp_unordered(lhs, rhs, not_equal);
    branch_fp_equal(lhs, rhs, equal);
    goto not_equal;
}

inline fn strict_equality(
    lhs: Value,
    rhs: Value,
    equal: Label,
    not_equal: Label,
    else slow: Label
) {
    let rhs_tag = extract_tag(rhs);
    branch_eq(rhs_tag, INT32_TAG, rhs_i32);
    let lhs_tag = extract_tag(lhs);
    guard lhs_tag == rhs_tag else different_tags;
    equality_same_tag(lhs, rhs, lhs_tag, equal, not_equal, compare_f64) else slow;

    let compare_f64 = || {
        let lhs_number = unbox_f64(lhs);
        let rhs_number = unbox_f64(rhs);
        compare_f64_equality(lhs_number, rhs_number, equal, not_equal);
    };

    let different_tags = || {
        branch_eq(lhs_tag, INT32_TAG, lhs_i32);
        check_tag_is_double(lhs_tag) else not_equal;
        check_tag_is_double(rhs_tag) else not_equal;
        goto compare_f64;
    };

    let lhs_i32 = || {
        check_tag_is_double(rhs_tag) else not_equal;
        let integer = unbox_i32(lhs);
        let lhs_number = to_f64(integer);
        let rhs_number = unbox_f64(rhs);
        branch_fp_equal(lhs_number, rhs_number, equal);
        goto not_equal;
    };

    let rhs_i32 = || {
        let rhs_integer = unbox_i32(rhs);
        match lhs {
            Value<i32>(lhs_integer) => {
                branch_eq(lhs_integer, rhs_integer, equal);
                goto not_equal;
            },
            Value<f64>(lhs_double) => @cold {
                compare_f64_equality(lhs_double, to_f64(rhs_integer), equal, not_equal);
            },
            _ => not_equal,
        }
    };
}

inline fn loose_equality(
    lhs: Value,
    rhs: Value,
    equal: Label,
    not_equal: Label,
    else slow: Label
) {
    let rhs_tag = extract_tag(rhs);
    branch_eq(rhs_tag, INT32_TAG, rhs_i32);
    let lhs_tag = extract_tag(lhs);
    guard lhs_tag == rhs_tag else different_tags;
    equality_same_tag(lhs, rhs, lhs_tag, equal, not_equal, compare_f64) else slow;

    let compare_f64 = || {
        let lhs_number = unbox_f64(lhs);
        let rhs_number = unbox_f64(rhs);
        compare_f64_equality(lhs_number, rhs_number, equal, not_equal);
    };

    let different_tags = || {
        lhs_tag = lhs_tag & 0xfffe;
        guard lhs_tag == UNDEFINED_TAG else try_f64;
        rhs_tag = rhs_tag & 0xfffe;
        guard rhs_tag != UNDEFINED_TAG else equal;
        goto slow;
    };

    let try_f64 = || {
        guard lhs is Value<f64> else slow;
        guard rhs is Value<f64> else slow;
        goto compare_f64;
    };

    let rhs_i32 = || {
        let rhs_integer = unbox_i32(rhs);
        match lhs {
            Value<i32>(lhs_integer) => {
                branch_eq(lhs_integer, rhs_integer, equal);
                goto not_equal;
            },
            Value<f64>(lhs_double) => @cold {
                compare_f64_equality(lhs_double, to_f64(rhs_integer), equal, not_equal);
            },
            _ => slow,
        }
    };
}

inline fn strict_inequality(
    lhs: Value,
    rhs: Value,
    not_equal: Label,
    equal: Label,
    else slow: Label
) {
    strict_equality(lhs, rhs, equal, not_equal) else slow;
}

inline fn loose_inequality(
    lhs: Value,
    rhs: Value,
    not_equal: Label,
    equal: Label,
    else slow: Label
) {
    loose_equality(lhs, rhs, equal, not_equal) else slow;
}

inline fn store_equality_result(
    dst: out Operand,
    lhs: Value,
    rhs: Value,
    operation: EqualityOperation,
    slow: SlowPath
) {
    let failure = || @cold {
        call_binary_slow_path(slow, dst, lhs, rhs);
    };
    let store_true = || {
        store(dst, Value<True>);
        dispatch_next;
    };
    let store_false = || {
        store(dst, Value<False>);
        dispatch_next;
    };

    operation(lhs, rhs, store_true, store_false) else failure;
}

inline fn jump_equality(
    lhs: Value,
    rhs: Value,
    true_target: BytecodeOffset,
    false_target: BytecodeOffset,
    operation: EqualityOperation,
    slow: SlowPath
) {
    let failure = || @cold {
        call_jump_slow_path(slow, lhs, rhs, true_target, false_target);
    };
    let take_true = || {
        jump(true_target);
    };
    let take_false = || {
        jump(false_target);
    };

    operation(lhs, rhs, take_true, take_false) else failure;
}

inline fn compare_numeric_values(
    lhs: Value,
    rhs: Value,
    integer_condition: IntegerCondition,
    float_condition: FloatCondition,
    true_result: Label,
    false_result: Label,
    else slow: Label
) {
    let compare_double = |lhs: f64, rhs: f64| @cold {
        branch_fp_unordered(lhs, rhs, false_result);
        float_condition(lhs, rhs, true_result);
        goto false_result;
    };

    match lhs {
        Value<i32>(lhs_integer) => {
            match rhs {
                Value<i32>(rhs_integer) => {
                    integer_condition(lhs_integer, rhs_integer, true_result);
                    goto false_result;
                },
                Value<f64>(rhs_double) => @cold {
                    goto compare_double(to_f64(lhs_integer), rhs_double);
                },
                _ => slow,
            }
        },
        Value<f64>(lhs_double) => @cold {
            match rhs {
                Value<i32>(rhs_integer) => {
                    goto compare_double(lhs_double, to_f64(rhs_integer));
                },
                Value<f64>(rhs_double) => {
                    goto compare_double(lhs_double, rhs_double);
                },
                _ => slow,
            }
        },
        _ => slow,
    }
}

inline fn jump_relational(
    lhs: Value,
    rhs: Value,
    true_target: BytecodeOffset,
    false_target: BytecodeOffset,
    integer_condition: IntegerCondition,
    float_condition: FloatCondition,
    slow: SlowPath
) {
    let failure = || @cold {
        call_jump_slow_path(slow, lhs, rhs, true_target, false_target);
    };
    let take_true = || {
        jump(true_target);
    };
    let take_false = || {
        jump(false_target);
    };

    compare_numeric_values(
        lhs,
        rhs,
        integer_condition,
        float_condition,
        take_true,
        take_false
    ) else failure;
}

inline fn runtime_truthiness(value: Value) -> bool {
    let result: bool = call_helper(asm_helper_to_boolean, value);
    assert_lt_unsigned(result, 2);
    result
}

inline fn box_boolean(value: bool) -> Value {
    let payload: u64 = alias(value);
    let bits = payload | BOOLEAN_FALSE;
    reinterpret_u64_as_value(bits)
}

inline fn validate_builtin(
    callee_operand: in Operand,
    expected_builtin: u8,
    else failure: Label
) {
    guard let Value<Object>(object) = load(callee_operand) else failure;
    guard object.flags has OBJECT_FLAG_IS_FUNCTION else failure;
    let function: FunctionObject = alias(object);
    guard function.has_builtin else failure;
    guard function.builtin == expected_builtin else failure;
}

inline fn load_builtin_f64(
    callee: in Operand,
    argument_operand: in Operand,
    expected_builtin: u8,
    else failure: Label
) -> (Value, f64) {
    validate_builtin(callee, expected_builtin) else failure;
    let argument = load(argument_operand);
    guard let Value<f64>(argument_f64) = argument else failure;
    (argument, argument_f64)
}

inline fn load_primitive_string_utf16_code_unit(
    string: PrimitiveString,
    index: u32,
    out_of_bounds: Label,
    else failure: Label
) -> u32 {
    guard string.deferred_kind == PRIMITIVE_STRING_DEFERRED_KIND_NONE else failure;
    let utf16_data = string.utf16_data;
    guard utf16_data != 0 else failure;
    assert_nonzero(utf16_data);

    let short_string_info = string.utf16_short_string_byte_count_and_flag;
    if short_string_info lacks UTF16_SHORT_STRING_FLAG {
        let encoded_length = utf16_data.length_in_code_units;
        let signed_length: i64 = alias(encoded_length);
        if signed_length < 0 {
            let length = encoded_length << 1 >> 1;
            guard length > alias(index) else out_of_bounds;
            let utf16_storage: Sequence<u16> = alias(utf16_data.string_storage);
            let code_unit: u32 = alias(utf16_storage[index]);
            code_unit
        } else {
            guard encoded_length > alias(index) else out_of_bounds;
            let code_unit: u32 = alias(utf16_data.string_storage[index]);
            code_unit
        }
    } else {
        let wide_short_string_info: u32 = alias(short_string_info);
        let byte_count = wide_short_string_info >> UTF16_SHORT_STRING_BYTE_COUNT_SHIFT_COUNT;
        guard index < byte_count else out_of_bounds;
        let code_unit: u32 = alias(string.utf16_short_string_storage[index]);
        code_unit
    }
}

# Handlers whose complete semantics live in their C++ slow path.

# Bytecode handlers are kept in native layout order.

handler Mov(
    dst: out Operand,
    src: in Operand
) {
    store(dst, load(src));
    dispatch_next;
}

specialize Mov() + Mov() as Mov2;
specialize Mov() + Mov() + Mov() as Mov3;
specialize Mov(src: Undefined);
specialize Mov(src: Undefined) + Mov(src: Undefined) as MovUndefined2;
specialize Mov(src: Undefined) + Mov(src: Undefined) + Mov(src: Undefined) as MovUndefined3;

specialize Add(lhs: Int32);
specialize Add(rhs: Int32);
specialize Sub(rhs: Int32);
specialize Mul(rhs: Int32);
specialize Exp(rhs: Int32);
specialize Div(rhs: Int32);
specialize BitwiseXor(rhs: Int32);
specialize BitwiseAnd(rhs: Int32);
specialize BitwiseOr(rhs: Int32);
specialize LeftShift(rhs: Int32);
specialize RightShift(rhs: Int32);
specialize UnsignedRightShift(rhs: Int32);
specialize Mod(rhs: Int32);
specialize LessThan(rhs: Int32);
specialize LessThanEquals(rhs: Int32);
specialize GreaterThan(rhs: Int32);
specialize GreaterThanEquals(rhs: Int32);
specialize JumpLessThan(rhs: Int32);
specialize JumpLessThanEquals(rhs: Int32);
specialize JumpGreaterThan(rhs: Int32);
specialize JumpGreaterThanEquals(rhs: Int32);
specialize StrictlyEquals(rhs: Int32);
specialize StrictlyInequals(rhs: Int32);
specialize LooselyEquals(rhs: Int32);
specialize LooselyInequals(rhs: Int32);
specialize JumpStrictlyEquals(rhs: Int32);
specialize JumpStrictlyInequals(rhs: Int32);
specialize JumpLooselyEquals(rhs: Int32);
specialize JumpLooselyInequals(rhs: Int32);

handler Add(
    dst: out Operand,
    lhs: in Operand,
    rhs: in Operand
) {
    let lhs_value = load(lhs);
    let rhs_value = load(rhs);
    let slow = || @cold {
        call_binary_slow_path(add_values, dst, lhs_value, rhs_value);
    };
    let add_double = |lhs: f64, rhs: f64| @cold {
        store(dst, box_number(lhs + rhs));
        dispatch_next;
    };
    match lhs_value {
        Value<i32>(lhs_integer) => {
            match rhs_value {
                Value<i32>(rhs_integer) => {
                    guard let sum = checked_add(lhs_integer, rhs_integer) else @cold {
                        store(dst, box_f64(to_f64(lhs_integer) + to_f64(rhs_integer)));
                        dispatch_next;
                    };
                    store(dst, box_i32(sum));
                    dispatch_next;
                },
                Value<f64>(rhs_double) => @cold {
                    goto add_double(to_f64(lhs_integer), rhs_double);
                },
                _ => slow,
            }
        },
        Value<f64>(lhs_double) => @cold {
            match rhs_value {
                Value<i32>(rhs_integer) => {
                    goto add_double(lhs_double, to_f64(rhs_integer));
                },
                Value<f64>(rhs_double) => {
                    goto add_double(lhs_double, rhs_double);
                },
                _ => slow,
            }
        },
        _ => slow,
    }
}

handler Sub(
    dst: out Operand,
    lhs: in Operand,
    rhs: in Operand
) {
    let lhs_value = load(lhs);
    let rhs_value = load(rhs);
    let slow = || @cold {
        call_binary_slow_path(sub_values, dst, lhs_value, rhs_value);
    };
    let subtract_double = |lhs: f64, rhs: f64| @cold {
        store(dst, box_number(lhs - rhs));
        dispatch_next;
    };
    match lhs_value {
        Value<i32>(lhs_integer) => {
            match rhs_value {
                Value<i32>(rhs_integer) => {
                    guard let difference = checked_sub(lhs_integer, rhs_integer) else @cold {
                        store(dst, box_f64(to_f64(lhs_integer) - to_f64(rhs_integer)));
                        dispatch_next;
                    };
                    store(dst, box_i32(difference));
                    dispatch_next;
                },
                Value<f64>(rhs_double) => @cold {
                    goto subtract_double(to_f64(lhs_integer), rhs_double);
                },
                _ => slow,
            }
        },
        Value<f64>(lhs_double) => @cold {
            match rhs_value {
                Value<i32>(rhs_integer) => {
                    goto subtract_double(lhs_double, to_f64(rhs_integer));
                },
                Value<f64>(rhs_double) => {
                    goto subtract_double(lhs_double, rhs_double);
                },
                _ => slow,
            }
        },
        _ => slow,
    }
}

handler Mul(
    dst: out Operand,
    lhs: in Operand,
    rhs: in Operand
) {
    let lhs_value = load(lhs);
    let rhs_value = load(rhs);
    let slow = || @cold {
        call_binary_slow_path(mul_values, dst, lhs_value, rhs_value);
    };
    let multiply_double = |lhs: f64, rhs: f64| @cold {
        store(dst, box_number(lhs * rhs));
        dispatch_next;
    };
    match lhs_value {
        Value<i32>(lhs_integer) => {
            match rhs_value {
                Value<i32>(rhs_integer) => {
                    let negative_zero = || @cold {
                        store(dst, Value<NegativeZero>);
                        dispatch_next;
                    };
                    guard let product = checked_mul(lhs_integer, rhs_integer) else @cold {
                        store(dst, box_f64(to_f64(lhs_integer) * to_f64(rhs_integer)));
                        dispatch_next;
                    };
                    if product == 0 {
                        let sign_check = lhs_integer | rhs_integer;
                        guard sign_check >= 0 else negative_zero;
                    }

                    store(dst, box_i32(product));
                    dispatch_next;
                },
                Value<f64>(rhs_double) => @cold {
                    goto multiply_double(to_f64(lhs_integer), rhs_double);
                },
                _ => slow,
            }
        },
        Value<f64>(lhs_double) => @cold {
            match rhs_value {
                Value<i32>(rhs_integer) => {
                    goto multiply_double(lhs_double, to_f64(rhs_integer));
                },
                Value<f64>(rhs_double) => {
                    goto multiply_double(lhs_double, rhs_double);
                },
                _ => slow,
            }
        },
        _ => slow,
    }
}

handler Exp(
    dst: out Operand,
    lhs: in Operand,
    rhs: in Operand
) {
    call_binary_slow_path(exp_values, dst, load(lhs), load(rhs));
}

handler ConcatString(
    dst: out Operand,
    src: Operand
) @cold = call_slow_path(concat_string);

handler CopyObjectExcludingProperties(
    length: u32,
    dst: out Operand,
    from_object: Operand,
    excluded_names_count: u32,
    excluded_names: Operand[]
) @cold = call_slow_path(copy_object_excluding_properties);

handler ImportCall(
    dst: out Operand,
    specifier: Operand,
    options: Operand
) @cold = call_slow_path(import_call);

handler NewClass(
    length: u32,
    dst: out Operand,
    super_class: Optional<Operand>,
    class_environment: Operand,
    class_blueprint_index: u32,
    lhs_name: Optional<IdentifierTableIndex>,
    element_keys_count: u32,
    element_keys: Optional<Operand>[]
) @cold = call_slow_path(new_class);

handler Jump(
    target: BytecodeOffset
) @terminator = jump(target);

handler JumpIf(
    condition: in Operand,
    true_target: BytecodeOffset,
    false_target: BytecodeOffset
) @terminator {
    let value = load(condition);
    let take_false = || {
        jump(false_target);
    };
    let take_true = || {
        jump(true_target);
    };

    match value {
        Value<bool> => {
            branch_bits_set(value, 1, take_true);
            goto take_false;
        },

        Value<i32> => {
            branch_nonzero32(value, take_true);
            goto take_false;
        },

        _ => {
            guard runtime_truthiness(value) == 0 else take_true;
            goto take_false;
        },
    }
}

handler JumpTrue(
    condition: in Operand,
    target: BytecodeOffset
) @terminator {
    let value = load(condition);
    let take = || {
        jump(target);
    };

    match value {
        Value<bool> => {
            branch_bits_set(value, 1, take);
            dispatch_next;
        },

        Value<i32> => {
            branch_nonzero32(value, take);
            dispatch_next;
        },

        _ => {
            guard runtime_truthiness(value) == 0 else take;
            dispatch_next;
        },
    }
}

handler JumpFalse(
    condition: in Operand,
    target: BytecodeOffset
) @terminator {
    let value = load(condition);
    let take = || {
        jump(target);
    };

    match value {
        Value<bool> => {
            branch_bits_clear(value, 1, take);
            dispatch_next;
        },

        Value<i32> => {
            branch_zero32(value, take);
            dispatch_next;
        },

        _ => {
            guard runtime_truthiness(value) != 0 else take;
            dispatch_next;
        },
    }
}

handler JumpNullish(
    condition: in Operand,
    true_target: BytecodeOffset,
    false_target: BytecodeOffset
) @terminator {
    if load(condition) is Value<Nullish> {
        jump(true_target);
    }
    jump(false_target);
}

handler JumpUndefined(
    condition: in Operand,
    true_target: BytecodeOffset,
    false_target: BytecodeOffset
) @terminator {
    if load(condition) is Value<Undefined> {
        jump(true_target);
    }
    jump(false_target);
}

handler JumpLessThan(
    lhs: in Operand,
    rhs: in Operand,
    true_target: BytecodeOffset,
    false_target: BytecodeOffset
) @terminator = jump_relational(
    load(lhs),
    load(rhs),
    true_target,
    false_target,
    branch_lt_signed,
    branch_fp_less,
    jump_less_than_values
);

handler JumpGreaterThan(
    lhs: in Operand,
    rhs: in Operand,
    true_target: BytecodeOffset,
    false_target: BytecodeOffset
) @terminator = jump_relational(
    load(lhs),
    load(rhs),
    true_target,
    false_target,
    branch_gt_signed,
    branch_fp_greater,
    jump_greater_than_values
);

handler JumpLessThanEquals(
    lhs: in Operand,
    rhs: in Operand,
    true_target: BytecodeOffset,
    false_target: BytecodeOffset
) @terminator = jump_relational(
    load(lhs),
    load(rhs),
    true_target,
    false_target,
    branch_le_signed,
    branch_fp_less_or_equal,
    jump_less_than_equals_values
);

handler JumpGreaterThanEquals(
    lhs: in Operand,
    rhs: in Operand,
    true_target: BytecodeOffset,
    false_target: BytecodeOffset
) @terminator = jump_relational(
    load(lhs),
    load(rhs),
    true_target,
    false_target,
    branch_ge_signed,
    branch_fp_greater_or_equal,
    jump_greater_than_equals_values
);

handler JumpLooselyEquals(
    lhs: in Operand,
    rhs: in Operand,
    true_target: BytecodeOffset,
    false_target: BytecodeOffset
) @terminator = jump_equality(
    load(lhs),
    load(rhs),
    true_target,
    false_target,
    loose_equality,
    jump_loosely_equals_values
);

handler JumpLooselyInequals(
    lhs: in Operand,
    rhs: in Operand,
    true_target: BytecodeOffset,
    false_target: BytecodeOffset
) @terminator = jump_equality(
    load(lhs),
    load(rhs),
    true_target,
    false_target,
    loose_inequality,
    jump_loosely_inequals_values
);

handler JumpStrictlyEquals(
    lhs: in Operand,
    rhs: in Operand,
    true_target: BytecodeOffset,
    false_target: BytecodeOffset
) @terminator = jump_equality(
    load(lhs),
    load(rhs),
    true_target,
    false_target,
    strict_equality,
    jump_strictly_equals_values
);

handler JumpStrictlyInequals(
    lhs: in Operand,
    rhs: in Operand,
    true_target: BytecodeOffset,
    false_target: BytecodeOffset
) @terminator = jump_equality(
    load(lhs),
    load(rhs),
    true_target,
    false_target,
    strict_inequality,
    jump_strictly_inequals_values
);

handler Increment(
    dst: inout Operand
) = update_operand(dst, checked_add, add_f64, increment);

handler Decrement(
    dst: inout Operand
) = update_operand(dst, checked_sub, sub_f64, decrement);

handler Not(
    dst: out Operand,
    src: in Operand
) {
    let value = load(src);
    let store_true = || {
        store(dst, Value<True>);
        dispatch_next;
    };
    let store_false = || {
        store(dst, Value<False>);
        dispatch_next;
    };
    # FIXME: Branch through a distinct continuation to retain the Boolean-first
    #        layout until value-match placement uses profile information.
    let store_false_from_boolean = || {
        goto store_false;
    };

    match value {
        Value<bool> => {
            # FIXME: Toggle bit 0 and store boolean inputs directly once result
            #        sinks can preserve that strictly better fast-path layout.
            branch_bits_clear(value, 1, store_true);
            goto store_false_from_boolean;
        },

        Value<i32> => {
            branch_zero32(value, store_true);
            goto store_false;
        },

        _ => {
            guard value is not Value<Nullish> else store_true;
            guard runtime_truthiness(value) != 0 else store_true;
            goto store_false;
        },
    }
}

handler ToBoolean(
    dst: out Operand,
    value: in Operand
) {
    store(dst, box_boolean(runtime_truthiness(load(value))));
    dispatch_next;
}

handler Catch(
    dst: out Operand
) {
    store(dst, exec_ctx.exception);
    exec_ctx.exception = Value<Empty>;
    dispatch_next;
}

handler Return(
    value: in Operand
) @terminator = return_value(load(value));

handler End(
    value: in Operand
) @terminator {
    let value = load(value);
    assert_not_tag(value, EMPTY_VALUE);
    return_to_caller(value) else {
        values[3] = value;
        exit;
    };
}

handler GetLexicalEnvironment(
    dst: out Operand
) {
    let environment = exec_ctx.lexical_environment;
    assert_nonzero(environment);
    store(dst, box_cell(environment));
    dispatch_next;
}

handler GetImportMeta(
    dst: out Operand
) @cold = call_slow_path(get_import_meta);

handler GetNewTarget(
    dst: out Operand
) @cold = call_slow_path(get_new_target);

handler GetSuperConstructor(
    dst: out Operand
) @cold = call_slow_path(get_super_constructor);

handler SetLexicalEnvironment(
    environment: in Operand
) {
    let environment_value = load(environment);
    assert_tag(environment_value, IS_CELL_PATTERN);
    let environment: Environment = unbox_object(environment_value);
    exec_ctx.lexical_environment = environment;
    dispatch_next;
}

handler GetBinding(
    dst: out Operand,
    identifier: IdentifierTableIndex,
    cache: EnvironmentCoordinate
) {
    let [environment, binding_index] =
        walk_environment_chain(exec_ctx.lexical_environment, cache);
    guard let value = load_initialized_binding(environment.binding_values, binding_index) else @cold {
        call_slow_path(get_binding);
    };
    store(dst, value);
    dispatch_next;
}

handler DynamicGetBinding(
    dst: out Operand,
    identifier: IdentifierTableIndex,
    cache: EnvironmentCoordinateCacheIndex
) {
    let slow = || @cold {
        call_slow_path(dynamic_get_binding);
    };

    guard let [hops, binding_index] = load_cached_environment_coordinate(cache) else slow;
    guard let environment = walk_cached_environment_chain(
        exec_ctx.lexical_environment,
        hops
    ) else slow;
    guard let value = load_initialized_binding(environment.binding_values, binding_index) else slow;
    store(dst, value);
    dispatch_next;
}

handler GetInitializedBinding(
    dst: out Operand,
    identifier: IdentifierTableIndex,
    cache: EnvironmentCoordinate
) {
    let [environment, binding_index] =
        walk_environment_chain(exec_ctx.lexical_environment, cache);
    store(dst, environment.binding_values[binding_index]);
    dispatch_next;
}

handler DynamicGetInitializedBinding(
    dst: out Operand,
    identifier: IdentifierTableIndex,
    cache: EnvironmentCoordinateCacheIndex
) {
    let slow = || @cold {
        call_slow_path(dynamic_get_initialized_binding);
    };

    guard let [hops, binding_index] = load_cached_environment_coordinate(cache) else slow;
    guard let environment = walk_cached_environment_chain(
        exec_ctx.lexical_environment,
        hops
    ) else slow;
    store(dst, environment.binding_values[binding_index]);
    dispatch_next;
}

handler InitializeLexicalBinding(
    identifier: IdentifierTableIndex,
    src: in Operand,
    cache: EnvironmentCoordinate
) = initialize_binding(src, cache, exec_ctx.lexical_environment);

handler InitializeVariableBinding(
    identifier: IdentifierTableIndex,
    src: in Operand,
    cache: EnvironmentCoordinate
) = initialize_binding(src, cache, exec_ctx.variable_environment);

handler DynamicInitializeLexicalBinding(
    identifier: IdentifierTableIndex,
    src: in Operand,
    cache: EnvironmentCoordinateCacheIndex
) {
    let slow = || @cold {
        call_slow_path(dynamic_initialize_lexical_binding);
    };

    guard let [hops, binding_index] = load_cached_environment_coordinate(cache) else slow;
    guard let environment = walk_cached_environment_chain(
        exec_ctx.lexical_environment,
        hops
    ) else slow;
    environment.binding_values[binding_index] = load(src);
    dispatch_next;
}

handler DynamicInitializeVariableBinding(
    identifier: IdentifierTableIndex,
    src: in Operand,
    cache: EnvironmentCoordinateCacheIndex
) {
    let slow = || @cold {
        call_slow_path(dynamic_initialize_variable_binding);
    };

    guard let [hops, binding_index] = load_cached_environment_coordinate(cache) else slow;
    guard let environment = walk_cached_environment_chain(
        exec_ctx.variable_environment,
        hops
    ) else slow;
    environment.binding_values[binding_index] = load(src);
    dispatch_next;
}

handler SetLexicalBinding(
    identifier: IdentifierTableIndex,
    src: in Operand,
    cache: EnvironmentCoordinate
) = set_binding(src, cache, exec_ctx.lexical_environment, set_lexical_binding);

handler SetVariableBinding(
    identifier: IdentifierTableIndex,
    src: in Operand,
    cache: EnvironmentCoordinate
) = set_binding(src, cache, exec_ctx.variable_environment, set_variable_binding);

handler DynamicSetLexicalBinding(
    identifier: IdentifierTableIndex,
    src: in Operand,
    cache: EnvironmentCoordinateCacheIndex
) {
    let failure = || @cold {
        call_slow_path(dynamic_set_lexical_binding);
    };

    guard let [hops, binding_index] = load_cached_environment_coordinate(cache) else failure;
    guard let environment = walk_cached_environment_chain(
        exec_ctx.lexical_environment,
        hops
    ) else failure;
    let binding_values = environment.binding_values;
    guard binding_values[binding_index] is not Value<Empty> else failure;
    guard i32(load_binding_flag(environment, binding_index)) has BINDING_FLAG_MUTABLE else failure;
    binding_values[binding_index] = load(src);
    dispatch_next;
}

handler DynamicSetVariableBinding(
    identifier: IdentifierTableIndex,
    src: in Operand,
    cache: EnvironmentCoordinateCacheIndex
) {
    let failure = || @cold {
        call_slow_path(dynamic_set_variable_binding);
    };

    guard let [hops, binding_index] = load_cached_environment_coordinate(cache) else failure;
    guard let environment = walk_cached_environment_chain(
        exec_ctx.variable_environment,
        hops
    ) else failure;
    let binding_values = environment.binding_values;
    guard binding_values[binding_index] is not Value<Empty> else failure;
    guard i32(load_binding_flag(environment, binding_index)) has BINDING_FLAG_MUTABLE else failure;
    binding_values[binding_index] = load(src);
    dispatch_next;
}

handler ResolveBinding(
    dst: out Operand,
    identifier: IdentifierTableIndex
) @cold = call_slow_path(resolve_binding);

handler ResolveSuperBase(
