// NB: The IPC compiler cannot check that each struct here lists every field of its C++ type. A field left out
//     here does not cross IPC.

#include <LibCompositing/DisplayList/DisplayList.h>

[ExistingCpp]
struct Compositing::DisplayList::AsyncScrollingMetadata {
    Optional<Web::UniqueNodeID> document_id;
    Gfx::IntRect viewport_rect;
    u64 wheel_event_listener_state_generation;
    bool has_blocking_wheel_event_listeners;
    bool has_blocking_wheel_event_region_covering_viewport;
    bool viewport_keeps_horizontal_scrolls;
    bool viewport_keeps_vertical_scrolls;
    double device_pixels_per_css_pixel;
    Compositing::KeyboardScrollState keyboard_scroll_state;
}

[ExistingCpp]
struct Compositing::DisplayList::Properties {
    u64 id;
    u64 compatible_visual_context_tree_structural_epoch;
    Optional<Gfx::Color> surface_clear_color;
    Gfx::Color root_group_color;
}
