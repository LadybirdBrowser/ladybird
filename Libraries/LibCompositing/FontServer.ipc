#include <LibGfx/Font/SharedFontProvider.h>

endpoint FontServer
{
    init_transport(int peer_pid) => (int peer_pid)
    open_font(u64 generation, u64 face_id) => (Gfx::BrokeredFont font)
    match_font(String family, u16 weight, u16 width, u8 slope) => (Gfx::BrokeredFont font)
    match_local_font(String name) => (Gfx::BrokeredFont font)
    match_font_for_code_point(u32 code_point, u16 weight, u16 width, u8 slope, bool prefer_color_emoji) => (Gfx::BrokeredFont font)
    resolve_generic_family(String family, u16 weight, u8 slope) => (Optional<String> resolved_family)
}
