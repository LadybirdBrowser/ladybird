#include <LibWebCommon/Page/InputRoutingDecision.h>

[ExistingCpp, RustDerive=Hash]
enum Web::InputRoutingDecision : u8 {
    ContextNotPresenting,
    NoAsyncScrollingState,
    BlockingWheelEventListeners,
    NoScrollNode,
    StaleWheelEventListeners,
    StepOvertaken,
    GestureEndWithNothingToSnap,
    SnappedAtGestureEnd,
    HitTestTargetsOfAnotherVisualContextTree,
    BlockedByMainThreadRegion,
    BlockedByWheelEventRegion,
    NoScrollTarget,
    ScrollerInOtherDocument,
    StepWithoutDelta,
    PannedVisualViewport,
    Latched,
    LatchedOutermostScrollerToStretch,
    ContinuedLatch,
    HandedToNestedContext,
    NestedContextPassedStepOn,
    NestedContextUnavailable,
    NotOverAScrollbar,
    NotPrimaryButton,
    HoveringScrollbarPaintedByCompositor,
    HoveringScrollbarPaintedByDisplayList,
    BeganScrollbarDrag,
    ContinuedScrollbarDrag,
    EndedScrollbarDrag,
    NoScrollbarDrag,
    LeftDuringScrollbarDrag,
    GestureEndAbsorbedByFling,
    FlingStarted,
    MomentumInterrupted,
    NotDispatchedByCompositor,
    ConsumedByCompositor,
    ForwardedToPage,
    NoAnswerFromCompositor,
    CoalescedIntoLaterEvent,
    DroppedWithoutLocalRoot,
    DroppedOutdatedPointerMove,
    ForwardedToRemoteFrame,
    CompositorDisplayListOutdated,
    StepExceedsInputLeftToThePage,
    DefaultActionPerformedByCompositor,
    NoWheelTarget,
    HandedToNestedNavigable,
    DispatchedWheelEvent,
    PageCanceledWheelEvent,
    ScrollKeptByOverscrollBehavior,
    ScrollbarDragDrivenByCompositor,
    FinishedAccepted,
    FinishedHandled,
    FinishedCancelled,
    FinishedDropped,
}
