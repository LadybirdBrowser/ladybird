// NB: Mod_PlatformCtrl and Mod_PlatformWordJump each name one of these, which one depends on the platform.
[ExistingCpp, Flags, RustDerive=Default+Hash]
enum Web::UIEvents::KeyModifier : u32 {
    Mod_None = 0x00,
    Mod_Alt = 0x01,
    Mod_Ctrl = 0x02,
    Mod_Shift = 0x04,
    Mod_Super = 0x08,
    Mod_Keypad = 0x10,
    Mod_Mask = 0x1F,
    Is_Press = 0x80,
}
