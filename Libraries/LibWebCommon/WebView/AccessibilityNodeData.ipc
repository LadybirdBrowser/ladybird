// NB: The IPC compiler cannot check that this lists every field of each struct. A field left out here does not cross
//     IPC.

#include <LibWebCommon/WebView/AccessibilityNodeData.h>

[ExistingCpp]
enum WebView::AccessibilityNodeData::CheckedState : u8 {
    NotApplicable,
    Unchecked,
    Checked,
    Mixed,
}

[ExistingCpp]
enum WebView::AccessibilityNodeData::ExpandedState : u8 {
    NotApplicable,
    Collapsed,
    Expanded,
}

[ExistingCpp]
enum WebView::AccessibilityNodeData::PressedState : u8 {
    NotApplicable,
    NotPressed,
    Pressed,
    Mixed,
}

// NB: WebView::AccessibilityNodeData has a codec of its own (AccessibilityNodeData.cpp), which sends each of these only
//     when the node has one.

[ExistingCpp]
struct WebView::AccessibilityNodeDetails {
    String description;
    String value;
    String url;
    String language;
    String live;
    String keybinding;
    i32 column_span;
    i32 row_span;
    i32 cell_column_index;
    i32 table_row_count;
    i32 table_column_count;
    i64 table_caption_id;
    String table_summary;
    Vector<i64> column_header_ids;
    Vector<i64> row_header_ids;
    Optional<double> value_numeric;
    Optional<double> value_minimum;
    Optional<double> value_maximum;
    Optional<double> value_step;
}

[ExistingCpp]
struct WebView::AccessibilityTextStyle {
    String font_family;
    String font_size;
    String font_weight;
    String font_style;
    String color;
    String background_color;
    String text_decoration;
}

[ExistingCpp]
struct WebView::AccessibilityTextGeometry {
    Vector<i32> character_x;
    Vector<i32> character_y;
    Vector<i32> line_break_character_offsets;
    Vector<i32> line_tops;
    Vector<i32> line_heights;
}

[ExistingCpp]
struct WebView::AccessibilityTreeDelta {
    Vector<WebView::AccessibilityNodeData> changed_nodes;
    Vector<i64> removed_ids;
}
