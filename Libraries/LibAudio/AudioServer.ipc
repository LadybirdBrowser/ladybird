#include <LibAudio/SharedAudioFrameRing.h>

endpoint AudioServer {
    init_transport(int peer_pid) => (int peer_pid)

    create_stream(u64 stream_id) =|
    destroy_stream(u64 stream_id) =|

    attach_stream_ring(u64 stream_id, Audio::SharedAudioFrameRing ring) =|
    resume_stream(u64 stream_id, u64 request_id) =|
    drain_stream(u64 stream_id, u64 request_id) =|
    discard_stream(u64 stream_id, u64 request_id) =|
    set_stream_volume(u64 stream_id, float volume) =|

    watch_devices() =|

    create_record_stream(u64 stream_id, ByteString device_id) =|
    destroy_record_stream(u64 stream_id) =|
}
