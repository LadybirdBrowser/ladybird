#include <LibHTTP/Cookie/Cookie.h>

[ExistingCpp]
enum HTTP::Cookie::SameSite : u8 {
    Default,
    None,
    Strict,
    Lax,
}

[ExistingCpp]
enum HTTP::Cookie::Source : u8 {
    NonHttp,
    Http,
}

[ExistingCpp]
enum HTTP::Cookie::SameSiteStatus : u8 {
    CrossSite,
    SameSite,
}
