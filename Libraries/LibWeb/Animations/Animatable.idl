// https://drafts.csswg.org/web-animations-1/#the-animatable-interface-mixin
interface mixin Animatable {
    [ImplementedIn=Rust] Animation animate(object? keyframes, optional (unrestricted double or KeyframeAnimationOptions) options = {});
    [ImplementedIn=Rust] sequence<Animation> getAnimations(optional GetAnimationsOptions options = {});
};

// https://drafts.csswg.org/web-animations-1/#dictdef-keyframeanimationoptions
dictionary KeyframeAnimationOptions : KeyframeEffectOptions {
    [FlyString] DOMString id = "";
    AnimationTimeline? timeline;

    // https://drafts.csswg.org/web-animations-2/#dom-keyframeanimationoptions-rangestart
    TimelineRangeValue rangeStart = "normal";
    // https://drafts.csswg.org/web-animations-2/#dom-keyframeanimationoptions-rangeend
    TimelineRangeValue rangeEnd = "normal";
};

// https://drafts.csswg.org/web-animations-1/#dictdef-getanimationsoptions
dictionary GetAnimationsOptions {
    boolean subtree = false;
    CSSOMString? pseudoElement = null;
};
