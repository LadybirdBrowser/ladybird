// https://webassembly.github.io/spec/js-api/#dictdef-exceptionoptions
dictionary ExceptionOptions {
    boolean traceStack = false;
};

// https://webassembly.github.io/spec/js-api/#exception
[LegacyNamespace=WebAssembly, Exposed=*]
interface Exception {
    [ImplementedInBindings] constructor(Tag exceptionTag, sequence<any> payload, optional ExceptionOptions options = {});
    [ImplementedInBindings] any getArg(Tag exceptionTag, [EnforceRange] unsigned long index);
    boolean is(Tag exceptionTag);
    readonly attribute (DOMString or undefined) stack;
};
