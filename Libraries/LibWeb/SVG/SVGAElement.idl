// https://svgwg.org/svg2-draft/linking.html#InterfaceSVGAElement
[Exposed=Window]
interface SVGAElement : SVGGraphicsElement {

    [SameObject] readonly attribute SVGAnimatedString target;
    [Reflect] attribute DOMString download;
    [Reflect] attribute USVString ping;
    [Reflect] attribute DOMString rel;
    [SameObject, PutForwards=value] readonly attribute DOMTokenList relList;
    // NB: hreflang and type come from HyperlinkElementUtils.

    [Reflect=referrerpolicy, Enumerated=ReferrerPolicy] attribute DOMString referrerPolicy;

};

SVGAElement includes SVGURIReference;
// NB: The spec includes HTMLHyperlinkElementUtils here, from before HTML split the URL decomposition attributes out
//     into HyperlinkElementUtils. The href and target attributes of HTMLHyperlinkElementUtils would conflict with
//     SVGURIReference's href and SVGAElement's target.
SVGAElement includes HyperlinkElementUtils;
