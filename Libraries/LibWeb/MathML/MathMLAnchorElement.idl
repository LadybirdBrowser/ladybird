// https://w3c.github.io/mathml-core/#idl-def-mathmlanchorelement
// The implementation is wrapped lazily like other DOM-backed MathML objects.
[Exposed=Window]
interface MathMLAnchorElement : MathMLElement {
    [ReflectSetter] attribute USVString href;
    [Reflect] attribute DOMString target;
};

MathMLAnchorElement includes HyperlinkElementUtils;
