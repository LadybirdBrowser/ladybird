// https://w3c.github.io/csswg-drafts/cssom-view-1/#screen
// NB: The EventTarget parent comes from https://w3c.github.io/window-management/#api-extensions-to-screen
[Exposed=Window, ImplementedIn=Rust]
interface Screen : EventTarget {
    readonly attribute long availWidth;
    readonly attribute long availHeight;
    readonly attribute long width;
    readonly attribute long height;
    readonly attribute unsigned long colorDepth;
    readonly attribute unsigned long pixelDepth;

    // Non-standard.
    readonly attribute long availLeft;
    readonly attribute long availTop;

    // https://w3c.github.io/screen-orientation/#extensions-to-the-screen-interface
    [SameObject] readonly attribute ScreenOrientation orientation;

    // https://w3c.github.io/window-management/#api-extensions-to-screen
    [SecureContext, Experimental] readonly attribute boolean isExtended;
    [SecureContext, Experimental] attribute EventHandler onchange;
};
