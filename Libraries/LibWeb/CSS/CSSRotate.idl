// https://drafts.css-houdini.org/css-typed-om-1/#cssrotate
[Exposed=(Window, Worker, PaintWorklet, LayoutWorklet), ImplementedIn=Rust]
interface CSSRotate : CSSTransformComponent {
    [ImplementedAs=construct_from_angle] constructor(CSSNumericValue angle);
    [ImplementedAs=construct_from_axis] constructor(CSSNumberish x, CSSNumberish y, CSSNumberish z, CSSNumericValue angle);
    attribute CSSNumberish x;
    attribute CSSNumberish y;
    attribute CSSNumberish z;
    attribute CSSNumericValue angle;
};
