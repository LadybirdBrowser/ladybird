// https://drafts.csswg.org/css-anchor-position-1/#om-position-try
[Exposed=Window]
interface CSSPositionTryDescriptors : CSSStyleDeclaration {
    attribute CSSOMString margin;
    [AttributeCallbackName=margin_top_regular, ImplementedAs=margin_top] attribute CSSOMString marginTop;
    [AttributeCallbackName=margin_top_dashed, ImplementedAs=margin_top] attribute CSSOMString margin-top;
    [AttributeCallbackName=margin_right_regular, ImplementedAs=margin_right] attribute CSSOMString marginRight;
    [AttributeCallbackName=margin_right_dashed, ImplementedAs=margin_right] attribute CSSOMString margin-right;
    [AttributeCallbackName=margin_bottom_regular, ImplementedAs=margin_bottom] attribute CSSOMString marginBottom;
    [AttributeCallbackName=margin_bottom_dashed, ImplementedAs=margin_bottom] attribute CSSOMString margin-bottom;
    [AttributeCallbackName=margin_left_regular, ImplementedAs=margin_left] attribute CSSOMString marginLeft;
    [AttributeCallbackName=margin_left_dashed, ImplementedAs=margin_left] attribute CSSOMString margin-left;
    [AttributeCallbackName=margin_block_regular, ImplementedAs=margin_block] attribute CSSOMString marginBlock;
    [AttributeCallbackName=margin_block_dashed, ImplementedAs=margin_block] attribute CSSOMString margin-block;
    [AttributeCallbackName=margin_block_start_regular, ImplementedAs=margin_block_start] attribute CSSOMString marginBlockStart;
    [AttributeCallbackName=margin_block_start_dashed, ImplementedAs=margin_block_start] attribute CSSOMString margin-block-start;
    [AttributeCallbackName=margin_block_end_regular, ImplementedAs=margin_block_end] attribute CSSOMString marginBlockEnd;
    [AttributeCallbackName=margin_block_end_dashed, ImplementedAs=margin_block_end] attribute CSSOMString margin-block-end;
    [AttributeCallbackName=margin_inline_regular, ImplementedAs=margin_inline] attribute CSSOMString marginInline;
    [AttributeCallbackName=margin_inline_dashed, ImplementedAs=margin_inline] attribute CSSOMString margin-inline;
    [AttributeCallbackName=margin_inline_start_regular, ImplementedAs=margin_inline_start] attribute CSSOMString marginInlineStart;
    [AttributeCallbackName=margin_inline_start_dashed, ImplementedAs=margin_inline_start] attribute CSSOMString margin-inline-start;
    [AttributeCallbackName=margin_inline_end_regular, ImplementedAs=margin_inline_end] attribute CSSOMString marginInlineEnd;
    [AttributeCallbackName=margin_inline_end_dashed, ImplementedAs=margin_inline_end] attribute CSSOMString margin-inline-end;
    attribute CSSOMString inset;
    [AttributeCallbackName=inset_block_regular, ImplementedAs=inset_block] attribute CSSOMString insetBlock;
    [AttributeCallbackName=inset_block_dashed, ImplementedAs=inset_block] attribute CSSOMString inset-block;
    [AttributeCallbackName=inset_block_start_regular, ImplementedAs=inset_block_start] attribute CSSOMString insetBlockStart;
    [AttributeCallbackName=inset_block_start_dashed, ImplementedAs=inset_block_start] attribute CSSOMString inset-block-start;
    [AttributeCallbackName=inset_block_end_regular, ImplementedAs=inset_block_end] attribute CSSOMString insetBlockEnd;
    [AttributeCallbackName=inset_block_end_dashed, ImplementedAs=inset_block_end] attribute CSSOMString inset-block-end;
    [AttributeCallbackName=inset_inline_regular, ImplementedAs=inset_inline] attribute CSSOMString insetInline;
    [AttributeCallbackName=inset_inline_dashed, ImplementedAs=inset_inline] attribute CSSOMString inset-inline;
    [AttributeCallbackName=inset_inline_start_regular, ImplementedAs=inset_inline_start] attribute CSSOMString insetInlineStart;
    [AttributeCallbackName=inset_inline_start_dashed, ImplementedAs=inset_inline_start] attribute CSSOMString inset-inline-start;
    [AttributeCallbackName=inset_inline_end_regular, ImplementedAs=inset_inline_end] attribute CSSOMString insetInlineEnd;
    [AttributeCallbackName=inset_inline_end_dashed, ImplementedAs=inset_inline_end] attribute CSSOMString inset-inline-end;
    attribute CSSOMString top;
    attribute CSSOMString left;
    attribute CSSOMString right;
    attribute CSSOMString bottom;
    attribute CSSOMString width;
    [AttributeCallbackName=min_width_regular, ImplementedAs=min_width] attribute CSSOMString minWidth;
    [AttributeCallbackName=min_width_dashed, ImplementedAs=min_width] attribute CSSOMString min-width;
    [AttributeCallbackName=max_width_regular, ImplementedAs=max_width] attribute CSSOMString maxWidth;
    [AttributeCallbackName=max_width_dashed, ImplementedAs=max_width] attribute CSSOMString max-width;
    attribute CSSOMString height;
    [AttributeCallbackName=min_height_regular, ImplementedAs=min_height] attribute CSSOMString minHeight;
    [AttributeCallbackName=min_height_dashed, ImplementedAs=min_height] attribute CSSOMString min-height;
    [AttributeCallbackName=max_height_regular, ImplementedAs=max_height] attribute CSSOMString maxHeight;
    [AttributeCallbackName=max_height_dashed, ImplementedAs=max_height] attribute CSSOMString max-height;
    [AttributeCallbackName=block_size_regular, ImplementedAs=block_size] attribute CSSOMString blockSize;
    [AttributeCallbackName=block_size_dashed, ImplementedAs=block_size] attribute CSSOMString block-size;
    [AttributeCallbackName=min_block_size_regular, ImplementedAs=min_block_size] attribute CSSOMString minBlockSize;
    [AttributeCallbackName=min_block_size_dashed, ImplementedAs=min_block_size] attribute CSSOMString min-block-size;
    [AttributeCallbackName=max_block_size_regular, ImplementedAs=max_block_size] attribute CSSOMString maxBlockSize;
    [AttributeCallbackName=max_block_size_dashed, ImplementedAs=max_block_size] attribute CSSOMString max-block-size;
    [AttributeCallbackName=inline_size_regular, ImplementedAs=inline_size] attribute CSSOMString inlineSize;
    [AttributeCallbackName=inline_size_dashed, ImplementedAs=inline_size] attribute CSSOMString inline-size;
    [AttributeCallbackName=min_inline_size_regular, ImplementedAs=min_inline_size] attribute CSSOMString minInlineSize;
    [AttributeCallbackName=min_inline_size_dashed, ImplementedAs=min_inline_size] attribute CSSOMString min-inline-size;
    [AttributeCallbackName=max_inline_size_regular, ImplementedAs=max_inline_size] attribute CSSOMString maxInlineSize;
    [AttributeCallbackName=max_inline_size_dashed, ImplementedAs=max_inline_size] attribute CSSOMString max-inline-size;
    [AttributeCallbackName=place_self_regular, ImplementedAs=place_self] attribute CSSOMString placeSelf;
    [AttributeCallbackName=place_self_dashed, ImplementedAs=place_self] attribute CSSOMString place-self;
    [AttributeCallbackName=align_self_regular, ImplementedAs=align_self] attribute CSSOMString alignSelf;
    [AttributeCallbackName=align_self_dashed, ImplementedAs=align_self] attribute CSSOMString align-self;
    [AttributeCallbackName=justify_self_regular, ImplementedAs=justify_self] attribute CSSOMString justifySelf;
    [AttributeCallbackName=justify_self_dashed, ImplementedAs=justify_self] attribute CSSOMString justify-self;
    [AttributeCallbackName=position_anchor_regular, ImplementedAs=position_anchor] attribute CSSOMString positionAnchor;
    [AttributeCallbackName=position_anchor_dashed, ImplementedAs=position_anchor] attribute CSSOMString position-anchor;
    [AttributeCallbackName=position_area_regular, ImplementedAs=position_area] attribute CSSOMString positionArea;
    [AttributeCallbackName=position_area_dashed, ImplementedAs=position_area] attribute CSSOMString position-area;
};
