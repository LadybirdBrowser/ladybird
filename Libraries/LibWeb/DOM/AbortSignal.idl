// https://dom.spec.whatwg.org/#interface-AbortSignal
[Exposed=*, ImplementedIn=Rust]
interface AbortSignal : EventTarget {
    [NeedsCallerRealm, NewObject] static AbortSignal abort(optional any reason);
    [Exposed=(Window,Worker), NeedsCallerRealm, NewObject] static AbortSignal timeout([EnforceRange] unsigned long long milliseconds);
    [NewObject] static AbortSignal _any(sequence<AbortSignal> signals);

    [ImplementedAs=get_aborted] readonly attribute boolean aborted;
    [ImplementedAs=get_reason] readonly attribute any reason;
    undefined throwIfAborted();

    attribute EventHandler onabort;
};
