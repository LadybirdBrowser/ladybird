// https://html.spec.whatwg.org/multipage/dnd.html#datatransferitemlist
[Exposed=Window, ImplementedIn=Rust]
interface DataTransferItemList {
    readonly attribute unsigned long length;
    getter DataTransferItem (unsigned long index);
    [ImplementedAs=add_string] DataTransferItem? add(DOMString data, DOMString type);
    [ImplementedAs=add_file] DataTransferItem? add(File data);
    undefined remove(unsigned long index);
    undefined clear();
};
