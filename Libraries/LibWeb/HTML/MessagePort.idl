// https://html.spec.whatwg.org/multipage/web-messaging.html#messageport
[Exposed=(Window,Worker,AudioWorklet), Transferable, ImplementedIn=Rust]
interface MessagePort : EventTarget {
    [NeedsCallerRealm, ImplementedAs=post_message] undefined postMessage(any message, sequence<object> transfer);
    [NeedsCallerRealm, ImplementedAs=post_message_with_options] undefined postMessage(any message, optional StructuredSerializeOptions options = {});
    undefined start();
    undefined close();

    // event handlers
    [ImplementedAs=set_onmessage] attribute EventHandler onmessage;
    attribute EventHandler onmessageerror;
};

dictionary StructuredSerializeOptions {
    sequence<object> transfer = [];
};
