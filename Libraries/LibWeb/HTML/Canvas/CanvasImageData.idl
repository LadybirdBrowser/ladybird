// https://html.spec.whatwg.org/multipage/canvas.html#canvasimagedata
interface mixin CanvasImageData {
    [ImplementedAs=create_image_data] ImageData createImageData([EnforceRange] long sw, [EnforceRange] long sh, optional ImageDataSettings settings = {});
    [ImplementedAs=create_image_data_from] ImageData createImageData(ImageData imageData);

    ImageData getImageData([EnforceRange] long sx, [EnforceRange] long sy, [EnforceRange] long sw, [EnforceRange] long sh, optional ImageDataSettings settings = {});

    [ImplementedAs=put_image_data] undefined putImageData(ImageData imageData, [EnforceRange] long dx, [EnforceRange] long dy);
    [ImplementedAs=put_image_data_with_dirty_rectangle] undefined putImageData(ImageData imageData, [EnforceRange] long dx, [EnforceRange] long dy, [EnforceRange] long dirtyX, [EnforceRange] long dirtyY, [EnforceRange] long dirtyWidth, [EnforceRange] long dirtyHeight);
};
