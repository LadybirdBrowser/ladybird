typedef (File or USVString) FormDataEntryValue;

// https://xhr.spec.whatwg.org/#interface-formdata
[Exposed=(Window,Worker), ImplementedIn=Rust]
interface FormData {
    constructor(optional HTMLFormElement form, optional HTMLElement? submitter = null);

    [ImplementedAs=append] undefined append(USVString name, USVString value);
    [ImplementedAs=append_blob] undefined append(USVString name, Blob blobValue, optional USVString filename);
    undefined delete(USVString name);
    FormDataEntryValue? get(USVString name);
    sequence<FormDataEntryValue> getAll(USVString name);
    boolean has(USVString name);
    [ImplementedAs=set] undefined set(USVString name, USVString value);
    [ImplementedAs=set_blob] undefined set(USVString name, Blob blobValue, optional USVString filename);
    iterable<USVString, FormDataEntryValue>;
};
