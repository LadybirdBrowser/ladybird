#include <LibMediaCodecs/DecoderError.h>
#include <LibMediaCodecs/VideoFrame.h>
#include <LibMediaCodecs/VideoFrameMetadata.h>
#include <LibMediaCodecs/VideoSurface.h>

endpoint VideoDecoderClient
{
    frame_decoded(u64 decoder_id, u32 generation, u64 frame_id, Media::VideoFrameMetadata metadata, Media::VideoFramePixels pixels) =|
    coded_frame_consumed(u64 decoder_id) =|
    decoder_failed(u64 decoder_id, u32 generation, Media::DecoderError error) =|
    decoder_drained(u64 decoder_id, u32 generation) =|
    // Every slot the decoder can output into is held by the client, so it waits for one to be released. Anything the
    // decoder reports after this means it is no longer waiting.
    decoder_waiting_for_storage(u64 decoder_id, u32 generation) =|
}
