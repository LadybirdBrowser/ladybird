#include <LibMedia/Audio/AudioDevices.h>
#include <LibMedia/Audio/SampleSpecification.h>
#include <LibMedia/Audio/SharedAudioFrameRing.h>

endpoint AudioClient {
    stream_created(u64 stream_id, Audio::SampleSpecification sample_specification, u32 device_latency_ms) =|
    stream_creation_failed(u64 stream_id) =|
    stream_request_completed(u64 stream_id, u64 request_id) =|

    devices_changed(Vector<Audio::AudioDeviceInfo> inputs, Vector<Audio::AudioDeviceInfo> outputs) =|

    record_stream_created(u64 stream_id, Audio::SharedAudioFrameRing ring) =|
    record_stream_creation_failed(u64 stream_id) =|
}
