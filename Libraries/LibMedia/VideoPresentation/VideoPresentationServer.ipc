#include <AK/Time.h>
#include <LibMedia/PipelineStatus.h>
#include <LibMedia/VideoFramePool.h>
#include <LibMedia/VideoSinkHandle.h>

endpoint VideoPresentationServer {
    create_video_edge(Media::VideoSinkHandle video_sink_handle, u64 edge_id) =|
    release_video_edge(u64 edge_id) =|

    request_start(u64 edge_id) =|
    request_seek(u64 edge_id, AK::Duration timestamp) =|
    release_slot(u64 edge_id, Media::VideoFramePoolID pool_id, u32 slot_index) =|
    notify_space_available(u64 edge_id) =|

    notify_sink_status(u64 edge_id, Media::PipelineStatus status, u32 requested_seek_id) =|
    notify_sink_resize(u64 edge_id, u32 width, u32 height) =|
    set_sink_ticking(u64 edge_id, bool ticking) =|
}
