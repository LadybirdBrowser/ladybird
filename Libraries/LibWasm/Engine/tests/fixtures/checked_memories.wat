;; Accesses that cannot rely on the guard pages of memory 0: another memory, and a memory64.
(module
  (memory $small 1)
  (memory $other 1)
  (memory $wide i64 1)
  (func (export "store_other") (param i32 i32)
    (i32.store $other (local.get 0) (local.get 1)))
  (func (export "load_other") (param i32) (result i32)
    (i32.load $other (local.get 0)))
  (func (export "load_small") (param i32) (result i32)
    (i32.load $small (local.get 0)))
  (func (export "store_wide") (param i64 i64)
    (i64.store $wide offset=8 (local.get 0) (local.get 1)))
  (func (export "load_wide") (param i64) (result i64)
    (i64.load $wide offset=8 (local.get 0)))
  (func (export "splat_other") (param i32) (result i32)
    (i32x4.extract_lane 3 (v128.load32_splat $other (local.get 0))))
  (func (export "lane_wide") (param i64) (result i32)
    (i32x4.extract_lane 2 (v128.load32_lane $wide 2 (local.get 0) (v128.const i32x4 1 2 3 4))))
  (func (export "grow_wide") (param i64) (result i64)
    (memory.grow $wide (local.get 0)))
)
