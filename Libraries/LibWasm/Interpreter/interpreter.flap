# Conversions.

# Truncate a float to an integer, trapping unless the result is in the open interval (lower, upper).
inline fn checked_truncation(value: f64, lower: u64, upper: u64) -> f64 {
    guard value == value else @cold {
        trap(TRAP_INVALID_CONVERSION);
    };
    let lower_bound = f64_from_bits(lower);
    let upper_bound = f64_from_bits(upper);
    guard value > lower_bound else @cold {
        trap(TRAP_INTEGER_OVERFLOW);
    };
    guard value < upper_bound else @cold {
        trap(TRAP_INTEGER_OVERFLOW);
    };
    value
}

# Truncate a non-negative float below 2^64 to an unsigned 64-bit integer.
inline fn truncate_unsigned64(value: f64) -> u64 {
    let two_to_63 = f64_from_bits(0x43e0000000000000);
    let mut truncated = truncate_f64_to_s64(value);
    if value >= two_to_63 @cold {
        let reduced = value - two_to_63;
        let low = truncate_f64_to_s64(reduced);
        truncated = low ^ 0x8000000000000000;
    }
    truncated
}

# Truncate a float with saturation: NaN becomes zero, and values out of range the nearest bound. The result is in
# range if the value is in the open interval (lower, upper).
inline fn saturating_truncation(value: f64, lower: u64, upper: u64, minimum: u64, maximum: u64, unsigned: u64) -> u64 {
    let mut truncated: u64 = minimum;
    let lower_bound = f64_from_bits(lower);
    if value > lower_bound {
        truncated = maximum;
        let upper_bound = f64_from_bits(upper);
        if value < upper_bound {
            if unsigned != 0 {
                truncated = truncate_unsigned64(value);
            } else {
                truncated = truncate_f64_to_s64(value);
            }
        }
    }
    if value != value {
        truncated = 0;
    }
    truncated
}

