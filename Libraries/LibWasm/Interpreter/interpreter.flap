handler V128Bitselect() @opcode(0xfd, 0x52) {
    let [_, offset] = prefixed_immediates();
    let top: u64 = vsp;
    let mut mask: v128;
    load128(mask, [top, 0]);
    let mut second: v128;
    load128(second, [top, 16]);
    let mut first: v128;
    load128(first, [top, 32]);
    let next = top + 32;
    vsp = next;
    let chosen_first = v128_and(first, mask);
    let chosen_second = v128_andnot(mask, second);
    let value = v128_or(chosen_first, chosen_second);
    vector_result(value, offset);
}

