    let picked_a = v128_shuffle_i8(a, mask_a);
    let picked_b = v128_shuffle_i8(b, mask_b);
    let value = v128_or(picked_a, picked_b);
    vector_result(value, offset + 16);
}

handler I8x16Swizzle() @opcode(0xfd, 0xe) {
    let [_, offset] = prefixed_immediates();
    let [a, selectors] = binary_vectors();
    # Selectors of 16 and more pick zero, which they do once their top bit is set.
    let mask = v128_add_sat_u_i8(selectors, splat_i8(0x70));
    let value = v128_shuffle_i8(a, mask);
    vector_result(value, offset);
}

