# Bulk memory and tables. The operands are checked against the bounds before anything is written, so these do not
# rely on guard pages.

inline fn three_operands() -> (u64, u64, u64) {
    let top: u64 = vsp;
    let slots: Sequence<u64> = alias(top);
    let third = slots[0];
    let second = slots[1];
    let first = slots[2];
    let next = top + 24;
    vsp = next;
    (first, second, third)
}

# Trap unless `count` items from `start` are within `size`. The operands of memory64 and table64 operations are 64-bit,
# so the end can wrap around.
inline fn check_range(start: u64, count: u64, size: u64, code: u64) {
    let end = start + count;
    guard end >= start else @cold {
        trap(code);
    };
    guard end <= size else @cold {
        trap(code);
    };
}

inline fn segment_at(segments_offset: u64, index: u64) -> u64 {
    let instance_pointer = instance();
    let mut segments: u64;
    load64(segments, [instance_pointer, segments_offset]);
    segments + (index << 4)
}

# Copy `count` bytes from `source` to `destination`, which may overlap.
inline fn copy_bytes(destination: u64, source: u64, count: u64) {
    let to: Sequence<u8> = alias(destination);
    let from: Sequence<u8> = alias(source);
    let mut index: u64 = 0;
    if destination <= source {
        while index < count {
            let byte = from[index];
            to[index] = byte;
            index = index + 1;
        }
    } else {
        index = count;
        while index != 0 {
            index = index - 1;
            let byte = from[index];
            to[index] = byte;
        }
    }
}

# Copy `count` table elements from `source` to `destination`, which may overlap.
inline fn copy_elements(destination: u64, source: u64, count: u64) {
    let to: Sequence<u64> = alias(destination);
    let from: Sequence<u64> = alias(source);
    let mut index: u64 = 0;
    if destination <= source {
        while index < count {
            to[index] = from[index];
            index = index + 1;
        }
    } else {
        index = count;
        while index != 0 {
            index = index - 1;
            to[index] = from[index];
        }
    }
}

handler MemoryInit() @opcode(0xfc, 8) {
    let [bytes, offset] = prefixed_immediates();
    let [data_index, data_length] = read_leb(bytes);
    let start: u64 = alias(bytes);
    let memory_bytes: Sequence<u8> = alias(start + data_length);
    let [memory_index, memory_length] = read_leb(memory_bytes);
    let [destination, source, count] = three_operands();
    let segment = segment_at(INSTANCE_DATA_SEGMENTS, data_index);
    let mut segment_length: u64;
    load64(segment_length, [segment, SEGMENT_LENGTH]);
    check_range(source, count, segment_length, TRAP_MEMORY_OUT_OF_BOUNDS);
    let memory = memory_at(memory_index);
    let mut memory_size: u64;
    load64(memory_size, [memory, MEMORY_SIZE]);
    check_range(destination, count, memory_size, TRAP_MEMORY_OUT_OF_BOUNDS);
    let mut contents: u64;
    load64(contents, [segment, SEGMENT_CONTENTS]);
    let mut base: u64;
    load64(base, [memory, MEMORY_BASE]);
    copy_bytes(base + destination, contents + source, count);
    advance(offset + data_length + memory_length);
}

handler DataDrop() @opcode(0xfc, 9) {
    let [bytes, offset] = prefixed_immediates();
    let [data_index, data_length] = read_leb(bytes);
