handler I8x16Popcnt() @opcode(0xfd, 0x62) {
    let [_, offset] = prefixed_immediates();
    let top: u64 = vsp;
    let slots: Sequence<u64> = alias(top);
    let low = slots[0];
    let high = slots[1];
    let low_1 = low - ((low >> 1) & 0x5555555555555555);
    let low_2 = (low_1 & 0x3333333333333333) + ((low_1 >> 2) & 0x3333333333333333);
    let low_3 = (low_2 + (low_2 >> 4)) & 0x0f0f0f0f0f0f0f0f;
    let high_1 = high - ((high >> 1) & 0x5555555555555555);
    let high_2 = (high_1 & 0x3333333333333333) + ((high_1 >> 2) & 0x3333333333333333);
    let high_3 = (high_2 + (high_2 >> 4)) & 0x0f0f0f0f0f0f0f0f;
    slots[0] = low_3;
    slots[1] = high_3;
    advance(offset);
}

