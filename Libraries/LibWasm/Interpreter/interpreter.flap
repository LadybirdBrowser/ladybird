        let replaced = atomic_cmpxchg16([address, 0], old, updated);
        if replaced == old {
            done = 1;
        } else {
            old = replaced;
        }
    }
    push(old);
    advance(length);
}

handler I64AtomicRmw32XorU() @opcode(0xfe, 0x40) {
    let [address_operand, raw_value] = store_operands();
    let [_, address, length] = atomic_access(address_operand, 4);
    let mask = width_mask(4);
    let value = raw_value & mask;
    # Retry until no other thread changed the location between the read and the exchange.
    let mut old: u64;
    load32(old, [address, 0]);
    let mut done: u64 = 0;
    while done == 0 {
        let updated = (old ^ value) & mask;
        let replaced = atomic_cmpxchg32([address, 0], old, updated);
        if replaced == old {
            done = 1;
        } else {
            old = replaced;
        }
    }
    push(old);
    advance(length);
}

