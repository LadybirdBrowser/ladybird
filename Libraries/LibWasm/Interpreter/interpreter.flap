# Floats are kept as their bits. f32 comparisons and roundings go through f64, which holds every f32 exactly.

inline fn f32_value(bits: u64) -> f64 {
    let narrow = u32(bits);
    let single = f32_from_bits(narrow);
    promote_f32(single)
}

inline fn f32_operand(bits: u64) -> f32 {
    let narrow = u32(bits);
    f32_from_bits(narrow)
}

inline fn f64_value(bits: u64) -> f64 {
    f64_from_bits(bits)
}

inline fn f32_result(value: f32) {
    let bits = f32_to_bits(value);
    result32(bits);
}

inline fn f64_result(value: f64) {
    let bits = f64_to_bits(value);
    result(bits);
}


