# SIMD (the 0xFD prefix). A v128 takes two slots on the operand stack, its low half in the lower one, so a vector on
# top of the stack is a 16-byte value at vsp. Lane operations that have no vector instruction work on that memory
# directly.

handler PrefixFD() @opcode(0xfd) {
    let [sub_opcode, _] = read_leb(immediates());
    dispatch_secondary(0xfd, sub_opcode);
}

inline fn top_vector() -> v128 {
    let top: u64 = vsp;
    let mut value: v128;
    load128(value, [top, 0]);
    value
}

inline fn set_top_vector(value: v128) {
    let top: u64 = vsp;
    store128([top, 0], value);
}

# The two vector operands of a binary instruction, whose result replaces the first.
inline fn binary_vectors() -> (v128, v128) {
    let top: u64 = vsp;
    let mut rhs: v128;
    load128(rhs, [top, 0]);
    let mut lhs: v128;
    load128(lhs, [top, 16]);
    let next = top + 16;
    vsp = next;
    (lhs, rhs)
}

inline fn vector_result(value: v128, offset: u64) {
    set_top_vector(value);
    advance(offset);
}

inline fn splat_u64(value: u64) -> v128 {
    v128_from_u64x2(value, value)
}

inline fn splat_i8(value: u64) -> v128 {
    let byte = value & 0xff;
    let wide = byte * 0x0101010101010101;
    splat_u64(wide)
}

inline fn splat_i16(value: u64) -> v128 {
    let half = value & 0xffff;
    let wide = half * 0x0001000100010001;
    splat_u64(wide)
}

inline fn splat_i32(value: u64) -> v128 {
    let word = value & 0xffffffff;
    let wide = word * 0x0000000100000001;
    splat_u64(wide)
}

inline fn zero_vector() -> v128 {
    v128_from_u64x2(0, 0)
}

inline fn ones_vector() -> v128 {
    v128_from_u64x2(0xffffffffffffffff, 0xffffffffffffffff)
}

inline fn not_vector(value: v128) -> v128 {
    v128_xor(value, ones_vector())
}

# The shift count of a vector shift, modulo the lane width, as a vector whose low 64 bits hold it.
inline fn shift_count(mask: u64) -> v128 {
    let count = pop();
    let masked = count & mask;
    v128_from_u64x2(masked, 0)
}

# Replace the vector on top of the stack with two 64-bit halves.
inline fn set_top_halves(low: u64, high: u64) {
    let top: u64 = vsp;
    store64([top, 0], low);
    store64([top, 8], high);
}

# Push a vector given as two 64-bit halves, replacing `popped` slots.
inline fn replace_with_halves(popped: u64, low: u64, high: u64) {
    let top: u64 = vsp;
    let next = top + (popped << 3) - 16;
    vsp = next;
    store64([next, 0], low);
    store64([next, 8], high);
}

# The address of a SIMD memory access to memory 0, whose memory argument starts `offset` bytes after the instruction,
# and the length of the instruction.
inline fn simd_memory_address(address_operand: u64, offset: u64) -> (u64, u64) {
    let current: u64 = ip;
    let alignment_bytes: Sequence<u8> = alias(current + offset);
    let alignment_length = leb_length(alignment_bytes);
    let offset_bytes: Sequence<u8> = alias(current + offset + alignment_length);
    let [displacement, displacement_length] = read_leb(offset_bytes);
    let index: u64 = alias(u32(address_operand));
    let base: u64 = memory_base;
    let address = base + index + displacement;
    (address, offset + alignment_length + displacement_length)
}

