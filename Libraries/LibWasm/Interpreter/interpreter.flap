# The memory, address of a `size`-byte atomic access, and length of the instruction.
inline fn atomic_access(address_operand: u64, size: u64) -> (u64, u64, u64) {
    let [bytes, prefix_length] = prefixed_immediates();
    # The flags may take more than one byte; their bit 6 says a memory index follows.
    let [flags, alignment_length] = read_leb(bytes);
    let start: u64 = alias(bytes);
    let mut memory_index: u64 = 0;
    let mut index_length: u64 = 0;
    let has_memory_index = flags & 0x40;
    if has_memory_index != 0 {
        let index_bytes: Sequence<u8> = alias(start + alignment_length);
        let [decoded_index, decoded_length] = read_leb(index_bytes);
        memory_index = decoded_index;
        index_length = decoded_length;
    }
    let offset_bytes: Sequence<u8> = alias(start + alignment_length + index_length);
    let [offset, offset_length] = read_leb(offset_bytes);
    let memory = memory_at(memory_index);
    let effective = address_operand + offset;
    guard effective >= address_operand else @cold {
        trap(TRAP_MEMORY_OUT_OF_BOUNDS);
    };
    let address = checked_memory_address(memory, effective, size);
    let misalignment = effective & (size - 1);
    guard misalignment == 0 else @cold {
        trap(TRAP_UNALIGNED_ATOMIC);
    };
    (memory, address, prefix_length + alignment_length + index_length + offset_length)
}

inline fn width_mask(size: u64) -> u64 {
    let mut mask: u64 = 0xffffffffffffffff;
    if size == 1 {
        mask = 0xff;
    }
    if size == 2 {
        mask = 0xffff;
    }
    if size == 4 {
        mask = 0xffffffff;
    }
    mask
}

handler AtomicNotify() @opcode(0xfe, 0x0) {
    let count = pop();
    let address_operand = unary_operand();
    let [memory, address, length] = atomic_access(address_operand, 4);
    let mut shared: u64;
    load64(shared, [memory, MEMORY_SHARED]);
    let mut woken: u64 = 0;
    # Only a shared memory can have threads waiting on it.
    if shared != 0 {
        let context_pointer = context();
        store64([context_pointer, CONTEXT_ARGUMENTS], address);
        store64([context_pointer, CONTEXT_ARGUMENT_1], count);
        woken = call_helper(wasm_runtime_notify, context_pointer);
    }
    set_top(woken);
    advance(length);
}

inline fn atomic_wait(size: u64) {
    let timeout = pop();
    let expected = pop();
    let address_operand = unary_operand();
    let [memory, address, length] = atomic_access(address_operand, size);
    let mut shared: u64;
    load64(shared, [memory, MEMORY_SHARED]);
    guard shared != 0 else @cold {
        trap(TRAP_EXPECTED_SHARED_MEMORY);
    };
    let context_pointer = context();
    store64([context_pointer, CONTEXT_ARGUMENTS], address);
    store64([context_pointer, CONTEXT_ARGUMENT_1], expected);
    store64([context_pointer, CONTEXT_ARGUMENT_2], timeout);
    store64([context_pointer, CONTEXT_ARGUMENT_3], size);
    let result: u64 = call_helper(wasm_runtime_wait, context_pointer);
    guard result != WAIT_CANNOT_BLOCK else @cold {
        trap(TRAP_RUNTIME);
    };
    set_top(result);
    advance(length);
}

