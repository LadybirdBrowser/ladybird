handler I32x4TruncSatF32x4S() @opcode(0xfd, 0xf8) {
    let [_, offset] = prefixed_immediates();
    let top: u64 = vsp;
    let mut bits0: u64;
    load32(bits0, [top, 0]);
    let value0 = f32_value(bits0);
    let truncated0 = saturating_truncation(value0, 0xc1e0000000200000, 0x41e0000000000000, 0x80000000, 0x7fffffff, 0);
    let mut bits1: u64;
    load32(bits1, [top, 4]);
    let value1 = f32_value(bits1);
    let truncated1 = saturating_truncation(value1, 0xc1e0000000200000, 0x41e0000000000000, 0x80000000, 0x7fffffff, 0);
    let mut bits2: u64;
    load32(bits2, [top, 8]);
    let value2 = f32_value(bits2);
    let truncated2 = saturating_truncation(value2, 0xc1e0000000200000, 0x41e0000000000000, 0x80000000, 0x7fffffff, 0);
    let mut bits3: u64;
    load32(bits3, [top, 12]);
    let value3 = f32_value(bits3);
    let truncated3 = saturating_truncation(value3, 0xc1e0000000200000, 0x41e0000000000000, 0x80000000, 0x7fffffff, 0);
    store32([top, 0], truncated0);
    store32([top, 4], truncated1);
    store32([top, 8], truncated2);
    store32([top, 12], truncated3);
    advance(offset);
}

