# The two LEB128 immediates of a GC instruction, and the length of the instruction.
inline fn two_immediates() -> (u64, u64, u64) {
    let [bytes, offset] = prefixed_immediates();
    let [first, first_length] = read_leb(bytes);
    let start: u64 = alias(bytes);
    let second_bytes: Sequence<u8> = alias(start + first_length);
    let [second, second_length] = read_leb(second_bytes);
    (first, second, offset + first_length + second_length)
}

inline fn one_immediate() -> (u64, u64) {
    let [bytes, offset] = prefixed_immediates();
    let [value, length] = read_leb(bytes);
    (value, offset + length)
}

