handler I8x16Splat() @opcode(0xfd, 0xf) {
    let [_, offset] = prefixed_immediates();
    let lane = unary_operand();
    let masked = lane & 0xff;
    let wide = masked * 0x0101010101010101;
    replace_with_halves(1, wide, wide);
    advance(offset);
}

