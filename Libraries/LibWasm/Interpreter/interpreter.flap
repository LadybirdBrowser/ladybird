inline fn check_array_range(start: u64, count: u64, length: u64) {
    let end = start + count;
    guard end >= start else @cold {
        trap(TRAP_ARRAY_OUT_OF_BOUNDS);
    };
    guard end <= length else @cold {
        trap(TRAP_ARRAY_OUT_OF_BOUNDS);
    };
}

inline fn element_address(array: u64, index: u64, kind: u64) -> u64 {
    let size = storage_size(kind);
