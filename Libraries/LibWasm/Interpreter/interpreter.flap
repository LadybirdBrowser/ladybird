handler I8x16ExtractLaneS() @opcode(0xfd, 0x15) {
    let [bytes, offset] = prefixed_immediates();
    let lane: u64 = alias(bytes[0]);
    let top: u64 = vsp;
    let lane_address = top + (lane * 1);
    let mut value: u64;
    load8s(value, [lane_address, 0]);
    let narrow = u32(value);
    let result: u64 = alias(narrow);
    let next = top + 8;
    vsp = next;
    let slots: Sequence<u64> = alias(next);
    slots[0] = result;
    advance(offset + 1);
}

