# br_on_cast and br_on_cast_fail: `0xFB sub flags label source target`. The branch is taken when the cast's outcome
# is `taken_on`.
inline fn branch_on_cast(taken_on: u64) {
    let [bytes, offset] = prefixed_immediates();
    let flags: u64 = alias(bytes[0]);
    let start: u64 = alias(bytes);
    let label_bytes: Sequence<u8> = alias(start + 1);
    let label_length = leb_length(label_bytes);
    let source_bytes: Sequence<u8> = alias(start + 1 + label_length);
    let source_length = heap_type_length(source_bytes);
    let target_bytes: Sequence<u8> = alias(start + 1 + label_length + source_length);
    let reference = unary_operand();
    let nullable = (flags >> 1) & 1;
    let [matches, target_length] = reference_matches(reference, target_bytes, nullable);
    if matches == taken_on {
        branch();
    }
    skip_entry_and_advance(offset + 1 + label_length + source_length + target_length);
}

inline fn heap_type_length(bytes: Sequence<u8>) -> u64 {
    let first: u64 = alias(bytes[0]);
    let mut length: u64 = 1;
    let biased = first - 0x40;
    if biased >= 0x40 {
        length = leb_length(bytes);
    }
    length
}

