handler I64x2ExtmulLowI32x4S() @opcode(0xfd, 0xdc) {
    let [_, offset] = prefixed_immediates();
    let top: u64 = vsp;
    let mut b0: u64;
    load32(b0, [top, 0]);
    let mut b1: u64;
    load32(b1, [top, 4]);
    let mut a0: u64;
    load32(a0, [top, 16]);
    let mut a1: u64;
    load32(a1, [top, 20]);
    let extended_a0 = sign_extend_32(a0);
    let product0 = extended_a0 * sign_extend_32(b0);
    let extended_a1 = sign_extend_32(a1);
    let product1 = extended_a1 * sign_extend_32(b1);
    let next = top + 16;
    vsp = next;
    set_top_halves(product0, product1);
    advance(offset);
}

