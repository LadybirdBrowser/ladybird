handler F32x4Min() @opcode(0xfd, 0xe8) {
    let [_, offset] = prefixed_immediates();
    let [a, b] = binary_vectors();
    # Both orders, so that a NaN or -0 in either operand makes it into the result, and NaN lanes canonical.
    let first = v128_min_f32(a, b);
    let second = v128_min_f32(b, a);
    let merged = v128_or(first, second);
    let nan_lanes = v128_unord_f32(merged, merged);
    let with_nans = v128_or(merged, nan_lanes);
    let payload = v128_shr_u_i32(nan_lanes, v128_from_u64x2(10, 0));
    let value = v128_andnot(payload, with_nans);
    vector_result(value, offset);
}

