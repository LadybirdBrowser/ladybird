# References. A reference is the address of what it refers to, or zero for null.

handler RefNull() @opcode(0xd0) {
    let length = leb_length(immediates());
    push(0);
    advance(length + 1);
}

handler RefIsNull() @opcode(0xd1) {
    let operand = unary_operand();
    let mut value: u64 = 0;
    if operand == 0 {
        value = 1;
    }
    result(value);
}

handler RefFunc() @opcode(0xd2) {
    let [function_index, length] = read_leb(immediates());
    let function = function_at(function_index);
    push(function);
    advance(length + 1);
}

handler RefEq() @opcode(0xd3) {
    let [lhs, rhs] = binary_operands();
    let mut value: u64 = 0;
    if lhs == rhs {
        value = 1;
    }
    result(value);
}

handler RefAsNonNull() @opcode(0xd4) {
    let operand = unary_operand();
    guard operand != 0 else @cold {
        trap(TRAP_NULL_REFERENCE);
    };
    dispatch_next;
}

handler BrOnNull() @opcode(0xd5) {
    let operand = unary_operand();
    if operand == 0 {
        drop_slots(1);
        branch();
    }
    let length = leb_length(immediates());
    skip_entry_and_advance(length + 1);
}

handler BrOnNonNull() @opcode(0xd6) {
    let operand = unary_operand();
    if operand != 0 {
        branch();
    }
    drop_slots(1);
    let length = leb_length(immediates());
    skip_entry_and_advance(length + 1);
}

# The 0xFC prefix: saturating truncations, bulk memory, and table instructions.

handler PrefixFC() @opcode(0xfc) {
    let [sub_opcode, _] = read_leb(immediates());
    dispatch_secondary(0xfc, sub_opcode);
}

inline fn prefixed_advance(offset: u64) {
    advance(offset);
}

handler I32TruncSatF32S() @opcode(0xfc, 0) {
    let [_, offset] = prefixed_immediates();
