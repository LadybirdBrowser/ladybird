handler F32x4ConvertI32x4U() @opcode(0xfd, 0xfb) {
    let [_, offset] = prefixed_immediates();
    let top: u64 = vsp;
    let mut lane0: u64;
    load32(lane0, [top, 0]);
    let converted0 = s64_to_f32(lane0);
    let bits0 = f32_to_bits(converted0);
    let mut lane1: u64;
    load32(lane1, [top, 4]);
    let converted1 = s64_to_f32(lane1);
    let bits1 = f32_to_bits(converted1);
    let mut lane2: u64;
    load32(lane2, [top, 8]);
    let converted2 = s64_to_f32(lane2);
    let bits2 = f32_to_bits(converted2);
    let mut lane3: u64;
    load32(lane3, [top, 12]);
    let converted3 = s64_to_f32(lane3);
    let bits3 = f32_to_bits(converted3);
    store32([top, 0], bits0);
    store32([top, 4], bits1);
    store32([top, 8], bits2);
    store32([top, 12], bits3);
    advance(offset);
}

handler F64x2ConvertLowI32x4U() @opcode(0xfd, 0xff) {
    let [_, offset] = prefixed_immediates();
    let top: u64 = vsp;
    let mut lane0: u64;
    load32(lane0, [top, 0]);
    let mut lane1: u64;
    load32(lane1, [top, 4]);
    let converted0 = s64_to_f64(lane0);
    let converted1 = s64_to_f64(lane1);
    let bits0 = f64_to_bits(converted0);
    let bits1 = f64_to_bits(converted1);
    set_top_halves(bits0, bits1);
    advance(offset);
}

handler I16x8RelaxedDotI8x16I7x16S() @opcode(0xfd, 0x112) {
    let [_, offset] = prefixed_immediates();
    let [a, b] = binary_vectors();
    let value = v128_madd_u8_s8(b, a);
    vector_result(value, offset);
}

handler I32x4RelaxedDotI8x16I7x16AddS() @opcode(0xfd, 0x113) {
    let [_, offset] = prefixed_immediates();
    let top: u64 = vsp;
    let mut addend: v128;
    load128(addend, [top, 0]);
    let mut b: v128;
    load128(b, [top, 16]);
    let mut a: v128;
    load128(a, [top, 32]);
    let next = top + 32;
    vsp = next;
    let pairs = v128_madd_u8_s8(b, a);
    let quads = v128_madd_i16(pairs, splat_i16(1));
    let value = v128_add_i32(quads, addend);
    vector_result(value, offset);
}

# Bounds-checked SIMD accesses, for other memories and for memory64 (quickening rule 1).

handler CheckedV128Load() @opcode(0xff, 0x80) {
    let address_operand = pop();
    let [address, length] = checked_access_address(address_operand, 16, 0);
    let mut value: v128;
    load128(value, [address, 0]);
    let top: u64 = vsp;
    let next = top - 16;
    vsp = next;
    store128([next, 0], value);
    advance(length);
}

handler CheckedV128LoadIndexed() @opcode(0xff, 0xa0) {
    let address_operand = pop();
    let [address, length] = checked_access_address(address_operand, 16, 1);
    let mut value: v128;
    load128(value, [address, 0]);
    let top: u64 = vsp;
    let next = top - 16;
    vsp = next;
    store128([next, 0], value);
    advance(length);
}

handler CheckedV128Load8x8S() @opcode(0xff, 0x81) {
    let address_operand = pop();
    let [address, length] = checked_access_address(address_operand, 8, 0);
    let mut half: u64;
    load64(half, [address, 0]);
    let narrow = v128_from_u64x2(half, 0);
    let value = v128_extend_low_s_i8(narrow);
    let top: u64 = vsp;
    let next = top - 16;
    vsp = next;
    store128([next, 0], value);
    advance(length);
}

