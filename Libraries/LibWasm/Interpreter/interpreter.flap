handler DropV128() @opcode(0xf9) {
    drop_slots(2);
    dispatch_next;
}

handler SelectV128() @opcode(0xfa) {
    let condition = pop32();
    let [first, second] = binary_vectors();
    if condition == 0 {
        set_top_vector(second);
    }
    dispatch_next;
}

# The GC proposal (the 0xFB prefix). See gc.rs for how references and objects are encoded.

handler PrefixFB() @opcode(0xfb) {
    let [sub_opcode, _] = read_leb(immediates());
    dispatch_secondary(0xfb, sub_opcode);
}

# The runtime type of the module's type `type_index`.
inline fn rtt_of_type(type_index: u64) -> u64 {
    let instance_pointer = instance();
    let mut identities_pointer: u64;
    load64(identities_pointer, [instance_pointer, INSTANCE_TYPE_IDENTITIES]);
    let identities: Sequence<u32> = alias(identities_pointer);
    let identity: u64 = alias(identities[type_index]);
    rtt_of_identity(identity)
}

inline fn rtt_of_identity(identity: u64) -> u64 {
    let context_pointer = context();
    let mut rtts_pointer: u64;
    load64(rtts_pointer, [context_pointer, CONTEXT_RTTS]);
    let rtts: Sequence<u64> = alias(rtts_pointer);
    rtts[identity]
}

inline fn identity_of_type(type_index: u64) -> u64 {
    let instance_pointer = instance();
    let mut identities_pointer: u64;
    load64(identities_pointer, [instance_pointer, INSTANCE_TYPE_IDENTITIES]);
    let identities: Sequence<u32> = alias(identities_pointer);
    let identity: u64 = alias(identities[type_index]);
    identity
}

# Allocate an object whose type is `rtt`, with `size` bytes of zeroed data and, for an array, `length` elements.
inline fn allocate_object(rtt: u64, size: u64, length: u64) -> u64 {
    let context_pointer = context();
    store64([context_pointer, CONTEXT_ARGUMENTS], rtt);
    store64([context_pointer, CONTEXT_ARGUMENT_1], size);
    store64([context_pointer, CONTEXT_ARGUMENT_2], length);
    let object: u64 = call_helper(wasm_runtime_allocate, context_pointer);
    guard object != 0 else @cold {
        trap(TRAP_RUNTIME);
    };
    object
}

# Whether `subtype` is the runtime type `identity` or one of its subtypes.
inline fn rtt_is_subtype(subtype: u64, identity: u64) -> u64 {
    let target = rtt_of_identity(identity);
    let mut target_depth: u64;
    load32(target_depth, [target, RTT_DEPTH]);
    let mut depth: u64;
    load32(depth, [subtype, RTT_DEPTH]);
    let mut result: u64 = 0;
    if depth >= target_depth {
        let mut display_pointer: u64;
        load64(display_pointer, [subtype, RTT_DISPLAY]);
        let display: Sequence<u32> = alias(display_pointer);
        let ancestor: u64 = alias(display[target_depth]);
        if ancestor == identity {
            result = 1;
        }
    }
    result
}

# A field value as it is stored: packed fields keep only their bits.
inline fn packed_value(value: u64, kind: u64) -> u64 {
    let mut stored = value;
    if kind == STORAGE_I8 {
        stored = value & 0xff;
    }
    if kind == STORAGE_I16 {
        stored = value & 0xffff;
    }
    stored
}

# A packed value sign-extended to an i32.
inline fn sign_extend_packed(value: u64, kind: u64) -> u64 {
    let mut shift: u64 = 48;
    if kind == STORAGE_I8 {
        shift = 56;
    }
    let moved = value << shift;
    let signed = signed64(moved);
    let extended = signed >> signed64(shift);
    let narrow = u32(extended);
    let result: u64 = alias(narrow);
    result
}

# Push the value of the field or element at `address`, whose storage is `kind`, replacing `popped` slots.
inline fn push_stored(address: u64, kind: u64, popped: u64) {
    let mut low: u64;
    load64(low, [address, 0]);
    if kind == STORAGE_V128 {
        let mut high: u64;
        load64(high, [address, 8]);
        replace_with_halves(popped, low, high);
    } else {
        let top: u64 = vsp;
        let next = top + (popped << 3) - 8;
        vsp = next;
        store64([next, 0], low);
    }
}

# Store the value on top of the operand stack into the field or element at `address`, whose storage is `kind`.
inline fn pop_into_storage(address: u64, kind: u64) {
    let low = pop();
    if kind == STORAGE_V128 {
        let high = pop();
        store64([address, 0], low);
        store64([address, 8], high);
    } else {
        let stored = packed_value(low, kind);
        store64([address, 0], stored);
    }
}

# The value of a v128 or other element, as two halves.
inline fn pop_storage_value(kind: u64) -> (u64, u64) {
    let low = pop();
    let mut high: u64 = 0;
    if kind == STORAGE_V128 {
        high = pop();
    }
    let stored = packed_value(low, kind);
    (stored, high)
}

inline fn store_storage_value(address: u64, kind: u64, low: u64, high: u64) {
    store64([address, 0], low);
    if kind == STORAGE_V128 {
        store64([address, 8], high);
    }
}

inline fn storage_size(kind: u64) -> u64 {
    let mut size: u64 = 8;
    if kind == STORAGE_V128 {
        size = 16;
    }
    size
}

# The bytes an element of `kind` takes in a data segment.
inline fn data_size(kind: u64) -> u64 {
    let mut size: u64 = 8;
    if kind == STORAGE_I8 {
        size = 1;
    }
    if kind == STORAGE_I16 {
        size = 2;
    }
    if kind == STORAGE_32 {
        size = 4;
    }
    if kind == STORAGE_V128 {
        size = 16;
    }
    size
}

# Copy `count` elements of `kind` from a data segment's bytes at `source` into elements at `destination`.
inline fn copy_data_elements(destination: u64, source: u64, count: u64, kind: u64) {
    let size = data_size(kind);
    let element_size = storage_size(kind);
    let mut index: u64 = 0;
    while index < count {
        let from = source + (index * size);
        let to = destination + (index * element_size);
        let mut low: u64 = 0;
        let mut high: u64 = 0;
        if kind == STORAGE_I8 {
            load8(low, [from, 0]);
        }
        if kind == STORAGE_I16 {
            load16(low, [from, 0]);
        }
        if kind == STORAGE_32 {
            load32(low, [from, 0]);
        }
        if kind == STORAGE_64 {
            load64(low, [from, 0]);
        }
        if kind == STORAGE_V128 {
            load64(low, [from, 0]);
            load64(high, [from, 8]);
        }
        store_storage_value(to, kind, low, high);
        index = index + 1;
    }
}

inline fn non_null(reference: u64) -> u64 {
    guard reference != 0 else @cold {
        trap(TRAP_NULL_REFERENCE);
    };
    reference
}

inline fn array_length(array: u64) -> u64 {
    let mut length: u64;
    load64(length, [array, OBJECT_LENGTH_OFFSET]);
    length
}

inline fn object_data(object: u64) -> u64 {
    let mut data: u64;
    load64(data, [object, OBJECT_DATA_OFFSET]);
    data
}

inline fn array_element_kind(array: u64) -> u64 {
    let mut rtt: u64;
    load64(rtt, [array, 0]);
    let mut kinds: u64;
    load64(kinds, [rtt, RTT_FIELD_KINDS]);
    let mut kind: u64;
