    let lane_bits: u64 = 64;
    let complement = lane_bits - masked;
    let fill_count = v128_from_u64x2(complement, 0);
    let a = top_vector();
    # Shift logically, and fill the vacated bits from the sign.
    let sign = v128_gt_s_i64(zero_vector(), a);
    let shifted = v128_shr_u_i64(a, count);
    let fill = v128_shl_i64(sign, fill_count);
    let value = v128_or(shifted, fill);
    vector_result(value, offset);
}

handler I8x16Shl() @opcode(0xfd, 0x6b) {
