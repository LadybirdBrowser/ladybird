# The v128 forms of instructions that move values (quickening rule 2). The scalar slot of a v128 local holds the
# address of its 16-byte storage.

handler LocalGetV128() @opcode(0xf4) {
    let [index, length] = read_leb(immediates());
    let locals: Sequence<u64> = alias(fp);
    let storage = locals[index];
    let mut value: v128;
    load128(value, [storage, 0]);
    let top: u64 = vsp;
    let next = top - 16;
    vsp = next;
    store128([next, 0], value);
    advance(length + 1);
}

handler LocalSetV128() @opcode(0xf5) {
    let [index, length] = read_leb(immediates());
    let locals: Sequence<u64> = alias(fp);
    let storage = locals[index];
    let value = top_vector();
    store128([storage, 0], value);
    drop_slots(2);
    advance(length + 1);
}

handler LocalTeeV128() @opcode(0xf6) {
