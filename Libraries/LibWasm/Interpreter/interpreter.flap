# Whether `reference` matches the heap type encoded at `bytes`, with null matching if `nullable` is set, and the
# length of the encoding.
inline fn reference_matches(reference: u64, bytes: Sequence<u8>, nullable: u64) -> (u64, u64) {
    let first: u64 = alias(bytes[0]);
    let mut matches: u64 = 0;
    let mut length: u64 = 1;
    # Abstract heap types are single bytes from 0x40 to 0x7F, negative as s33 values.
    let biased = first - 0x40;
    if biased < 0x40 {
        if reference != 0 {
            let tag = reference & 3;
            let low_bit = reference & 1;
            # any, func, extern, and exn take any non-null reference of their hierarchy.
            if first == 0x6e {
                matches = 1;
            }
            if first == 0x70 {
                matches = 1;
            }
            if first == 0x6f {
                matches = 1;
            }
            if first == 0x69 {
                matches = 1;
            }
            if first == 0x6d {
                if low_bit != 0 {
                    matches = 1;
                }
                if tag == 0 {
                    matches = 1;
                }
            }
            if first == 0x6c {
                matches = low_bit;
            }
            if first == 0x6b {
                if tag == 0 {
                    let mut rtt: u64;
                    load64(rtt, [reference, 0]);
                    let mut kind: u64;
                    load32(kind, [rtt, RTT_KIND]);
                    if kind == RTT_KIND_STRUCT {
                        matches = 1;
                    }
                }
            }
            if first == 0x6a {
                if tag == 0 {
                    let mut rtt: u64;
                    load64(rtt, [reference, 0]);
                    let mut kind: u64;
                    load32(kind, [rtt, RTT_KIND]);
                    if kind == RTT_KIND_ARRAY {
                        matches = 1;
                    }
                }
            }
        }
    } else {
        let [type_index, index_length] = read_leb(bytes);
        length = index_length;
        if reference != 0 {
            let identity = identity_of_type(type_index);
            let target = rtt_of_identity(identity);
            let mut target_kind: u64;
            load32(target_kind, [target, RTT_KIND]);
            if target_kind == RTT_KIND_FUNCTION {
                let mut function_identity: u64;
                load32(function_identity, [reference, FUNCTION_TYPE_IDENTITY]);
                let actual = rtt_of_identity(function_identity);
                matches = rtt_is_subtype(actual, identity);
            } else {
                let tag = reference & 3;
                if tag == 0 {
                    let mut actual: u64;
                    load64(actual, [reference, 0]);
                    matches = rtt_is_subtype(actual, identity);
                }
            }
        }
    }
    if reference == 0 {
        matches = nullable;
    }
    (matches, length)
}

inline fn test_reference(nullable: u64) {
    let [bytes, offset] = prefixed_immediates();
    let reference = unary_operand();
    let [matches, length] = reference_matches(reference, bytes, nullable);
    set_top(matches);
    advance(offset + length);
}

inline fn cast_reference(nullable: u64) {
    let [bytes, offset] = prefixed_immediates();
    let reference = unary_operand();
    let [matches, length] = reference_matches(reference, bytes, nullable);
    guard matches != 0 else @cold {
        trap(TRAP_CAST_FAILURE);
    };
    advance(offset + length);
}

