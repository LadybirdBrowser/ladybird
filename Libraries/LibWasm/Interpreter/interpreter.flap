# The in-place WebAssembly interpreter. Handlers run on a function's original code bytes: `ip` points at the
# current instruction, whose immediates the handler decodes itself, and `stp` points at the next entry of the
# function's side table, which branches read their targets from (see validator.rs). Frames live on the machine
# stack (see abi.rs): locals at fp + 8 * i, the frame header below fp, and the operand stack below the header in
# 8-byte slots, with `vsp` pointing at the top slot.
#
# Slots hold i32 and f32 values zero-extended, i64 and f64 values and references in full, and v128 values in two
# slots, low half at the lower address.

# Decoding immediates. The validator guarantees they are well-formed, so only their lengths and values matter.

# An unsigned LEB128 value and its length. Most immediates are a single byte, so the loop over the others is out of
# line.
inline fn read_leb(bytes: Sequence<u8>) -> (u64, u64) {
    let first: u64 = alias(bytes[0]);
    let mut result: u64 = first;
    let mut length: u64 = 1;
    if first >= 128 @cold {
        result = first & 127;
        let mut shift: u64 = 7;
        let mut byte: u64 = first;
        do {
            byte = alias(bytes[length]);
            let bits = (byte & 127) << shift;
            result = result | bits;
            shift = shift + 7;
            length = length + 1;
        } while byte >= 128;
    }
    (result, length)
}

# A signed LEB128 value, sign-extended to 64 bits, and its length.
inline fn read_signed_leb(bytes: Sequence<u8>) -> (u64, u64) {
    let first: u64 = alias(bytes[0]);
    let moved = first << 57;
    let signed: i64 = alias(moved);
    let extended = signed >> 57;
    let mut result: u64 = alias(extended);
    let mut length: u64 = 1;
    if first >= 128 @cold {
        result = first & 127;
        let mut shift: u64 = 7;
        let mut byte: u64 = first;
        do {
            byte = alias(bytes[length]);
            let bits = (byte & 127) << shift;
            result = result | bits;
            shift = shift + 7;
            length = length + 1;
        } while byte >= 128;
        if shift < 64 {
            if byte & 64 != 0 {
                let all_ones: u64 = 0xffffffffffffffff;
                let extension = all_ones << shift;
                result = result | extension;
            }
        }
    }
    (result, length)
}

# The length of a LEB128 value.
inline fn leb_length(bytes: Sequence<u8>) -> u64 {
    let first: u64 = alias(bytes[0]);
    let mut length: u64 = 1;
    if first >= 128 @cold {
        let mut byte: u64 = first;
        while byte >= 128 {
            byte = alias(bytes[length]);
            length = length + 1;
        }
    }
    length
}

# The length of a block type immediate: a value type, which takes one byte unless it is a reference type with a heap
# type, the empty type, or a type index.
inline fn block_type_length(bytes: Sequence<u8>) -> u64 {
    let first: u64 = alias(bytes[0]);
    let mut length: u64 = 1;
    if first >= 0x63 @cold {
        if first <= 0x64 {
            let start: u64 = alias(bytes);
            let heap_bytes: Sequence<u8> = alias(start + 1);
            let heap_length = leb_length(heap_bytes);
            length = heap_length + 1;
        }
        if first >= 128 {
            length = leb_length(bytes);
        }
    }
    length
}

inline fn immediates() -> Sequence<u8> {
    let current: u64 = ip;
    let bytes: Sequence<u8> = alias(current + 1);
    bytes
}

# The immediates after a prefix opcode and its LEB128 sub-opcode, and the offset from the instruction to them.
inline fn prefixed_immediates() -> (Sequence<u8>, u64) {
    let length = leb_length(immediates());
    let current: u64 = ip;
    let offset = length + 1;
    let bytes: Sequence<u8> = alias(current + offset);
    (bytes, offset)
}

inline fn advance(length: u64) {
    let current: u64 = ip;
    let next = current + length;
    ip = next;
    dispatch;
}

# The operand stack.

inline fn stack() -> Sequence<u64> {
    let top: u64 = vsp;
    let slots: Sequence<u64> = alias(top);
    slots
}

inline fn push(value: u64) {
    let top: u64 = vsp;
    let next = top - 8;
    vsp = next;
    let slots: Sequence<u64> = alias(next);
    slots[0] = value;
}

inline fn pop() -> u64 {
    let top: u64 = vsp;
    let slots: Sequence<u64> = alias(top);
    let value = slots[0];
    let next = top + 8;
    vsp = next;
    value
}

inline fn pop32() -> u32 {
    let value = pop();
    u32(value)
}

inline fn drop_slots(count: u64) {
    let top: u64 = vsp;
    let next = top + (count << 3);
    vsp = next;
}

# Operand helpers for numeric instructions: the two operands of a binary instruction, whose result replaces the
# first of them, and the operand of a unary instruction, whose result replaces it.

inline fn binary_operands() -> (u64, u64) {
    let top: u64 = vsp;
    let slots: Sequence<u64> = alias(top);
    let rhs = slots[0];
    let lhs = slots[1];
    let next = top + 8;
    vsp = next;
    (lhs, rhs)
}

inline fn binary32() -> (u32, u32) {
    let [lhs, rhs] = binary_operands();
    let narrow_lhs = u32(lhs);
    let narrow_rhs = u32(rhs);
    (narrow_lhs, narrow_rhs)
}

inline fn unary_operand() -> u64 {
    let slots = stack();
    slots[0]
}

inline fn unary32() -> u32 {
    let value = unary_operand();
    u32(value)
}

inline fn set_top(value: u64) {
    let slots = stack();
    slots[0] = value;
}

inline fn result(value: u64) {
    set_top(value);
    dispatch_next;
}

inline fn result32(value: u32) {
    let wide: u64 = alias(value);
    set_top(wide);
    dispatch_next;
}

inline fn signed64(value: u64) -> i64 {
    let signed: i64 = alias(value);
    signed
}

inline fn unsigned64(value: u64) -> u64 {
    value
}

# The frame.

inline fn frame_word(offset: u64) -> u64 {
    let frame: u64 = fp;
    let mut value: u64;
    load64(value, [frame, offset]);
    value
}

inline fn context() -> u64 {
    let frame: u64 = fp;
    let mut value: u64;
    load64(value, [frame, FRAME_CONTEXT]);
    value
}

inline fn instance() -> u64 {
    let frame: u64 = fp;
    let mut value: u64;
    load64(value, [frame, FRAME_INSTANCE]);
    value
}

# Leave the interpreter with a trap: return to the entry the runtime made, with the trap code in its record.
inline fn trap_with(code: u64, context_pointer: u64) {
    let mut record: u64;
    load64(record, [context_pointer, CONTEXT_ENTRY_RECORD]);
    store32([record, ENTRY_TRAP], code);
    leave(context_pointer, record);
}

inline fn trap(code: u64) {
    trap_with(code, context());
}

# Restore the state of the entry that `record` describes and leave the interpreter.
inline fn leave(context_pointer: u64, record: u64) {
    let mut entry_fp: u64;
    load64(entry_fp, [context_pointer, CONTEXT_ENTRY_FP]);
    let mut saved_fp: u64;
    load64(saved_fp, [record, ENTRY_SAVED_ENTRY_FP]);
    let mut saved_record: u64;
    load64(saved_record, [record, ENTRY_SAVED_ENTRY_RECORD]);
    store64([context_pointer, CONTEXT_ENTRY_FP], saved_fp);
    store64([context_pointer, CONTEXT_ENTRY_RECORD], saved_record);
    fp = entry_fp;
    exit();
}

# Calls and returns.

# OPTIMIZATION: Shifts align without the scratch registers a 64-bit `and` with an immediate reserves, which the call
# handlers do not have to spare.
inline fn align_down_16(address: u64) -> u64 {
    let shifted = address >> 4;
    shifted << 4
}

# Touch the stack from `current` down to `bottom`, below which a new frame is about to end, if the frame reaches into a
# page below that of `current`. Windows commits a thread's stack as code touches the guard page below its committed
# part, and code that skips past the guard page faults. Every page down to that of the stack pointer is committed, so
# probing the pages in between from the top down keeps that so; a frame within the stack pointer's page needs none.
# An atomic load is never removed, so it serves as the probe.
inline fn probe_stack(current: u64, bottom: u64) {
    let current_page = current >> 12;
    let bottom_page = bottom >> 12;
    if bottom_page != current_page @cold {
        let mut address = current;
        while address > bottom {
            let _ = atomic_load8([address, 0]);
            address = address - 4096;
        }
        let _ = atomic_load8([bottom, 0]);
    }
}

# Call a host function through the runtime, with its arguments on top of the operand stack.
inline fn call_host_function(function: u64, return_ip: u64, context_pointer: u64) {
    store64([context_pointer, CONTEXT_ARGUMENTS], function);
    let top: u64 = vsp;
    store64([context_pointer, CONTEXT_ARGUMENT_1], top);
    store64([context_pointer, CONTEXT_ARGUMENT_2], return_ip);
    store64([context_pointer, CONTEXT_ARGUMENT_3], fp);
    # The helper may clobber every allocatable register, so nothing but its result and the context is kept across it.
    let saved_context = context();
    ip = return_ip;
    let new_top: u64 = call_helper(wasm_runtime_call_host, context_pointer);
    guard new_top != 0 else @cold {
        trap(TRAP_RUNTIME);
    };
    if new_top == 1 @cold {
        resume_at_handler(saved_context);
    }
    vsp = new_top;
    dispatch;
}

# Call a function with compiled code, with its arguments on top of the operand stack. The runtime runs it and replaces
# the arguments with its results; a trap in it leaves the interpreter from the compiled code. An exception it throws
# continues at the call, as with host functions. A tail call it makes of a function that does not run compiled comes
# back to the interpreter, which makes it in the compiled function's place (see CallPending).
inline fn call_compiled_function(function: u64, return_ip: u64, context_pointer: u64) {
    store64([context_pointer, CONTEXT_ARGUMENTS], function);
    let top: u64 = vsp;
    store64([context_pointer, CONTEXT_ARGUMENT_1], top);
    store64([context_pointer, CONTEXT_ARGUMENT_2], return_ip);
    store64([context_pointer, CONTEXT_ARGUMENT_3], fp);
    # The helper may clobber every allocatable register, so nothing but its result and the context is kept across it.
    let saved_context = context();
    ip = return_ip;
    let new_top: u64 = call_helper(wasm_runtime_call_compiled, context_pointer);
    guard new_top != 0 else @cold {
        trap(TRAP_RUNTIME);
    };
    if new_top == 1 @cold {
        resume_at_handler(saved_context);
    }
    if new_top == 2 @cold {
        let pending_context = context();
        let mut pending_ip: u64;
        load64(pending_ip, [pending_context, CONTEXT_ARGUMENT_4]);
        ip = pending_ip;
        dispatch;
    }
    vsp = new_top;
    dispatch;
}

# Continue at the exception handler the runtime found, which it left in the context's arguments.
inline fn resume_at_handler(context_pointer: u64) {
    let mut handler_fp: u64;
    load64(handler_fp, [context_pointer, CONTEXT_ARGUMENTS]);
    let mut handler_ip: u64;
    load64(handler_ip, [context_pointer, CONTEXT_ARGUMENT_1]);
    let mut handler_stp: u64;
    load64(handler_stp, [context_pointer, CONTEXT_ARGUMENT_2]);
    let mut handler_vsp: u64;
    load64(handler_vsp, [context_pointer, CONTEXT_ARGUMENT_3]);
    let mut handler_instance: u64;
    load64(handler_instance, [handler_fp, FRAME_INSTANCE]);
    let mut handler_memory_base: u64;
    load64(handler_memory_base, [handler_instance, INSTANCE_MEMORY0_BASE]);
    fp = handler_fp;
    ip = handler_ip;
    stp = handler_stp;
    vsp = handler_vsp;
    memory_base = handler_memory_base;
    dispatch;
}

# Throw the exception `exception` refers to, or a new one with `tag` and the values on top of the operand stack.
inline fn throw_exception(tag: u64, exception: u64) {
    let context_pointer = context();
    store64([context_pointer, CONTEXT_ARGUMENTS], tag);
    let top: u64 = vsp;
    store64([context_pointer, CONTEXT_ARGUMENT_1], top);
    store64([context_pointer, CONTEXT_ARGUMENT_2], ip);
    store64([context_pointer, CONTEXT_ARGUMENT_3], fp);
    store64([context_pointer, CONTEXT_ARGUMENT_4], exception);
    let caught: u64 = call_helper(wasm_runtime_throw, context_pointer);
    guard caught != 0 else @cold {
        trap(TRAP_RUNTIME);
    };
    resume_at_handler(context_pointer);
}

handler Throw() @opcode(0x08) {
    let [tag_index, _] = read_leb(immediates());
    let instance_pointer = instance();
    let mut tags_pointer: u64;
    load64(tags_pointer, [instance_pointer, INSTANCE_TAGS]);
    let tags: Sequence<u64> = alias(tags_pointer);
    let tag = tags[tag_index];
    throw_exception(tag, 0);
}

handler ThrowRef() @opcode(0x0a) {
    let exception = pop();
    guard exception != 0 else @cold {
        trap(TRAP_NULL_REFERENCE);
    };
    throw_exception(0, exception);
}

# A try_table runs like a block; its handlers are found by the runtime when something throws.
handler TryTable() @opcode(0x1f) {
    let block_length = block_type_length(immediates());
    let current: u64 = ip;
    let count_bytes: Sequence<u8> = alias(current + 1 + block_length);
    let [count, count_length] = read_leb(count_bytes);
    let mut position = current + 1 + block_length + count_length;
    let mut remaining = count;
    while remaining != 0 {
        let clause: Sequence<u8> = alias(position);
        let kind: u64 = alias(clause[0]);
        position = position + 1;
        if kind < 2 {
            let tag_bytes: Sequence<u8> = alias(position);
            let tag_length = leb_length(tag_bytes);
            position = position + tag_length;
        }
        let label_bytes: Sequence<u8> = alias(position);
        let label_length = leb_length(label_bytes);
        position = position + label_length;
        remaining = remaining - 1;
    }
    ip = position;
    dispatch;
}

# Enter a function with v128 parameters or locals, whose frame has storage for them (see call_function).
inline fn call_vector_function(function: u64, return_ip: u64, context_pointer: u64) {
    let mut locals_size: u64;
    load32(locals_size, [function, FUNCTION_LOCALS_SIZE]);
    let mut frame_size: u64;
    load32(frame_size, [function, FUNCTION_FRAME_SIZE]);
    let caller_vsp: u64 = vsp;
    let new_fp = align_down_16(caller_vsp - locals_size);
    # The stack pointer only ever moves down while WebAssembly runs: returns leave it where the callee had it, and a
    # frame that would end above it ends at it instead. Spilled values rely on that when they move into the new
    # frame (see spill.rs in Flap).
    let current_sp: u64 = sp;
    let mut bottom = new_fp - frame_size;
    if current_sp < bottom {
        bottom = current_sp;
    }
    let mut limit: u64;
    load64(limit, [context_pointer, CONTEXT_STACK_LIMIT]);
    guard bottom >= limit else @cold {
        trap_with(TRAP_STACK_EXHAUSTED, context_pointer);
    };
    probe_stack(current_sp, bottom);
    sp = bottom;
    store64([new_fp, FRAME_SAVED_FP], fp);
    store64([new_fp, FRAME_RETURN_IP], return_ip);
    store64([new_fp, FRAME_SAVED_STP], stp);
    store64([new_fp, FRAME_FUNCTION], function);
    store64([new_fp, FRAME_SAVED_MEMORY_BASE], memory_base);
    store64([new_fp, FRAME_CONTEXT], context_pointer);
    fp = new_fp;

    # Copy the arguments into the first locals and clear the others. A v128 local's slot gets the address of its
    # storage, at the offset from fp the function's vector storage table gives; scalar locals have offset zero.
    let mut param_slots: u64;
    load32(param_slots, [function, FUNCTION_PARAM_SLOTS]);
    let mut storage_table: u64;
    load64(storage_table, [function, FUNCTION_VECTOR_STORAGE]);
    let offsets: Sequence<u32> = alias(storage_table);
    let arguments = stack();
    let locals: Sequence<u64> = alias(new_fp);
    let mut index: u64 = 0;
    let mut source: u64 = param_slots;
    while source != 0 {
        let offset: u64 = alias(offsets[index]);
        if offset == 0 {
            source = source - 1;
            locals[index] = arguments[source];
        } else {
            source = source - 2;
            let storage = new_fp + offset;
            let high_source = source + 1;
            let low = arguments[source];
            let high = arguments[high_source];
            store64([storage, 0], low);
            store64([storage, 8], high);
            locals[index] = storage;
        }
        index = index + 1;
    }
    let return_vsp = caller_vsp + (param_slots << 3);
    store64([new_fp, FRAME_RETURN_VSP], return_vsp);
    let mut local_count: u64;
    load32(local_count, [function, FUNCTION_LOCAL_COUNT]);
    while index < local_count {
        let offset: u64 = alias(offsets[index]);
        if offset == 0 {
            locals[index] = 0;
        } else {
            let storage = new_fp + offset;
            store64([storage, 0], 0);
            store64([storage, 8], 0);
            locals[index] = storage;
        }
        index = index + 1;
    }

    let mut callee_instance: u64;
    load64(callee_instance, [function, FUNCTION_INSTANCE]);
    store64([new_fp, FRAME_INSTANCE], callee_instance);
    let mut code: u64;
    load64(code, [function, FUNCTION_CODE]);
    let mut side_table: u64;
    load64(side_table, [function, FUNCTION_SIDE_TABLE]);
    let mut callee_memory_base: u64;
    load64(callee_memory_base, [callee_instance, INSTANCE_MEMORY0_BASE]);
    let empty_stack = new_fp - FRAME_HEADER_SIZE;
    ip = code;
    stp = side_table;
    memory_base = callee_memory_base;
    vsp = empty_stack;
    dispatch;
}

# Call `function` with its arguments on top of the operand stack, continuing at `return_ip` when it returns: charge
# its tier-up budget, then enter it.
inline fn call_function(function: u64, return_ip: u64, context_pointer: u64) {
    let mut callee: u64 = function;
    let mut callee_return_ip: u64 = return_ip;
    let mut callee_context: u64 = context_pointer;
    let mut budget: u64;
    load32(budget, [callee, FUNCTION_TIER_UP_BUDGET]);
    if budget < TIER_UP_CALL_COST @cold {
        # The runtime compiles the function, or not, and resets its budget. It may clobber every allocatable register,
        # so the call's operands wait in the context.
        store64([callee_context, CONTEXT_ARGUMENTS], callee);
        store64([callee_context, CONTEXT_ARGUMENT_1], callee_return_ip);
        store64([callee_context, CONTEXT_ARGUMENT_2], 0);
        let _ignored: u64 = call_helper(wasm_runtime_tier_up, callee_context);
        callee_context = context();
        load64(callee, [callee_context, CONTEXT_ARGUMENTS]);
        load64(callee_return_ip, [callee_context, CONTEXT_ARGUMENT_1]);
        load32(budget, [callee, FUNCTION_TIER_UP_BUDGET]);
    }
    store32([callee, FUNCTION_TIER_UP_BUDGET], budget - TIER_UP_CALL_COST);
    enter_function(callee, callee_return_ip, callee_context);
}

# Enter `function` with its arguments on top of the operand stack, continuing at `return_ip` when it returns.
#
# OPTIMIZATION: The caller's state goes into the new frame's header as soon as the frame's address is known, so that
# its registers can be reused while the arguments are copied.
inline fn enter_function(function: u64, return_ip: u64, context_pointer: u64) {
    let mut kind: u64;
    load32(kind, [function, FUNCTION_KIND]);
    if kind != FUNCTION_KIND_WASM @cold {
        if kind == FUNCTION_KIND_HOST {
            call_host_function(function, return_ip, context_pointer);
        }
        if kind == FUNCTION_KIND_COMPILED {
            call_compiled_function(function, return_ip, context_pointer);
        }
        call_vector_function(function, return_ip, context_pointer);
    }
    let mut locals_size: u64;
    load32(locals_size, [function, FUNCTION_LOCALS_SIZE]);
    let mut frame_size: u64;
    load32(frame_size, [function, FUNCTION_FRAME_SIZE]);
    let caller_vsp: u64 = vsp;
    let new_fp = align_down_16(caller_vsp - locals_size);
    # The stack pointer only ever moves down while WebAssembly runs: returns leave it where the callee had it, and a
    # frame that would end above it ends at it instead. Spilled values rely on that when they move into the new
    # frame (see spill.rs in Flap).
    let current_sp: u64 = sp;
    let mut bottom = new_fp - frame_size;
    if current_sp < bottom {
        bottom = current_sp;
    }
    let mut limit: u64;
    load64(limit, [context_pointer, CONTEXT_STACK_LIMIT]);
    guard bottom >= limit else @cold {
        trap_with(TRAP_STACK_EXHAUSTED, context_pointer);
    };
    probe_stack(current_sp, bottom);
    sp = bottom;
    store64([new_fp, FRAME_SAVED_FP], fp);
    store64([new_fp, FRAME_RETURN_IP], return_ip);
    store64([new_fp, FRAME_SAVED_STP], stp);
    store64([new_fp, FRAME_FUNCTION], function);
    store64([new_fp, FRAME_SAVED_MEMORY_BASE], memory_base);
    store64([new_fp, FRAME_CONTEXT], context_pointer);
    fp = new_fp;

    # Copy the arguments into the first locals and clear the others.
    let mut param_slots: u64;
    load32(param_slots, [function, FUNCTION_PARAM_SLOTS]);
    let arguments = stack();
    let locals: Sequence<u64> = alias(new_fp);
    let mut index: u64 = 0;
    let mut source: u64 = param_slots;
    while index < param_slots {
        source = source - 1;
        locals[index] = arguments[source];
        index = index + 1;
    }
    let return_vsp = caller_vsp + (param_slots << 3);
    store64([new_fp, FRAME_RETURN_VSP], return_vsp);
    let mut local_count: u64;
    load32(local_count, [function, FUNCTION_LOCAL_COUNT]);
    while index < local_count {
        locals[index] = 0;
        index = index + 1;
    }

    let mut callee_instance: u64;
    load64(callee_instance, [function, FUNCTION_INSTANCE]);
    store64([new_fp, FRAME_INSTANCE], callee_instance);
    let mut code: u64;
    load64(code, [function, FUNCTION_CODE]);
    let mut side_table: u64;
    load64(side_table, [function, FUNCTION_SIDE_TABLE]);
    let mut callee_memory_base: u64;
    load64(callee_memory_base, [callee_instance, INSTANCE_MEMORY0_BASE]);
    let empty_stack = new_fp - FRAME_HEADER_SIZE;
    ip = code;
    stp = side_table;
    memory_base = callee_memory_base;
    vsp = empty_stack;
    dispatch;
}

# Move `count` slots from the top of the operand stack to just below `destination`, as the new top of the stack. The
# slots move up, so the highest one is copied first.
inline fn move_top_slots(count: u64, destination: u64) -> u64 {
    let new_top = destination - (count << 3);
    let source = stack();
    let target: Sequence<u64> = alias(new_top);
    let mut index: u64 = count;
    while index != 0 {
        index = index - 1;
        target[index] = source[index];
    }
    new_top
}

# Return from the current function with its results on top of the operand stack. The results land where the
# arguments were, which may overlap the frame header, so the header is read first.
inline fn return_from_function() {
    let frame: u64 = fp;
    let mut function: u64;
    load64(function, [frame, FRAME_FUNCTION]);
    let mut return_vsp: u64;
    load64(return_vsp, [frame, FRAME_RETURN_VSP]);
    let mut return_ip: u64;
    load64(return_ip, [frame, FRAME_RETURN_IP]);
    ip = return_ip;
    let mut saved_stp: u64;
    load64(saved_stp, [frame, FRAME_SAVED_STP]);
    stp = saved_stp;
    let mut saved_memory_base: u64;
    load64(saved_memory_base, [frame, FRAME_SAVED_MEMORY_BASE]);
    memory_base = saved_memory_base;
    let mut saved_fp: u64;
    load64(saved_fp, [frame, FRAME_SAVED_FP]);
    fp = saved_fp;
    let mut result_slots: u64;
    load32(result_slots, [function, FUNCTION_RESULT_SLOTS]);
    let new_top = move_top_slots(result_slots, return_vsp);
    vsp = new_top;
    dispatch;
}

# Replace the current frame with a call to `function`, whose arguments are on top of the operand stack: move them to
# where the current function's caller put its arguments, and call from the caller's state.
inline fn tail_call(function: u64) {
    let context_pointer = context();
    let frame: u64 = fp;
    let mut return_vsp: u64;
    load64(return_vsp, [frame, FRAME_RETURN_VSP]);
    let mut return_ip: u64;
    load64(return_ip, [frame, FRAME_RETURN_IP]);
    let mut saved_stp: u64;
    load64(saved_stp, [frame, FRAME_SAVED_STP]);
    stp = saved_stp;
    let mut saved_memory_base: u64;
    load64(saved_memory_base, [frame, FRAME_SAVED_MEMORY_BASE]);
    memory_base = saved_memory_base;
    let mut saved_fp: u64;
    load64(saved_fp, [frame, FRAME_SAVED_FP]);
    fp = saved_fp;
    let mut param_slots: u64;
    load32(param_slots, [function, FUNCTION_PARAM_SLOTS]);
    let new_top = move_top_slots(param_slots, return_vsp);
    vsp = new_top;
    call_function(function, return_ip, context_pointer);
}

# Call the function that compiled code tail called, which the runtime left in the context's first argument with its
# argument slots, in operand stack order, where the second points, so that its results end at `end`, and continue at
# `return_ip` when it returns. Its arguments may need more room than those of the function it replaces.
inline fn call_pending(end: u64, return_ip: u64) {
    let context_pointer = context();
    let mut function: u64;
    load64(function, [context_pointer, CONTEXT_ARGUMENTS]);
    let mut arguments_pointer: u64;
    load64(arguments_pointer, [context_pointer, CONTEXT_ARGUMENT_1]);
    let mut param_slots: u64;
    load32(param_slots, [function, FUNCTION_PARAM_SLOTS]);
    let new_top = end - (param_slots << 3);
    let current_sp: u64 = sp;
    # The handlers' spill area is right above the stack pointer, so it must stay below the arguments.
    let bottom = align_down_16(new_top - SPILL_AREA_SIZE);
    if bottom < current_sp {
        let mut limit: u64;
        load64(limit, [context_pointer, CONTEXT_STACK_LIMIT]);
        guard bottom >= limit else @cold {
            trap_with(TRAP_STACK_EXHAUSTED, context_pointer);
        };
        probe_stack(current_sp, bottom);
        sp = bottom;
    }
    let arguments: Sequence<u64> = alias(arguments_pointer);
    let slots: Sequence<u64> = alias(new_top);
    let mut index: u64 = 0;
    while index < param_slots {
        slots[index] = arguments[index];
        index = index + 1;
    }
    vsp = new_top;
    call_function(function, return_ip, context_pointer);
}

# Branches.

# Take the branch whose side-table entry is at `entry`, from the instruction at `branch_ip`.
inline fn take_branch(entry: u64, branch_ip: u64) {
    let mut drop: u64;
    load32(drop, [entry, 12]);
    if drop != 0 {
        let mut keep: u64;
        load32(keep, [entry, 8]);
        let top: u64 = vsp;
        let new_top = top + (drop << 3);
        let destination = new_top + (keep << 3);
        let moved_top = move_top_slots(keep, destination);
        vsp = moved_top;
    }
    let mut pc_delta: u64;
    load32(pc_delta, [entry, 0]);
    let mut stp_delta: u64;
    load32(stp_delta, [entry, 4]);
    let narrow_pc_delta = i32(pc_delta);
    let signed_pc_delta = i64(narrow_pc_delta);
    let narrow_stp_delta = i32(stp_delta);
    let signed_stp_delta = i64(narrow_stp_delta);
    let pc_offset: u64 = alias(signed_pc_delta);
    let stp_offset: u64 = alias(signed_stp_delta);
    let target_ip = branch_ip + pc_offset;
    let target_stp = entry + (stp_offset << 4);
    ip = target_ip;
    stp = target_stp;
    dispatch;
}

inline fn branch() {
    let entry: u64 = stp;
    let current: u64 = ip;
    take_branch(entry, current);
}

inline fn skip_entry_and_advance(length: u64) {
    let current_stp: u64 = stp;
    let next_stp = current_stp + 16;
    stp = next_stp;
    advance(length);
}

# The pseudo-instructions the runtime enters and leaves the interpreter with.

# Enter: `vsp` holds the entry record. Build a frame for the runtime below the entry frame and push the arguments.
# The runtime's code continues with a CallEntry pseudo-instruction, which calls the function, and an Exit one, which
# the function returns to.
handler Enter() @opcode(0xf0) {
    let record: u64 = vsp;
    let mut context_pointer: u64;
    load64(context_pointer, [record, ENTRY_CONTEXT]);
    let mut previous_fp: u64;
    load64(previous_fp, [context_pointer, CONTEXT_ENTRY_FP]);
    store64([record, ENTRY_SAVED_ENTRY_FP], previous_fp);
    let mut previous_record: u64;
    load64(previous_record, [context_pointer, CONTEXT_ENTRY_RECORD]);
    store64([record, ENTRY_SAVED_ENTRY_RECORD], previous_record);
    store64([context_pointer, CONTEXT_ENTRY_FP], fp);
    store64([context_pointer, CONTEXT_ENTRY_RECORD], record);
    store32([record, ENTRY_TRAP], 0);

    let mut function: u64;
    load64(function, [record, ENTRY_FUNCTION]);
    let mut param_slots: u64;
    load32(param_slots, [function, FUNCTION_PARAM_SLOTS]);
    let entry_sp: u64 = sp;
    let runtime_fp = align_down_16(entry_sp - FRAME_HEADER_SIZE - SPILL_AREA_SIZE);
    let arguments_top = runtime_fp - FRAME_HEADER_SIZE - (param_slots << 3);
    let new_sp = align_down_16(arguments_top - SPILL_AREA_SIZE);
    # The native code that entered the interpreter touched the stack above its frame, but maybe not the page of the
    # entry frame's stack pointer.
    let _ = atomic_load8([entry_sp, 0]);
    probe_stack(entry_sp, new_sp);
    sp = new_sp;
    fp = runtime_fp;
    store64([runtime_fp, FRAME_INSTANCE], 0);
    store64([runtime_fp, FRAME_CONTEXT], context_pointer);
    store64([runtime_fp, FRAME_FUNCTION], function);
    vsp = arguments_top;
    let mut arguments_pointer: u64;
    load64(arguments_pointer, [record, ENTRY_ARGUMENTS]);
    let arguments: Sequence<u64> = alias(arguments_pointer);
    let slots: Sequence<u64> = alias(arguments_top);
    let mut index: u64 = 0;
    while index < param_slots {
        slots[index] = arguments[index];
        index = index + 1;
    }
    advance(1);
}

# Call the function of the entry record, which Enter left in the runtime's frame.
handler CallEntry() @opcode(0xf3) {
    let context_pointer = context();
    let function = frame_word(FRAME_FUNCTION);
    let current: u64 = ip;
    let exit_ip = current + 1;
    call_function(function, exit_ip, context_pointer);
}

# The function returned to the runtime's frame with its results on top of the operand stack.
handler Exit() @opcode(0xf1) {
    let context_pointer = context();
    let mut record: u64;
    load64(record, [context_pointer, CONTEXT_ENTRY_RECORD]);
    let mut function: u64;
    load64(function, [record, ENTRY_FUNCTION]);
    let mut result_slots: u64;
    load32(result_slots, [function, FUNCTION_RESULT_SLOTS]);
    let mut results_pointer: u64;
    load64(results_pointer, [record, ENTRY_RESULTS]);
    let results: Sequence<u64> = alias(results_pointer);
    let values = stack();
    let mut index: u64 = 0;
    while index < result_slots {
        results[index] = values[index];
        index = index + 1;
    }
    leave(context_pointer, record);
}

# The runtime's fault handler continues here when a memory access faults.
handler MemoryFault() @opcode(0xf2) {
    trap(TRAP_MEMORY_OUT_OF_BOUNDS);
}

# Compiled code traps here, with fp the frame of the code that trapped, whose header has the context, and the trap
# code in the context's first argument.
handler TrapFromNative() @opcode(0xef) {
    let context_pointer = context();
    let mut code: u64;
    load64(code, [context_pointer, CONTEXT_ARGUMENTS]);
    trap_with(code, context_pointer);
}

# Compiled code that call_compiled_function() called, or that continued a frame at a loop, tail called a function that
# does not run compiled, which the runtime left pending (see call_pending()), with where the results of the function
# it replaces go in the context's third argument and the address its call returns to in the fourth.
handler CallPending() @opcode(0xee) {
    let context_pointer = context();
    let mut end: u64;
    load64(end, [context_pointer, CONTEXT_ARGUMENT_2]);
    let mut return_ip: u64;
    load64(return_ip, [context_pointer, CONTEXT_ARGUMENT_3]);
    call_pending(end, return_ip);
}

# Bytes that are no instruction. Validation rejects every one of them, so this is never reached.
handler Fallback() @fallback {
    trap(TRAP_UNREACHABLE);
}

# Control instructions.

handler Unreachable() @opcode(0x00) {
    trap(TRAP_UNREACHABLE);
}

handler Nop() @opcode(0x01) {
    dispatch_next;
}

handler Block() @opcode(0x02) {
    let length = block_type_length(immediates());
    advance(length + 1);
}

handler Loop() @opcode(0x03) {
    let function = frame_word(FRAME_FUNCTION);
    let mut budget: u64;
    load32(budget, [function, FUNCTION_TIER_UP_BUDGET]);
    if budget == 0 @cold {
        let context_pointer = context();
        store64([context_pointer, CONTEXT_ARGUMENTS], function);
        let current: u64 = ip;
        store64([context_pointer, CONTEXT_ARGUMENT_1], current);
        store64([context_pointer, CONTEXT_ARGUMENT_2], 1);
        let frame: u64 = fp;
        store64([context_pointer, CONTEXT_ARGUMENT_3], frame);
        # The runtime may run the rest of the function compiled from here (OSR), leaving its results on the operand
        # stack, or a tail call it made pending.
        let results_top: u64 = call_helper(wasm_runtime_tier_up, context_pointer);
        if results_top == 1 {
            resume_at_handler(context_pointer);
        }
        if results_top == 2 {
            trap(TRAP_RUNTIME);
        }
        if results_top == 3 {
            # The frame's compiled code tail called a function that does not run compiled, which replaces the frame.
            let frame: u64 = fp;
            let mut saved_stp: u64;
            load64(saved_stp, [frame, FRAME_SAVED_STP]);
            stp = saved_stp;
            let mut saved_memory_base: u64;
            load64(saved_memory_base, [frame, FRAME_SAVED_MEMORY_BASE]);
            memory_base = saved_memory_base;
            let mut saved_fp: u64;
            load64(saved_fp, [frame, FRAME_SAVED_FP]);
            fp = saved_fp;
            let pending_context = context();
            let mut pending_ip: u64;
            load64(pending_ip, [pending_context, CONTEXT_ARGUMENT_4]);
            ip = pending_ip;
            dispatch;
        }
        if results_top != 0 {
            vsp = results_top;
            return_from_function();
        }
        let skipped = block_type_length(immediates());
        advance(skipped + 1);
    }
    store32([function, FUNCTION_TIER_UP_BUDGET], budget - 1);
    let length = block_type_length(immediates());
    advance(length + 1);
}

handler If() @opcode(0x04) {
    let condition = pop32();
    if condition == 0 {
        branch();
    }
    let length = block_type_length(immediates());
    skip_entry_and_advance(length + 1);
}

# Reached at the end of an if's first arm: skip the second one.
handler Else() @opcode(0x05) {
    branch();
}

# Legacy exception handling. A try runs like a block, and the runtime finds its catch handlers when something throws
# inside it. Its handlers start after their catch or catch_all instruction, which runs only when the try's body or the
# handler before it completes, and skips the remaining handlers like else skips an if's second arm.
handler Try() @opcode(0x06) {
    let length = block_type_length(immediates());
    advance(length + 1);
}

handler Catch() @opcode(0x07) {
    branch();
}

handler CatchAll() @opcode(0x19) {
    branch();
}

# Reached at the end of a try's body, which delegate ends like end does.
handler Delegate() @opcode(0x18) {
    let [_, length] = read_leb(immediates());
    advance(length + 1);
}

# Rethrow the exception a catch or catch_all handler caught. The runtime kept it in a local of the frame for the
# handler, which the side-table entry of the rethrow names as its `keep` count.
handler Rethrow() @opcode(0x09) {
    let entry: u64 = stp;
    let mut local_index: u64;
    load32(local_index, [entry, 8]);
    let locals: Sequence<u64> = alias(fp);
    let exception = locals[local_index];
    throw_exception(0, exception);
}

handler End() @opcode(0x0b) {
    let frame: u64 = fp;
    let mut function: u64;
    load64(function, [frame, FRAME_FUNCTION]);
    let mut code_end: u64;
    load64(code_end, [function, FUNCTION_CODE_END]);
    let current: u64 = ip;
    if current == code_end {
        return_from_function();
    }
    dispatch_next;
}

handler Br() @opcode(0x0c) {
    branch();
}

handler BrIf() @opcode(0x0d) {
    let condition = pop32();
    if condition != 0 {
        branch();
    }
    let length = leb_length(immediates());
    skip_entry_and_advance(length + 1);
}

handler BrTable() @opcode(0x0e) {
    let [count, _] = read_leb(immediates());
    let popped = pop32();
    let index: u64 = alias(popped);
    let mut chosen = index;
    if index > count {
        chosen = count;
    }
    let first: u64 = stp;
    let entry = first + (chosen << 4);
    let current: u64 = ip;
    take_branch(entry, current);
}

handler Return() @opcode(0x0f) {
    return_from_function();
}

inline fn function_at(index: u64) -> u64 {
    let instance_pointer = instance();
    let mut functions_pointer: u64;
    load64(functions_pointer, [instance_pointer, INSTANCE_FUNCTIONS]);
    let functions: Sequence<u64> = alias(functions_pointer);
    functions[index]
}

handler Call() @opcode(0x10) {
    let [function_index, length] = read_leb(immediates());
    let function = function_at(function_index);
    let current: u64 = ip;
    let return_ip = current + length + 1;
    call_function(function, return_ip, context());
}

# The function a call_indirect calls, after checking that it exists and has the expected type.
inline fn indirect_callee(bytes: Sequence<u8>) -> (u64, u64) {
    let [type_index, type_length] = read_leb(bytes);
    let start: u64 = alias(bytes);
    let table_bytes: Sequence<u8> = alias(start + type_length);
    let [table_index, table_length] = read_leb(table_bytes);
    let element = pop();
    let instance_pointer = instance();
    let mut tables_pointer: u64;
    load64(tables_pointer, [instance_pointer, INSTANCE_TABLES]);
    let tables: Sequence<u64> = alias(tables_pointer);
    let table = tables[table_index];
    let mut size: u64;
    load64(size, [table, TABLE_SIZE]);
    guard element < size else @cold {
        trap(TRAP_UNDEFINED_ELEMENT);
    };
    let mut elements_pointer: u64;
    load64(elements_pointer, [table, TABLE_ELEMENTS]);
    let elements: Sequence<u64> = alias(elements_pointer);
    let function = elements[element];
    guard function != 0 else @cold {
        trap(TRAP_UNINITIALIZED_ELEMENT);
    };
    let mut identities_pointer: u64;
    load64(identities_pointer, [instance_pointer, INSTANCE_TYPE_IDENTITIES]);
    let identities: Sequence<u32> = alias(identities_pointer);
    let expected = identities[type_index];
    let mut actual: u32;
    load32(actual, [function, FUNCTION_TYPE_IDENTITY]);
    if actual != expected @cold {
        # A function whose type is a subtype of the expected one may be called too.
        let wide_actual: u64 = alias(actual);
        let wide_expected: u64 = alias(expected);
        let actual_rtt = rtt_of_identity(wide_actual);
        let matches = rtt_is_subtype(actual_rtt, wide_expected);
        guard matches != 0 else @cold {
            trap(TRAP_INDIRECT_CALL_TYPE_MISMATCH);
        };
    }
    (function, type_length + table_length)
}

handler CallIndirect() @opcode(0x11) {
    let [function, length] = indirect_callee(immediates());
    let current: u64 = ip;
    let return_ip = current + length + 1;
    call_function(function, return_ip, context());
}

handler ReturnCall() @opcode(0x12) {
    let [function_index, _] = read_leb(immediates());
    let function = function_at(function_index);
    tail_call(function);
}

handler ReturnCallIndirect() @opcode(0x13) {
    let [function, _] = indirect_callee(immediates());
    tail_call(function);
}

handler CallRef() @opcode(0x14) {
    let length = leb_length(immediates());
    let function = pop();
    guard function != 0 else @cold {
        trap(TRAP_NULL_REFERENCE);
    };
    let current: u64 = ip;
    let return_ip = current + length + 1;
    call_function(function, return_ip, context());
}

handler ReturnCallRef() @opcode(0x15) {
    let function = pop();
    guard function != 0 else @cold {
        trap(TRAP_NULL_REFERENCE);
    };
    tail_call(function);
}

handler Drop() @opcode(0x1a) {
    drop_slots(1);
    dispatch_next;
}

handler Select() @opcode(0x1b) {
    let condition = pop32();
    let [first, second] = binary_operands();
    if condition == 0 {
        set_top(second);
    }
    dispatch_next;
}

handler SelectTyped() @opcode(0x1c) {
    let bytes = immediates();
    # The count of types, which is 1, may take more than one byte.
    let length = leb_length(bytes);
    let type_byte: u64 = alias(bytes[length]);
    let current: u64 = ip;
    let mut type_length: u64 = 1;
    if type_byte >= 0x63 @cold {
        if type_byte <= 0x64 {
            let heap_bytes: Sequence<u8> = alias(current + 2 + length);
            let heap_length = leb_length(heap_bytes);
            type_length = heap_length + 1;
        }
    }
    let condition = pop32();
    if type_byte == 0x7b @cold {
        # A v128 takes two slots.
        if condition == 0 {
            let slots = stack();
            slots[2] = slots[0];
            slots[3] = slots[1];
        }
        drop_slots(2);
        advance(1 + length + type_length);
    }
    let [first, second] = binary_operands();
    if condition == 0 {
        set_top(second);
    }
    advance(1 + length + type_length);
}

# Locals and globals.

handler LocalGet() @opcode(0x20) {
    let [index, length] = read_leb(immediates());
    let locals: Sequence<u64> = alias(fp);
    let value = locals[index];
    push(value);
    advance(length + 1);
}

handler LocalSet() @opcode(0x21) {
    let [index, length] = read_leb(immediates());
    let locals: Sequence<u64> = alias(fp);
    let value = pop();
    locals[index] = value;
    advance(length + 1);
}

handler LocalTee() @opcode(0x22) {
    let [index, length] = read_leb(immediates());
    let locals: Sequence<u64> = alias(fp);
    let value = unary_operand();
    locals[index] = value;
    advance(length + 1);
}

inline fn global_address(index: u64) -> u64 {
    let instance_pointer = instance();
    let mut globals_pointer: u64;
    load64(globals_pointer, [instance_pointer, INSTANCE_GLOBALS]);
    let globals: Sequence<u64> = alias(globals_pointer);
    globals[index]
}

handler GlobalGet() @opcode(0x23) {
    let [index, length] = read_leb(immediates());
    let address = global_address(index);
    let mut value: u64;
    load64(value, [address, 0]);
    push(value);
    advance(length + 1);
}

handler GlobalSet() @opcode(0x24) {
    let [index, length] = read_leb(immediates());
    let address = global_address(index);
    let value = pop();
    store64([address, 0], value);
    advance(length + 1);
}

# Tables.

inline fn table_at(index: u64) -> u64 {
    let instance_pointer = instance();
    let mut tables_pointer: u64;
    load64(tables_pointer, [instance_pointer, INSTANCE_TABLES]);
    let tables: Sequence<u64> = alias(tables_pointer);
    tables[index]
}

inline fn table_element_address(table: u64, index: u64) -> u64 {
    let mut size: u64;
    load64(size, [table, TABLE_SIZE]);
    guard index < size else @cold {
        trap(TRAP_TABLE_OUT_OF_BOUNDS);
    };
    let mut elements: u64;
    load64(elements, [table, TABLE_ELEMENTS]);
    elements + (index << 3)
}

handler TableGet() @opcode(0x25) {
    let [table_index, length] = read_leb(immediates());
    let table = table_at(table_index);
    let index = unary_operand();
    let address = table_element_address(table, index);
    let mut value: u64;
    load64(value, [address, 0]);
    set_top(value);
    advance(length + 1);
}

handler TableSet() @opcode(0x26) {
    let [table_index, length] = read_leb(immediates());
    let table = table_at(table_index);
    let [index, value] = binary_operands();
    drop_slots(1);
    let address = table_element_address(table, index);
    store64([address, 0], value);
    advance(length + 1);
}

# Memory 0. The memory is reserved with guard pages for every address and offset a memory32 access can form, so an
# out-of-bounds access faults, and the runtime's fault handler turns that into a trap. Other memories check bounds.

inline fn memory_at(index: u64) -> u64 {
    let instance_pointer = instance();
    let mut memories_pointer: u64;
    load64(memories_pointer, [instance_pointer, INSTANCE_MEMORIES]);
    let memories: Sequence<u64> = alias(memories_pointer);
    memories[index]
}

# Check that `size` bytes from `address` are in the memory, and return their address.
inline fn checked_memory_address(memory: u64, address: u64, size: u64) -> u64 {
    let mut memory_size: u64;
    load64(memory_size, [memory, MEMORY_SIZE]);
    let end = address + size;
    guard end >= address else @cold {
        trap(TRAP_MEMORY_OUT_OF_BOUNDS);
    };
    guard end <= memory_size else @cold {
        trap(TRAP_MEMORY_OUT_OF_BOUNDS);
    };
    let mut base: u64;
    load64(base, [memory, MEMORY_BASE]);
    base + address
}

# The address of a `size`-byte memory access, and the length of the instruction.
# The address of an access to memory 0, and the length of the instruction. Accesses that cannot rely on memory 0's
# guard pages were quickened into checked forms (see quickening.rs), so the alignment is followed by the offset.
inline fn memory_address(address_operand: u64, size: u64) -> (u64, u64) {
    let current: u64 = ip;
    let offset_bytes: Sequence<u8> = alias(current + 2);
    let [offset, offset_length] = read_leb(offset_bytes);
    let index: u64 = alias(u32(address_operand));
    let base: u64 = memory_base;
    let address = base + index + offset;
    (address, offset_length + 2)
}

# The address of a quickened, bounds-checked access of `size` bytes (`0xFF sub [memory] offset`), and the length of
# its immediates after the sub-opcode.
inline fn checked_access_address(address_operand: u64, size: u64, has_memory_index: u64) -> (u64, u64) {
    let current: u64 = ip;
    let mut memory_index: u64 = 0;
    let mut index_length: u64 = 0;
    if has_memory_index != 0 {
        let index_bytes: Sequence<u8> = alias(current + 2);
        let [decoded_index, decoded_length] = read_leb(index_bytes);
        memory_index = decoded_index;
        index_length = decoded_length;
    }
    let offset_bytes: Sequence<u8> = alias(current + 2 + index_length);
    let [offset, offset_length] = read_leb(offset_bytes);
    let memory = memory_at(memory_index);
    let effective = address_operand + offset;
    guard effective >= address_operand else @cold {
        trap(TRAP_MEMORY_OUT_OF_BOUNDS);
    };
    let address = checked_memory_address(memory, effective, size);
    (address, index_length + offset_length + 2)
}

handler Quickened() @opcode(0xff) {
    let bytes = immediates();
    let sub_opcode: u64 = alias(bytes[0]);
    dispatch_secondary(0xff, sub_opcode);
}

inline fn store_operands() -> (u64, u64) {
    let [address_operand, value] = binary_operands();
    drop_slots(1);
    (address_operand, value)
}


