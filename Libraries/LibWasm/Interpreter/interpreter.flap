        # Equal values only differ in the sign of zero, which the minimum takes from either operand that has it.
        value = lhs | rhs;
    }
    if a != a @cold {
        let x = f32_operand(lhs);
        let y = f32_operand(rhs);
        let sum = add_f32(x, y);
        let nan_bits = f32_to_bits(sum);
        let wide_nan: u64 = alias(nan_bits);
        value = wide_nan;
    }
    if b != b @cold {
        let x = f32_operand(lhs);
        let y = f32_operand(rhs);
        let sum = add_f32(x, y);
        let nan_bits = f32_to_bits(sum);
        let wide_nan: u64 = alias(nan_bits);
        value = wide_nan;
    }
    result(value);
}

handler F32Max() @opcode(0x97) {
    let [lhs, rhs] = binary_operands();
    let a = f32_value(lhs);
    let b = f32_value(rhs);
    let mut value: u64 = lhs;
    if b > a {
        value = rhs;
    }
    if a == b {
        # Equal values only differ in the sign of zero, which the minimum takes from either operand that has it.
        value = lhs & rhs;
    }
    if a != a @cold {
        let x = f32_operand(lhs);
        let y = f32_operand(rhs);
        let sum = add_f32(x, y);
        let nan_bits = f32_to_bits(sum);
        let wide_nan: u64 = alias(nan_bits);
        value = wide_nan;
    }
    if b != b @cold {
        let x = f32_operand(lhs);
        let y = f32_operand(rhs);
        let sum = add_f32(x, y);
        let nan_bits = f32_to_bits(sum);
        let wide_nan: u64 = alias(nan_bits);
        value = wide_nan;
    }
    result(value);
}

