    let [a, b] = binary_vectors();
    let value = v128_min_f64(b, a);
    vector_result(value, offset);
}

handler F64x2Pmax() @opcode(0xfd, 0xf7) {
    let [_, offset] = prefixed_immediates();
    let [a, b] = binary_vectors();
    let value = v128_max_f64(b, a);
    vector_result(value, offset);
}

handler F64x2RelaxedMin() @opcode(0xfd, 0x10f) {
    let [_, offset] = prefixed_immediates();
    let [a, b] = binary_vectors();
    # Both orders, so that a NaN or -0 in either operand makes it into the result, and NaN lanes canonical.
    let first = v128_min_f64(a, b);
    let second = v128_min_f64(b, a);
    let merged = v128_or(first, second);
    let nan_lanes = v128_unord_f64(merged, merged);
    let with_nans = v128_or(merged, nan_lanes);
    let payload = v128_shr_u_i64(nan_lanes, v128_from_u64x2(13, 0));
    let value = v128_andnot(payload, with_nans);
    vector_result(value, offset);
}

handler F64x2RelaxedMax() @opcode(0xfd, 0x110) {
    let [_, offset] = prefixed_immediates();
    let [a, b] = binary_vectors();
    # Both orders, so that a NaN in either operand makes it into the result, +0 beats -0, and NaN lanes are canonical.
    let first = v128_max_f64(a, b);
    let second = v128_max_f64(b, a);
    let differences = v128_xor(first, second);
    let propagated = v128_or(second, differences);
    let with_nans = v128_sub_f64(propagated, differences);
    let nan_lanes = v128_unord_f64(differences, with_nans);
    let payload = v128_shr_u_i64(nan_lanes, v128_from_u64x2(13, 0));
    let value = v128_andnot(payload, with_nans);
    vector_result(value, offset);
}

handler F64x2RelaxedMadd() @opcode(0xfd, 0x107) {
    let [_, offset] = prefixed_immediates();
    let top: u64 = vsp;
    let mut addend: v128;
    load128(addend, [top, 0]);
    let mut b: v128;
    load128(b, [top, 16]);
    let mut a: v128;
    load128(a, [top, 32]);
    let next = top + 32;
    vsp = next;
    let product = v128_mul_f64(a, b);
    let value = v128_add_f64(product, addend);
    vector_result(value, offset);
}

handler F64x2RelaxedNmadd() @opcode(0xfd, 0x108) {
    let [_, offset] = prefixed_immediates();
    let top: u64 = vsp;
    let mut addend: v128;
    load128(addend, [top, 0]);
    let mut b: v128;
    load128(b, [top, 16]);
    let mut a: v128;
    load128(a, [top, 32]);
    let next = top + 32;
    vsp = next;
    let product = v128_mul_f64(a, b);
    let value = v128_sub_f64(addend, product);
    vector_result(value, offset);
}

