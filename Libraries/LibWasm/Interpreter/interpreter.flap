handler MemorySize() @opcode(0x3f) {
    let [memory_index, length] = read_leb(immediates());
    let memory = memory_at(memory_index);
    let mut size: u64;
    load64(size, [memory, MEMORY_SIZE]);
    push(size >> 16);
    advance(length + 1);
}

handler MemoryGrow() @opcode(0x40) {
    let [memory_index, length] = read_leb(immediates());
    let memory = memory_at(memory_index);
    let delta = unary_operand();
    let context_pointer = context();
    store64([context_pointer, CONTEXT_ARGUMENTS], memory);
    store64([context_pointer, CONTEXT_ARGUMENT_1], delta);
    let previous: u64 = call_helper(wasm_runtime_memory_grow, context_pointer);
    # The result is an i64 for a memory64, whose -1 must not be truncated.
    let grown_memory = memory_at(memory_index);
    let mut address64: u64;
    load64(address64, [grown_memory, MEMORY_ADDRESS64]);
    let mut result: u64 = previous;
    if address64 == 0 {
        let narrow = u32(previous);
        result = alias(narrow);
    }
    set_top(result);
    advance(length + 1);
}

handler I32Const() @opcode(0x41) {
    let [value, length] = read_signed_leb(immediates());
    let narrow = u32(value);
    let wide: u64 = alias(narrow);
    push(wide);
    advance(length + 1);
}

handler I64Const() @opcode(0x42) {
    let [value, length] = read_signed_leb(immediates());
    push(value);
    advance(length + 1);
}

# Constants quickened into fixed-width forms (rule 3 in quickening.rs): the value is in the bytes after the opcode,
# sign-extended from their width.

inline fn sign_extended(value: u64, bits: u64) -> u64 {
    let width: u64 = 64;
    let shift = width - bits;
    let moved = value << shift;
    let signed = signed64(moved);
    let extended = signed >> signed64(shift);
    let result: u64 = alias(extended);
    result
}

inline fn push_i32(value: u64) {
    let narrow = u32(value);
    let wide: u64 = alias(narrow);
    push(wide);
}

# A 5- to 7-byte value: its low 4 bytes, and the rest from 4 bytes that end where it does.
inline fn fixed_value_over_4(length: u64) -> u64 {
    let current: u64 = ip;
    let mut low: u64;
    load32(low, [current, 1]);
    let end_word = current + length - 3;
    let mut high: u64;
    load32(high, [end_word, 0]);
    let word: u64 = 8;
    let unused = (word - length) << 3;
    let rest = high >> unused;
    let value = low | (rest << 32);
    sign_extended(value, length << 3)
