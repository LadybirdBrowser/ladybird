handler CheckedV128Load8Splat() @opcode(0xff, 0x87) {
    let address_operand = pop();
    let [address, length] = checked_access_address(address_operand, 1, 0);
    let mut lane: u64;
    load8(lane, [address, 0]);
    let wide = lane * 0x0101010101010101;
    replace_with_halves(0, wide, wide);
    advance(length);
}

